+#define KK_SSBO_GUARD_CLONE_LIMIT 2000u
+
+static void
+collect_guarded_block(nir_builder *b, nir_block *block,
+                      struct util_dynarray *stores)
+{
+   nir_foreach_instr_safe(instr, block) {
+      if (instr->type != nir_instr_type_intrinsic)
+         continue;
+
+      nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+      if (is_guarded_store(intr))
+         util_dynarray_append(stores, intr);
+      else
+         mask_global_address(b, intr, NULL);
+   }
+}

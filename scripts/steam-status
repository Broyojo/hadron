#!/bin/sh
# Say how Hadron's Steam Play integration stands in Mac Steam, as one word on the first line and a
# sentence for people on the second:
#
#   no-steam       Steam is not in /Applications
#   not-installed  Steam does not load Hadron's library
#   installed      it loads the library of this runtime
#   outdated       it loads Hadron's library, but not this runtime's (another version, or Hadron
#                  was moved): scripts/steam-install brings it up to date
#   broken         half of it is there (a Steam update replaced one part): scripts/steam-install
#                  repairs it
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$ROOT/scripts/paths.sh"
APP=/Applications/Steam.app
INSERT="$APP/Contents/MacOS/notproton.dylib"
if [ -d "$ROOT/build" ]; then LIB="$ROOT/build/notproton/notproton.dylib"; else LIB="$ROOT/steam/notproton.dylib"; fi
# scripts/steam-install records which library it put into Steam. Only tools every Mac has are
# used here: this runs whenever Hadron's window opens.
. "$ROOT/scripts/runtime-versions.sh"
record="$HADRON_SUPPORT/steam-library"
from=$(sed -n 1p "$record" 2>/dev/null || true)
copy=$(sed -n 2p "$record" 2>/dev/null || true)
hook=$(sed -n 3p "$record" 2>/dev/null || true)

same_hook() {
    this=$(sed -n 1p "$ROOT/steam/HOOK-ID" 2>/dev/null)
    [ -n "$hook" ] && { [ "$hook" = "$this" ]; return; }
    [ "$from" = "$(/sbin/md5 -q "$LIB" 2>/dev/null)" ] && return 0
    [ -n "$this" ] && [ -n "$from" ] && grep -q "^$this $from " "$ROOT/steam/HOOK-HISTORY" 2>/dev/null
}

if [ ! -d "$APP" ]; then
    printf 'no-steam\nSteam is not installed in /Applications.\n'; exit 0
fi
setting=$(/usr/libexec/PlistBuddy -c 'Print :LSEnvironment:DYLD_INSERT_LIBRARIES' "$APP/Contents/Info.plist" 2>/dev/null || true)
if [ -z "$setting" ] && [ ! -f "$INSERT" ]; then
    printf 'not-installed\nSteam Play is not set up.\n'; exit 0
fi
if [ "$setting" != "$INSERT" ] || [ ! -f "$INSERT" ]; then
    if [ -n "$setting" ] && [ "$setting" != "$INSERT" ]; then
        printf 'broken\nSteam loads another library (%s).\n' "$setting"
    else
        printf 'broken\nPart of the setup is missing, which a Steam update can cause. Repair puts it back.\n'
    fi
    exit 0
fi
linked=$(readlink "$HADRON_SUPPORT/runtime" 2>/dev/null || true)
build=$(runtime_id "$ROOT")
# The copy in Steam has to be the one that was recorded (another Hadron, or anything else, may have
# replaced it since).
if [ "$copy" != "$(/sbin/md5 -q "$INSERT" 2>/dev/null)" ]; then
    printf 'outdated\nSteam is set up for another version of Hadron. Repair brings it up to date.\n'
elif [ -z "$build" ]; then
    # A checkout: Steam's library has to have come from this checkout's, and the link names it.
    if [ "$from" != "$(/sbin/md5 -q "$LIB" 2>/dev/null)" ]; then
        printf 'outdated\nSteam is set up for another version of Hadron. Repair brings it up to date.\n'
    elif [ "$linked" != "$ROOT" ]; then
        printf 'outdated\nSteam is set up for another copy of Hadron. Repair points it at this one.\n'
    else
        printf 'installed\nSteam Play is set up (Hadron %s).\n' "$HADRON_VERSION"
    fi
# An installed app. Steam's part needs setting up again only when this build changed it: when
# what it was built from (HOOK-ID) is not what the setup recorded. A setup made before that was
# recorded knows only its library's checksum, which is this build's own or one of an earlier
# release built from the same (steam/HOOK-HISTORY). Games move to this build's runtime by
# themselves, the next one that is started (scripts/runtime-versions.sh).
elif ! same_hook; then
    printf 'outdated\nHadron was updated. Click Repair to finish; it closes Steam.\n'
elif [ "$(sed -n 1p "$HADRON_SUPPORT/source" 2>/dev/null)" != "$ROOT" ] && [ "$linked" != "$ROOT" ]; then
    printf 'outdated\nSteam is set up for another copy of Hadron. Repair points it at this one.\n'
elif [ "$(runtime_id "$linked")" != "$build" ]; then
    printf 'installed\nSteam Play is set up. The next game you start uses this version.\n'
else
    printf 'installed\nSteam Play is set up (Hadron %s).\n' "$HADRON_VERSION"
fi

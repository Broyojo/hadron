#!/bin/sh
# Give Steam's shortcuts for games the games' own icons.
#
# Steam makes ~/Applications/<name>.app for an installed game: a bundle that opens
# steam://run/<appid>, and what Spotlight and Launchpad show. A game with no Mac icon, so every
# Windows game, gets Steam's own icon there. Replace that with the icon of the game's executable
# (launcher/hadron-icon.c); a shortcut that already has an icon of its own is left alone.
#
# Usage: scripts/shortcut-icon                     every installed game; exits with status 3 while a
#                                                  game with a shortcut is still being installed
#        scripts/shortcut-icon <appid> <game.exe>  one game, with the executable Steam launched
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
STEAM="$HOME/Library/Application Support/Steam"
tool="$ROOT/dist/bin/hadron-icon"
steam_icon="$STEAM/Steam.AppBundle/Steam/Contents/Resources/Steam.icns"
[ -x "$tool" ] && [ -f "$steam_icon" ] || exit 0

# The executable Steam launches for a game on Windows, from Steam's own data. Fails when the game
# has none here, with status 2 when that is because Steam is still installing the game.
game_exe() {
    exe=$("$tool" --launch-exe "$STEAM/appcache/appinfo.vdf" "$1" 2>/dev/null) || return 1
    # Steam's libraries: its own directory, and the "path" entries of libraryfolders.vdf.
    libraries=$(printf '%s\n' "$STEAM"
        sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$STEAM/steamapps/libraryfolders.vdf" 2>/dev/null)
    while IFS= read -r library; do
        manifest="$library/steamapps/appmanifest_$1.acf"
        [ -f "$manifest" ] || continue
        # StateFlags has bit 4 once the game is fully installed; before that its files are not all there.
        state=$(sed -n 's/^[[:space:]]*"StateFlags"[[:space:]]*"\([0-9]*\)"[[:space:]]*$/\1/p' "$manifest" | head -1)
        [ $(( ${state:-0} & 4 )) -ne 0 ] || return 2
        dir=$(sed -n 's/^[[:space:]]*"installdir"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$manifest" | head -1)
        [ -f "$library/steamapps/common/$dir/$exe" ] || return 1
        printf '%s\n' "$library/steamapps/common/$dir/$exe"
        return 0
    done <<LIBRARIES
$libraries
LIBRARIES
    return 1
}

pending=
for run in "$HOME"/Applications/*.app/Contents/MacOS/run.sh; do
    app="${run%/Contents/MacOS/run.sh}"
    icon="$app/Contents/Resources/shortcut.icns"
    cmp -s "$icon" "$steam_icon" || continue
    appid=$(sed -n 's/^open steam:\/\/run\/\([0-9][0-9]*\)$/\1/p' "$run" 2>/dev/null | head -1)
    [ -n "$appid" ] || continue
    if [ $# -eq 2 ]; then
        [ "$appid" = "$1" ] || continue
        exe="$2"
    else
        exe=$(game_exe "$appid") || { [ $? -eq 2 ] && pending=1; continue; }
    fi
    [ -f "$exe" ] || continue
    # Written beside the icon and renamed over it; the bundle's new date makes Finder and Spotlight
    # read the icon again.
    if "$tool" "$exe" "$icon.new" 2>/dev/null; then
        mv -f "$icon.new" "$icon" && touch "$app" && echo "shortcut icon: $app"
    fi
    rm -f "$icon.new"
done
# Status 3: a game with a shortcut is still being installed, so this is worth running again.
[ -z "$pending" ] || exit 3

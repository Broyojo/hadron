#!/bin/sh
# Hadron's Steam compatibility tool: Mac Steam runs this (through the tool's `run` stub) as
#   steam-run <verb> <program> [args...]
# with STEAM_COMPAT_DATA_PATH, STEAM_COMPAT_INSTALL_PATH, STEAM_COMPAT_APP_ID and
# STEAM_COMPAT_CLIENT_INSTALL_PATH set, like Proton's `proton` script on Linux.
#
# Each game gets its own prefix in STEAM_COMPAT_DATA_PATH/pfx, created on first launch. The
# Steam bridge files (Valve's Windows steamclient DLLs, which Wine redirects to lsteamclient) are
# staged into the prefix's Steam directory, and the game runs through scripts/play, so it gets
# everything a manual launch does: mtld3d, vsync, the watchdog, hadron-steam.exe.
#
# Steam starts this through the link ~/Library/Application Support/Hadron/runtime. A game runs
# from the real folder behind it, so that the link can move to a newer copy of the runtime
# while the game runs (scripts/runtime-versions.sh).
ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
verb="$1"; shift

case "$verb" in
    getcompatpath) printf '%s\n' "$STEAM_COMPAT_DATA_PATH"; exit 0 ;;
    run|waitforexitandrun) ;;
    *) echo "steam-run: unsupported verb '$verb'" >&2; exit 1 ;;
esac
[ -n "$STEAM_COMPAT_DATA_PATH" ] || { echo "steam-run: STEAM_COMPAT_DATA_PATH is not set" >&2; exit 1; }
export WINEPREFIX="$STEAM_COMPAT_DATA_PATH/pfx"
. "$ROOT/scripts/paths.sh"
. "$ROOT/scripts/runtime-versions.sh"

# Which copy of the runtime this launch runs from (scripts/runtime-versions.sh). The one it began
# in is marked as in use at once. Then it may be another: the one a launch or a Wine session
# already running in the game's prefix uses, since what starts now joins it, or the build in the
# installed app, copied here if this is the first launch since the app was updated. That copy's
# own steam-run takes over, once.
case "$ROOT" in
    "$HADRON_RUNTIMES"/*) runtime_mark "$ROOT" ;;
esac
if [ -z "${HADRON_RUNTIME_CHOSEN:-}" ] && [ -n "$(runtime_id "$ROOT")" ]; then
    export HADRON_RUNTIME_CHOSEN=1
    chosen=$(runtime_choose "$ROOT")
    [ -z "$chosen" ] || exec "$chosen/scripts/steam-run" "$verb" "$@"
fi
# If there are other copies, the ones nothing needs any more go, without holding the launch up.
case "$ROOT" in
    "$HADRON_RUNTIMES"/*)
        for other in "$HADRON_RUNTIMES"/*; do
            [ "$other" != "$ROOT" ] && [ -d "$other" ] || continue
            ( runtime_lock && { runtime_prune "$(readlink "$HADRON_SUPPORT/runtime")"; runtime_unlock; } ) >/dev/null 2>&1 &
            break
        done ;;
esac

# Settings given as NAME=value launch options (a game's Properties, or the Compatibility page) arrive
# in argv: export them, and keep the rest as the command.
argc=$#
while [ "$argc" -gt 0 ]; do
    arg="$1"; shift; argc=$((argc - 1))
    case "$arg" in
        HADRON_*=*|WINE*=*|DXMT_*=*|MTLD3D_*=*|MTL_*=*|DXVK_*=*|VKD3D_*=*|MESA_*=*|FEX_*=*|CX_*=*|D3DM_*=*|NOTPROTON_*=*|ROSETTA_*=*)
            export "$arg" ;;
        *) set -- "$@" "$arg" ;;
    esac
done

# Per-game settings, like Proton's app defaults: lines of "<appid> NAME=value..." in the user's
# games.conf, then Hadron's config/games.conf. Launch options win over both, the user's file over
# Hadron's, since a setting is only taken while unset.
apply_profile() {  # <file>
    [ -f "$1" ] || return 0
    while read -r id settings; do
        [ "$id" = "${STEAM_COMPAT_APP_ID:-}" ] || continue
        for setting in ${settings%%#*}; do
            name="${setting%%=*}"
            # Names only: this is a data file, nothing in it may run as shell code.
            case "$name" in ""|[0-9]*|*[!A-Za-z0-9_]*) continue ;; esac
            printenv "$name" >/dev/null || export "$setting"
        done
    done < "$1"
}
apply_profile "$HADRON_SUPPORT/games.conf"
apply_profile "$ROOT/config/games.conf"

log="$STEAM_COMPAT_DATA_PATH/hadron-run.log"
mkdir -p "$STEAM_COMPAT_DATA_PATH"
{
    echo "=== hadron steam-run $(date) ==="
    echo "verb=$verb args=$*"
    env | grep -E '^(Steam|STEAM_)' | sort
} >> "$log" 2>&1

# The prefix is the one in Steam's folder for the game, whatever a launch option says.
export WINEPREFIX="$STEAM_COMPAT_DATA_PATH/pfx"
# Proton's Windows user name. Steam's Cloud rules map Windows paths into users/steamuser, so the
# profile has to be that one; Wine names it after $USER.
real_user="$USER"
export USER=steamuser
# As in scripts/play: where Wine finds FreeType and friends.
export DYLD_FALLBACK_LIBRARY_PATH="$HADRON_LIBPATH"
wine="$ROOT/dist/bin/wine"

wineserver="$ROOT/dist/bin/wineserver"
# Every Wine start in the prefix decides Retina mode first, as scripts/play does (scripts/retina.sh):
# prefix creation and updates, and the helpers Steam runs, so the session's recorded mode is right.
PREFIX="$WINEPREFIX" WINESERVER="$wineserver"
. "$ROOT/scripts/retina.sh"

# A prefix another runner made (NotProton's CrossOver, an x86-64 or Rosetta Wine) has system DLLs
# Hadron's ARM64 runtime can't use: set it aside, saves and all, and make a new one.
pe_machine() {  # the PE machine type of $1, e.g. aa64
    off=$(od -An -t u4 -j 60 -N 4 "$1" 2>/dev/null | tr -d ' ')
    [ -n "$off" ] && od -An -t x2 -j $((off + 4)) -N 2 "$1" | tr -d ' '
}
ntdll="$WINEPREFIX/drive_c/windows/system32/ntdll.dll"
if [ -f "$ntdll" ] && [ "$(pe_machine "$ntdll")" != aa64 ]; then
    aside="$WINEPREFIX.other-runner-$(date +%Y%m%d-%H%M%S)"
    mv "$WINEPREFIX" "$aside"
    echo "prefix made by another runner (ntdll machine $(pe_machine "$aside/drive_c/windows/system32/ntdll.dll")); moved to $aside" >> "$log"
fi

# A prefix is complete once this marker exists: a wineboot that fails part way leaves system.reg
# behind, and that prefix must not be reused.
ready="$WINEPREFIX/.hadron-prefix-ready"
if [ ! -f "$ready" ] && { [ ! -f "$WINEPREFIX/system.reg" ] || [ -f "$WINEPREFIX/.hadron-prefix-creating" ]; }; then
    echo "creating prefix $WINEPREFIX" >> "$log"
    rm -rf "$WINEPREFIX"
    mkdir -p "$WINEPREFIX" && touch "$WINEPREFIX/.hadron-prefix-creating"
    # mshtml off, as in scripts/play: otherwise wineboot waits on the Gecko install dialog. Wine
    # Mono is in the runtime (scripts/fetch-wine-mono.sh), so mscoree sets it up without asking.
    retina_decide; export HADRON_RETINA
    if WINEDEBUG=-all WINEDLLOVERRIDES="mshtml=" "$wine" wineboot --init >> "$log" 2>&1 &&
       WINEDEBUG=-all "$wineserver" -w &&
       "$ROOT/scripts/mtld3d-prefix" enable "$WINEPREFIX" >> "$log" 2>&1; then
        rm -f "$WINEPREFIX/.hadron-prefix-creating"
    else
        echo "steam-run: creating the prefix failed; see $log" | tee -a "$log" >&2
        "$wineserver" -k 2>/dev/null
        rm -rf "$WINEPREFIX"
        exit 1
    fi
fi
touch "$ready"

# Wine updates a prefix whose stamp differs from its wine.inf's modification time, in the first
# process to start there. Do it here instead, with mshtml off as above: left to the game's launch,
# the update stops at the Gecko install dialog.
# Wine writes the stamp with a CRLF line ending.
stamp=$(tr -d '\r\n' 2>/dev/null < "$WINEPREFIX/.update-timestamp")
if [ "$stamp" != disable ] && [ "$stamp" != "$(stat -f %m "$ROOT/dist/share/wine/wine.inf" 2>/dev/null)" ]; then
    echo "updating prefix $WINEPREFIX for a new Wine build" >> "$log"
    retina_decide; export HADRON_RETINA
    if ! WINEDEBUG=-all WINEDLLOVERRIDES="mshtml=" "$wine" wineboot --update >> "$log" 2>&1; then
        echo "steam-run: updating the prefix failed; see $log" | tee -a "$log" >&2
        "$wineserver" -k 2>/dev/null
        exit 1
    fi
fi

# The profile Steam Cloud expects, as Proton lays it out: users/steamuser, its Documents, Desktop and
# so on real folders inside the prefix (Wine links a shell folder to the Mac user's only when it
# doesn't exist yet), and the XP-era paths Steam's Cloud rules still name ("Local Settings/Application
# Data" and so on) as aliases of the modern folders. Done once per prefix: a prefix made before
# this, under the Mac user's name, is folded into steamuser, the old name kept as a link so paths
# already in its registry still resolve.
users="$WINEPREFIX/drive_c/users"
profile="$users/steamuser"
if [ ! -f "$WINEPREFIX/.hadron-profile-v1" ]; then
    if [ -n "$real_user" ] && [ "$real_user" != steamuser ] && [ -d "$users/$real_user" ] && [ ! -L "$users/$real_user" ]; then
        mkdir -p "$profile"
        cp -Rn "$users/$real_user/." "$profile/" 2>> "$log" && rm -rf "$users/$real_user" && ln -s steamuser "$users/$real_user"
        echo "folded users/$real_user into users/steamuser" >> "$log"
    fi
    for folder in Desktop Documents Downloads Music Pictures Videos Templates AppData/Local AppData/Roaming; do
        case "$(readlink "$profile/$folder" 2>/dev/null)" in
            /*) rm -f "$profile/$folder" ;;
        esac
        mkdir -p "$profile/$folder"
    done
    for alias in "Local Settings/Application Data|AppData/Local|../AppData/Local" \
                 "Application Data|AppData/Roaming|AppData/Roaming" \
                 "My Documents|Documents|Documents"; do
        old="$profile/${alias%%|*}" rest="${alias#*|}"
        new="$profile/${rest%%|*}" target="${rest#*|}"
        [ -L "$old" ] && continue
        if [ -d "$old" ]; then  # written before the alias existed (Steam Cloud does this): merge it in
            cp -Rn "$old/." "$new/" 2>> "$log" && rm -rf "$old"
        fi
        mkdir -p "$(dirname "$old")"
        ln -s "$target" "$old"
    done
    touch "$WINEPREFIX/.hadron-profile-v1"
    echo "laid out the steamuser profile" >> "$log"
fi

# Valve's Windows client DLLs, fetched from Valve's CDN (never redistributed): the game's
# steam_api loads them from the Steam directory hadron-steam.exe registers, and Wine redirects
# them to lsteamclient.
valve="$HADRON_VALVE"
steam_dir="$WINEPREFIX/drive_c/Program Files (x86)/Steam"
mkdir -p "$steam_dir"
stage() {  # copy $1 to $2 unless it is already there, byte for byte
    [ -f "$1" ] && ! cmp -s "$1" "$2" && cp "$1" "$2"
    return 0
}
for f in steamclient.dll steamclient64.dll tier0_s64.dll vstdlib_s64.dll; do
    stage "$valve/$f" "$steam_dir/$f"
done
# The SteamExe hadron-steam.exe registers: games run it to open steam:// links or restart through
# Steam, and hadron-steam hands those links to Mac Steam.
stage "$ROOT/dist/lib/wine/aarch64-windows/hadron-steam.exe" "$steam_dir/steam.exe"
# Steam runs installer scripts through the tool with iscriptevaluator.exe from here; follow the
# fetched version.
if [ -d "$valve/legacycompat" ] && [ -n "$STEAM_COMPAT_CLIENT_INSTALL_PATH" ]; then
    mkdir -p "$STEAM_COMPAT_CLIENT_INSTALL_PATH/legacycompat"
    for f in "$valve/legacycompat/"*; do
        stage "$f" "$STEAM_COMPAT_CLIENT_INSTALL_PATH/legacycompat/$(basename "$f")"
    done
fi

program="$1"
install_path="${STEAM_COMPAT_INSTALL_PATH%/}"
case "$program" in
    "$install_path"/*) ;;
    *)  # a helper Steam runs outside the game (installer scripts, redistributables)
        echo "helper: $*" >> "$log"
        retina_decide; export HADRON_RETINA
        exec "$wine" "$@" >> "$log" 2>&1 ;;
esac

# Only this branch starts the per-game bundle. Let the active Steam frontend
# grant it permission before Wine detaches it; helpers and queries never ask.
# A checkout and a packaged runtime keep the requester beside their Steam library.
activation="$ROOT/steam/activation-request"
[ ! -d "$ROOT/src/notproton" ] || activation="$ROOT/build/notproton/activation-request"
if [ -x "$activation" ]; then
    "$activation" "${STEAM_COMPAT_APP_ID:-${SteamAppId:-0}}" >> "$log" 2>&1
fi

shift
echo "game: $program $*" >> "$log"
# The game's name as Steam shows it, for the Dock and the menu bar (see scripts/play).
if [ -z "${HADRON_APP_NAME:-}" ]; then
    manifest="$install_path/../../appmanifest_${STEAM_COMPAT_APP_ID:-${SteamAppId:-0}}.acf"
    name=$(sed -n 's/^[[:space:]]*"name"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$manifest" 2>/dev/null | head -1)
    [ -n "$name" ] && export HADRON_APP_NAME="$name"
fi
# Steam's shortcuts, which Spotlight finds, get the games' own icons: this game's from the
# executable Steam launched, then any other installed game's that still has Steam's icon.
"$ROOT/scripts/shortcut-icon" "${STEAM_COMPAT_APP_ID:-${SteamAppId:-0}}" "$program" >> "$log" 2>&1
"$ROOT/scripts/shortcut-icon" >> "$log" 2>&1
# Keep a Wine log of every Steam launch while the integration is new (build/logs/<appid>-*.log).
export HADRON_LOG="${HADRON_LOG:-1}"
# The working directory stays the one Steam started this in: the game's launch entry names it
# (the install folder unless it says otherwise), and a game started as "jre\bin\javaw.exe -jar
# desktop-1.0.jar" finds its files only from there.
# Stay in the foreground: Steam tracks this process, and its Stop button sends it SIGTERM, which
# has to end the game's whole Wine session rather than just the launcher.
trap '"$wineserver" -k; wait; exit 143' TERM INT HUP
HADRON_SESSION_PID=$$ "$ROOT/scripts/play" "${STEAM_COMPAT_APP_ID:-${SteamAppId:-0}}" "$program" "$@" &
wait $!
# A launcher that starts the real game and exits returns early: stay until the prefix's whole Wine
# session has ended, so Steam shows the game running (and can stop it) until then. Waited on in the
# background, so Stop's SIGTERM still interrupts.
"$wineserver" -w &
wait $!

#!/bin/sh
# Log memory once a second. Suspend the affected Wine prefix at an emergency limit;
# never discard its unsaved state. scripts/play starts this in the background.
#
# Usage: scripts/watchdog <log file> <pid> | --check
#
# <pid> is the game's launcher process (scripts/play execs into it); the watchdog exits with it.
#
# Installed runtimes pause at critical pressure or less than 1 GB free disk.
# Checkouts also pause above half of RAM footprint or 2 GB swap growth, with
# 5 GB free disk required. Explicit HADRON_* limits are hard in either mode.
# scripts/play documents the policy and warning thresholds.
ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
log="$1" pid="$2"
. "$ROOT/scripts/paths.sh"
. "$ROOT/scripts/runtime-versions.sh"
. "$ROOT/scripts/watchdog-policy.sh"
mode=$(watchdog_runtime_mode "$ROOT" "$HADRON_RUNTIMES")
watchdog_limits "$(( $(sysctl -n hw.memsize) / 1048576 ))" "$mode" || exit 1
# play checks synchronously so invalid settings cannot leave Wine unguarded.
[ "${1:-}" != --check ] || exit 0

. "$ROOT/scripts/hadron-procs.sh"
. "$ROOT/scripts/watchdog-session.sh"
umask 077
paused=
state="$log.paused"
# The environment is inherited by Wine children, including a launcher's descendants.
[ -n "${WINEPREFIX:-}" ] || { echo "watchdog: missing Wine prefix" >> "$log"; exit 1; }

# Processes already classified, as pid:start keys, so lsof runs once per process rather than
# every second; the start time keeps a reused PID from inheriting its predecessor's answer.
ours=" " others=" "
wine_memory() {  # sets rss, footprint (MB), and procs for this checkout's processes
    rss=0 procs=0 seen=" " entries=
    for entry in $(hadron_candidates | awk '{ print $1 ":" $2 ":" $3 }'); do
        p=${entry%%:*} rest=${entry#*:}
        kb=${rest%%:*} key="$p:${rest#*:}"
        seen="$seen$key "
        case "$others" in *" $key "*) continue ;; esac
        case "$ours" in
            *" $key "*) ;;
            *)  if is_hadron_process "$p" && watchdog_same_prefix "$p"; then ours="$ours$key "
                else others="$others$key "; continue
                fi ;;
        esac
        rss=$((rss + kb / 1024)) procs=$((procs + 1))
        entries="$entries $p:$kb"
    done
    ours=$(keep_seen "$ours") others=$(keep_seen "$others")
    # proc_pid_rusage counts allocations on the Metal device and compressed pages that RSS misses.
    footprint=$rss
    if [ -x "$ROOT/dist/bin/hadron-memory" ] && [ -n "$entries" ]; then
        footprint=$("$ROOT/dist/bin/hadron-memory" $entries) || footprint=$rss
    fi
}
keep_seen() {  # the keys of $1 still running, so the lists don't grow over a long session
    kept=" "
    for k in $1; do case "$seen" in *" $k "*) kept="$kept$k " ;; esac; done
    printf '%s' "$kept"
}
swap_used_mb() {
    sysctl -n vm.swapusage | sed -E 's/.*used = ([0-9.]+)M.*/\1/' | cut -d. -f1
}

swap_base=$(swap_used_mb)
mem_description=none swap_description=none
[ "$mem_hard" -eq 0 ] || mem_description="${mem_limit_mb} MB"
[ "$swap_hard" -eq 0 ] || swap_description="${swap_limit_mb} MB"
echo "watchdog: mode=$mode warning at ${mem_warn_mb} MB footprint or ${swap_warn_mb} MB swap growth; hard limits footprint=$mem_description swap=$swap_description from ${swap_base} MB, ${disk_min_mb} MB free disk, critical pressure" >> "$log"
warned=0
while kill -0 "$pid" 2>/dev/null || watchdog_has_paused; do
    wine_memory
    pressure=$(sysctl -n kern.memorystatus_vm_pressure_level)
    swap=$(swap_used_mb)
    disk=$(df -m "$ROOT" "$HOME" | awk 'NR > 1 && (!seen || $4 < free) { free=$4; seen=1 } END { print free }')
    echo "$(date +%H:%M:%S) rss_mb=$rss footprint_mb=$footprint procs=$procs swap_mb=$swap pressure=$pressure disk_free_mb=$disk" >> "$log"

    # Growth counts from the lowest swap seen, so reclaimed stale swap is not headroom.
    [ "$swap" -ge "$swap_base" ] || swap_base=$swap
    swap_growth=$((swap - swap_base))
    watchdog_decide
    if [ "$warned" -eq 0 ] && [ "$warning" -eq 1 ]; then
        warned=1
        echo "watchdog: memory warning: ${footprint} MB footprint, ${swap_growth} MB swap growth, pressure ${pressure}; game continues" >> "$log"
        osascript -e 'display notification "Memory use is high. The game keeps running; Hadron will pause this Wine session at an emergency limit, preserving its unsaved state." with title "Hadron memory warning"' 2>/dev/null
    fi
    if [ -n "$reason" ] && [ -z "$paused" ]; then
        echo "watchdog: $reason; suspending prefix, not terminating it" >> "$log"
        paused=1
        : > "$state"
        printf '%s %s\n' "$$" "$(watchdog_start "$$")" > "$state.guard"
        watchdog_suspend >> "$log" 2>&1
    fi
    if [ -n "$paused" ]; then
        # Also catch a child created just before its parent received SIGSTOP.
        watchdog_suspend >> "$log" 2>&1
        if [ -f "$state.resume" ]; then
            rm -f "$state.resume"
            if [ -z "$reason" ]; then
                watchdog_continue >> "$log" 2>&1
                paused=
                echo "watchdog: session resumed at user request" >> "$log"
                continue
            fi
            echo "watchdog: resume refused: $reason" >> "$log"
            pause_shown=0
        fi
        # A dialog remains visible even when notifications are disabled. Cancel leaves
        # the session paused; scripts/resume can request another safety check later.
        if [ "${pause_shown:-0}" -eq 0 ]; then
            pause_shown=1
            osascript - "$state" <<'APPLESCRIPT' >/dev/null 2>&1 &
on run argv
    set answer to display dialog "Hadron paused this game because a memory or disk safety limit was reached. Unsaved progress is still in memory. Close other apps or free disk space, then request a safety check. Pausing does not free the game's memory; macOS can still terminate it. If the check fails, the game stays paused." with title "Hadron paused the game" buttons {"Keep paused", "Check and resume"} default button "Keep paused"
    if button returned of answer is "Check and resume" then
        do shell script "/usr/bin/touch " & quoted form of ((item 1 of argv) & ".resume")
    end if
end run
APPLESCRIPT
        fi
    fi

    sleep 1
done

# A closed launcher must not strand a suspended session without its guardian.

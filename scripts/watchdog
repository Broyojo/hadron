#!/bin/sh
# Guard the Mac while a game runs: log memory once a second and stop every Hadron process
# (scripts/stop) before the system starts thrashing. scripts/play starts it in the background.
#
# Usage: scripts/watchdog <log file> <pid>
#
# <pid> is the game's launcher process (scripts/play execs into it); the watchdog exits with it.
#
# Stops the game when any of these holds:
#   - macOS reports critical memory pressure (kern.memorystatus_vm_pressure_level 4);
#   - swap in use grew by more than HADRON_SWAP_LIMIT_MB (default 2048) since the game started: the
#     system is paging (macOS gives swap back slowly, so what was in use before doesn't count);
#   - Hadron's Wine processes together hold more than HADRON_MEM_LIMIT_GB (default: half of RAM);
#   - the disk has less than HADRON_DISK_MIN_GB (default 5) free: swap and logs need room.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
log="$1" pid="$2"
ram_gb=$(( $(sysctl -n hw.memsize) / 1073741824 ))
mem_limit_mb=$(( ${HADRON_MEM_LIMIT_GB:-$(( ram_gb / 2 ))} * 1024 ))
swap_limit_mb=${HADRON_SWAP_LIMIT_MB:-2048}
disk_min_mb=$(( ${HADRON_DISK_MIN_GB:-5} * 1024 ))

. "$ROOT/scripts/hadron-procs.sh"

# Processes already classified, as pid:start keys, so lsof runs once per process rather than
# every second; the start time keeps a reused PID from inheriting its predecessor's answer.
ours=" " others=" "
wine_rss() {  # sets rss (MB) and procs for this checkout's processes
    rss=0 procs=0 seen=" "
    for entry in $(hadron_candidates | awk '{ print $1 ":" $2 ":" $3 }'); do
        p=${entry%%:*} rest=${entry#*:}
        kb=${rest%%:*} key="$p:${rest#*:}"
        seen="$seen$key "
        case "$others" in *" $key "*) continue ;; esac
        case "$ours" in
            *" $key "*) ;;
            *)  if is_hadron_process "$p"; then ours="$ours$key "
                else others="$others$key "; continue
                fi ;;
        esac
        rss=$((rss + kb / 1024)) procs=$((procs + 1))
    done
    ours=$(keep_seen "$ours") others=$(keep_seen "$others")
}
keep_seen() {  # the keys of $1 still running, so the lists don't grow over a long session
    kept=" "
    for k in $1; do case "$seen" in *" $k "*) kept="$kept$k " ;; esac; done
    printf '%s' "$kept"
}
swap_used_mb() {
    sysctl -n vm.swapusage | sed -E 's/.*used = ([0-9.]+)M.*/\1/' | cut -d. -f1
}

swap_base=$(swap_used_mb)
echo "watchdog: limits ${mem_limit_mb} MB resident, ${swap_limit_mb} MB more swap than the ${swap_base} MB in use, ${disk_min_mb} MB free disk, critical pressure" >> "$log"
while kill -0 "$pid" 2>/dev/null; do
    wine_rss
    pressure=$(sysctl -n kern.memorystatus_vm_pressure_level)
    swap=$(swap_used_mb)
    disk=$(df -m "$ROOT" | awk 'NR == 2 { print $4 }')
    echo "$(date +%H:%M:%S) rss_mb=$rss procs=$procs swap_mb=$swap pressure=$pressure disk_free_mb=$disk" >> "$log"

    reason=
    [ "$pressure" -ge 4 ] && reason="critical memory pressure"
    [ $((swap - swap_base)) -gt "$swap_limit_mb" ] && reason="swap grew to ${swap} MB (from ${swap_base} MB)"
    [ "$rss" -gt "$mem_limit_mb" ] && reason="Wine resident memory at ${rss} MB"
    [ "$disk" -lt "$disk_min_mb" ] && reason="only ${disk} MB of disk left"
    if [ -n "$reason" ]; then
        echo "watchdog: $reason, stopping the game" | tee -a "$log" >&2
        osascript -e "display notification \"$reason\" with title \"Hadron stopped the game\"" 2>/dev/null
        "$ROOT/scripts/stop" >> "$log" 2>&1
        exit 1
    fi

    sleep 1
done

#!/bin/sh
# Stop every Hadron Wine process (all prefixes), including orphans whose wineserver is gone.
# Leaves the native Mac Steam client alone.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
for p in "$ROOT"/prefix/*; do
    [ -d "$p" ] || continue
    WINEPREFIX="$p" "$ROOT/dist/bin/wineserver" -k 2>/dev/null
    [ -x "$ROOT/dist-dev/bin/wineserver" ] && WINEPREFIX="$p" "$ROOT/dist-dev/bin/wineserver" -k 2>/dev/null
done
sleep 1
ps -Ao pid,command | grep -E 'C:\\windows|C:\\Program Files|Z:\\|proton-apple/dist|wineserver' \
    | grep -v grep | awk '{print $1}' | xargs kill -9 2>/dev/null; true
echo "remaining Hadron processes: $(ps -Ao command | grep -E 'C:\\windows|C:\\Program Files|Z:\\|proton-apple/dist|wineserver' | grep -v grep | wc -l | tr -d ' ')"

#!/bin/sh
# Stop every Hadron Wine process (all prefixes), including orphans whose wineserver is gone, and
# games running from a copy of an installed Hadron's runtime.
# Leaves the native Mac Steam client and other Wine installations alone (see hadron-procs.sh).
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
for p in "$ROOT"/prefix/*; do
    [ -d "$p" ] || continue
    WINEPREFIX="$p" "$ROOT/dist/bin/wineserver" -k 2>/dev/null
    [ -x "$ROOT/dist-dev/bin/wineserver" ] && WINEPREFIX="$p" "$ROOT/dist-dev/bin/wineserver" -k 2>/dev/null
done
sleep 1
. "$ROOT/scripts/hadron-procs.sh"
# Games started from Steam with an installed Hadron.app run from a copy of its runtime, not from
# this checkout (scripts/runtime-versions.sh): they are Hadron's too.
copies="$(cd "$HOME/Library/Application Support/Hadron/runtimes" 2>/dev/null && pwd -P)"
ours() {  # print the PIDs of this runtime's processes and of every runtime copy's
    hadron_candidates | while read -r pid rss start; do
        if is_hadron_process "$pid" ||
           { [ -n "$copies" ] && lsof -a -p "$pid" -d txt -Fn 2>/dev/null | grep -qF "$copies/"; }; then
            echo "$pid"
        fi
    done
}
ours | xargs kill -9 2>/dev/null; true
echo "remaining Hadron processes: $(ours | wc -l | tr -d ' ')"

#!/bin/sh
# Run Hadron's Wine with a clean environment, so host secrets never reach Windows
# processes or debug logs.
#   scripts/wine-run <wine args...>      release build (dist/, prefix/release)
#   scripts/wine-dev <wine args...>      dev build (dist-dev/, prefix/dev)
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
case "$(basename "$0")" in
    wine-dev) DIST="$ROOT/dist-dev" PREFIX="$ROOT/prefix/dev" ;;
    *)        DIST="$ROOT/dist"     PREFIX="$ROOT/prefix/release" ;;
esac
PREFIX="${WINEPREFIX:-$PREFIX}"
# Retina mode has to agree with any Wine session already in the prefix (scripts/retina.sh).
. "$ROOT/scripts/retina.sh"
WINESERVER="$DIST/bin/wineserver"
retina_decide
exec env -i HOME="$HOME" USER="$USER" LANG="${LANG:-en_US.UTF-8}" PATH=/usr/bin:/bin:/usr/sbin:/sbin \
    TMPDIR="${TMPDIR:-/tmp}" \
    WINEPREFIX="$PREFIX" \
    HADRON_RETINA="$HADRON_RETINA" \
    WINEDEBUG="${WINEDEBUG:-}" \
    WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mshtml=}" \
    DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib \
    FEX_DISKCACHE="${FEX_DISKCACHE:-1}" \
    MTLD3D_NO_CRASH_HANDLER=1 \
    "$DIST/bin/wine" "$@"

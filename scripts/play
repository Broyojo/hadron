#!/bin/sh
# Run a Steam game through Hadron, with the native Mac Steam client providing Steam.
# Mac Steam must be running and logged in.
#
# Usage: scripts/play <appid> <path/to/game.exe> [game args...]
#
# Only an allowlist of environment variables reaches the game: host secrets never do.
# HADRON_LOG=1 writes module load addresses and errors to build/logs/ for crash analysis.
# FEX_BLOCKJITNAMING=1 (with FEX_DISKCACHE=0) makes FEX list its translated blocks in
# /tmp/perf-<pid>.map, to map samples in JIT code back to x86 addresses.
# A watchdog stops the game before memory use can make the Mac thrash; HADRON_MEM_LIMIT_GB
# (default half of RAM) and HADRON_SWAP_LIMIT_MB (default 2048) set its limits.
# 32-bit games get the full 4GB address space, as under Proton; HADRON_LARGE_ADDRESS_AWARE=0
# limits those not marked large address aware to 2GB, as on Windows.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
[ $# -ge 2 ] || { echo "usage: $0 <appid> <game.exe> [args...]" >&2; exit 1; }
appid="$1"; exe="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"; shift 2

MAC_STEAM="$HOME/Library/Application Support/Steam/Steam.AppBundle/Steam/Contents/MacOS"
[ -f "$MAC_STEAM/steamclient.dylib" ] || { echo "Mac Steam not found at $MAC_STEAM" >&2; exit 1; }
pgrep -q steam_osx || echo "warning: Mac Steam doesn't seem to be running" >&2

winexe="Z:$(printf '%s' "$exe" | tr '/' '\\')"
PREFIX="${WINEPREFIX:-$ROOT/prefix/release}"

# Hadron's own DLLs aren't Wine builtins, so the prefix has no placeholders for them and Wine
# can't find them by name. Install copies into the system directories (Wine still loads the
# builtin from dist/ because they carry the builtin signature).
install_dll() {  # <dist arch dir> <prefix system dir> <dll>
    src="$ROOT/dist/lib/wine/$1/$3"; dst="$PREFIX/drive_c/windows/$2/$3"
    if [ -f "$src" ] && [ -d "$(dirname "$dst")" ] && ! cmp -s "$src" "$dst"; then cp "$src" "$dst"; fi
}
for dll in lsteamclient.dll winemetal.dll; do
    install_dll aarch64-windows system32 "$dll"
    install_dll i386-windows syswow64 "$dll"
done
debug="${WINEDEBUG:--all}"
overrides="mscoree,mshtml=;steamclient,steamclient64=n;lsteamclient=b"
# Without the Steam bridge no Steam client serves the game, so don't let it load the Windows
# steamclient.dll either: SteamAPI_Init then fails at once. Otherwise games retry, loading and
# unloading the 21 MB DLL each time, and every cycle leaks a 32 MB reservation made by Steam's
# tier0_s.dll; Source retries every frame during its intro videos, which fills a 32-bit
# process's address space in seconds (docs/findings.md #13).
case "${HADRON_DISABLE_LSTEAMCLIENT:-0}" in
    0) ;;
    *) overrides="mscoree,mshtml=;steamclient,steamclient64=d;lsteamclient=b" ;;
esac
# D3D9 goes through mtld3d (D3D9 -> Metal), installed in the prefix by scripts/mtld3d-prefix
# enable; HADRON_D3D9=wined3d uses Wine's own D3D9 (over OpenGL) instead, for comparisons.
[ "${HADRON_D3D9:-mtld3d}" = mtld3d ] && overrides="$overrides;d3d9=n,b"
# HADRON_VSYNC=game|on|off: whether presents wait for a display refresh. game (the default)
# follows each game's own vsync choice as a Windows driver does; on and off override it.
mtld3d_config="${MTLD3D_CONFIG:-color.hdr.enable=false}"
[ -n "$HADRON_VSYNC" ] && mtld3d_config="$mtld3d_config;present.vsync=$HADRON_VSYNC"
dxmt_config="$DXMT_CONFIG"
[ -n "$HADRON_VSYNC" ] && dxmt_config="${dxmt_config:+$dxmt_config;}dxgi.vsync=$HADRON_VSYNC"
# The watchdog logs memory to build/logs/ and stops the game before it can make the Mac
# thrash (see scripts/watchdog for the limits). HADRON_WATCHDOG=0 turns it off.
mkdir -p "$ROOT/build/logs"
if [ "${HADRON_WATCHDOG:-1}" != 0 ]; then
    memlog="$ROOT/build/logs/$appid-$(date +%Y%m%d-%H%M%S).mem.log"
    echo "watchdog: memory log in $memlog" >&2
    # $$ is this script's PID, which the exec below hands to Wine.
    nohup "$ROOT/scripts/watchdog" "$memlog" $$ >/dev/null 2>&1 &
fi
if [ -n "$HADRON_LOG" ]; then
    log="$ROOT/build/logs/$appid-$(date +%Y%m%d-%H%M%S).log"
    echo "logging to $log" >&2
    debug="${WINEDEBUG:-err+all,+loaddll}"
    exec > "$log" 2>&1
fi

# Renderer and translator settings (a game's Steam launch options, or the caller's environment) pass
# through by name; the variables set explicitly below keep their computed values.
set -- "$ROOT/dist/bin/wine" "$ROOT/dist/lib/wine/aarch64-windows/hadron-steam.exe" "$winexe" "$@"
for var in $(env | grep -oE '^(WINE[A-Z0-9_]*|(DXMT|MTLD3D|MTL|DXVK|VKD3D|FEX)_[A-Za-z0-9_]*)=' | tr -d = | sort -u); do
    case "$var" in
        WINEPREFIX|WINEDEBUG|WINEDLLOVERRIDES|WINE_LARGE_ADDRESS_AWARE|MTLD3D_CONFIG|MTLD3D_NO_CRASH_HANDLER|FEX_DISKCACHE|FEX_BLOCKJITNAMING) continue ;;
    esac
    eval "value=\${$var}"
    set -- "$var=$value" "$@"
done

exec env -i HOME="$HOME" USER="$USER" LANG="${LANG:-en_US.UTF-8}" PATH=/usr/bin:/bin:/usr/sbin:/sbin \
    TMPDIR="${TMPDIR:-/tmp}" \
    WINEPREFIX="$PREFIX" \
    WINEDEBUG="$debug" \
    WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-$overrides}" \
    DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib \
    FEX_DISKCACHE="${FEX_DISKCACHE:-1}" \
    WINE_LARGE_ADDRESS_AWARE="${HADRON_LARGE_ADDRESS_AWARE:-1}" \
    MTLD3D_NO_CRASH_HANDLER=1 \
    MTLD3D_CONFIG="$mtld3d_config" \
    ${dxmt_config:+DXMT_CONFIG=$dxmt_config} \
    ${RUST_LOG:+RUST_LOG=$RUST_LOG} \
    SteamAppId="$appid" SteamGameId="$appid" \
    STEAM_COMPAT_CLIENT_INSTALL_PATH="$MAC_STEAM" \
    ${HADRON_DISABLE_LSTEAMCLIENT:+HADRON_DISABLE_LSTEAMCLIENT=$HADRON_DISABLE_LSTEAMCLIENT} \
    ${HADRON_HARDWARE_TSO:+HADRON_HARDWARE_TSO=$HADRON_HARDWARE_TSO} \
    ${FEX_BLOCKJITNAMING:+FEX_BLOCKJITNAMING=$FEX_BLOCKJITNAMING} \
    STEAM_DYLD_INSERT_LIBRARIES="$STEAM_DYLD_INSERT_LIBRARIES" \
    "$@"

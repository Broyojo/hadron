#!/bin/sh
# Run a Steam game through Hadron, with the native Mac Steam client providing Steam.
# Mac Steam must be running and logged in.
#
# Usage: scripts/play <appid> <path/to/game.exe> [game args...]
#
# Only an allowlist of environment variables reaches the game: host secrets never do.
# HADRON_LOG=1 writes module load addresses and errors to the logs directory for crash analysis.
# FEX_BLOCKJITNAMING=1 (with FEX_DISKCACHE=0) makes FEX list its translated blocks in
# /tmp/perf-<pid>.map, to map samples in JIT code back to x86 addresses.
# A watchdog stops the game before memory use can make the Mac thrash; HADRON_MEM_LIMIT_GB
# (default half of RAM) and HADRON_SWAP_LIMIT_MB (default 2048) set its limits.
# Scrolling sends whole wheel notches, which every game handles; HADRON_PRECISE_SCROLLING=1 sends
# fractions for smooth scrolling, for applications that scale by the wheel delta.
# 32-bit games get the full 4GB address space, as under Proton; HADRON_LARGE_ADDRESS_AWARE=0
# limits those not marked large address aware to 2GB, as on Windows.
# D3D12 runs through vkd3d-proton on KosmicKrisp (docs/findings.md #22); HADRON_D3D12=wine uses
# Wine's own d3d12 instead, for comparisons.
# OpenGL runs on Zink, Mesa's OpenGL on Vulkan, on KosmicKrisp.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
[ $# -ge 2 ] || { echo "usage: $0 <appid> <game.exe> [args...]" >&2; exit 1; }
appid="$1"; exe="$(cd "$(dirname "$2")" && pwd)/$(basename "$2")"; shift 2

MAC_STEAM="$HOME/Library/Application Support/Steam/Steam.AppBundle/Steam/Contents/MacOS"
[ -f "$MAC_STEAM/steamclient.dylib" ] || { echo "Mac Steam not found at $MAC_STEAM" >&2; exit 1; }
pgrep -q steam_osx || echo "warning: Mac Steam doesn't seem to be running" >&2

winexe="Z:$(printf '%s' "$exe" | tr '/' '\\')"
. "$ROOT/scripts/paths.sh"
PREFIX="${WINEPREFIX:-$HADRON_PREFIX}"

# Hadron's own DLLs aren't Wine builtins, so the prefix has no placeholders for them and Wine
# can't find them by name. Install copies into the system directories (Wine still loads the
# builtin from dist/ because they carry the builtin signature).
install_dll() {  # <dist arch dir> <prefix system dir> <dll>
    src="$ROOT/dist/lib/wine/$1/$3"; dst="$PREFIX/drive_c/windows/$2/$3"
    if [ -f "$src" ] && [ -d "$(dirname "$dst")" ] && ! cmp -s "$src" "$dst"; then cp "$src" "$dst"; fi
}
for dll in lsteamclient.dll winemetal.dll; do
    install_dll aarch64-windows system32 "$dll"
    install_dll i386-windows syswow64 "$dll"
done
debug="${WINEDEBUG:--all}"
overrides="mscoree,mshtml=;steamclient,steamclient64=n;lsteamclient=b"
# Without the Steam bridge no Steam client serves the game, so don't let it load the Windows
# steamclient.dll either: SteamAPI_Init then fails at once. Otherwise games retry, loading and
# unloading the 21 MB DLL each time, and every cycle leaks a 32 MB reservation made by Steam's
# tier0_s.dll; Source retries every frame during its intro videos, which fills a 32-bit
# process's address space in seconds (docs/findings.md #13).
case "${HADRON_DISABLE_LSTEAMCLIENT:-0}" in
    0) ;;
    *) overrides="mscoree,mshtml=;steamclient,steamclient64=d;lsteamclient=b" ;;
esac
# D3D9 goes through mtld3d (D3D9 -> Metal), installed in the prefix by scripts/mtld3d-prefix
# enable; HADRON_D3D9=wined3d uses Wine's own D3D9 (over OpenGL) instead, for comparisons.
[ "${HADRON_D3D9:-mtld3d}" = mtld3d ] && overrides="$overrides;d3d9=n,b"
# Vulkan goes to KosmicKrisp (Mesa's Vulkan on Metal, scripts/build-vulkan.sh); MoltenVK, which the
# Vulkan loader would find otherwise, can't create an instance under Wine.
icd="$ROOT/dist/mesa/share/vulkan/icd.d/kosmickrisp_mesa_icd.aarch64.json"
[ -f "$icd" ] || icd=
# DXVK's DXGI presents for D3D12 devices: DXMT's dxgi.dll hands it the swapchains of devices that
# aren't its own (vkd3d-proton's command queues), loading it by this name.
sys32="$PREFIX/drive_c/windows/system32"
if [ -f "$ROOT/dist/dxvk/x64/dxgi.dll" ] && [ -d "$sys32" ]; then
    cmp -s "$ROOT/dist/dxvk/x64/dxgi.dll" "$sys32/dxgi_dxvk.dll" || cp "$ROOT/dist/dxvk/x64/dxgi.dll" "$sys32/dxgi_dxvk.dll"
fi
# D3D12 goes through vkd3d-proton on KosmicKrisp. Wine's own d3d12 can't make a device here: it needs
# Wine's DXGI adapters, and DXGI is DXMT's. HADRON_D3D12=wine selects it anyway, for comparisons;
# HADRON_D3D12=vkd3d fails when a part of the vkd3d-proton path is missing instead of falling back.
d3d12="${HADRON_D3D12:-auto}"
if [ "$d3d12" != wine ]; then
    missing=
    for f in d3d12.dll d3d12core.dll; do
        [ -f "$ROOT/dist/vkd3d-proton/x64/$f" ] || missing="vkd3d-proton: run scripts/build-vulkan.sh"
    done
    [ -f "$sys32/dxgi_dxvk.dll" ] || missing="the DXGI of DXVK: run scripts/build-vulkan.sh dxvk"
    [ -n "$icd" ] || missing="KosmicKrisp: run scripts/build-vulkan.sh"
    if [ -n "$missing" ]; then
        [ "$d3d12" = vkd3d ] && { echo "HADRON_D3D12=vkd3d needs $missing" >&2; exit 1; }
        d3d12=wine
    fi
fi
if [ "$d3d12" != wine ]; then
    for f in d3d12.dll d3d12core.dll; do
        src="$ROOT/dist/vkd3d-proton/x64/$f"
        cmp -s "$src" "$sys32/$f" || cp "$src" "$sys32/$f"
    done
    overrides="$overrides;d3d12,d3d12core=n"
    # vkd3d-proton caches pipelines in the working directory, the game's install, unless told otherwise.
    mkdir -p "$PREFIX/shadercache"
    vkd3d_cache="$PREFIX/shadercache"
fi
# HADRON_VSYNC=game|on|off: whether presents wait for a display refresh. game (the default)
# follows each game's own vsync choice as a Windows driver does; on and off override it.
mtld3d_config="${MTLD3D_CONFIG:-color.hdr.enable=false}"
[ -n "$HADRON_VSYNC" ] && mtld3d_config="$mtld3d_config;present.vsync=$HADRON_VSYNC"
dxmt_config="$DXMT_CONFIG"
[ -n "$HADRON_VSYNC" ] && dxmt_config="${dxmt_config:+$dxmt_config;}dxgi.vsync=$HADRON_VSYNC"
# The watchdog logs memory to the logs directory (scripts/paths.sh) and stops the game before it can make the Mac
# thrash (see scripts/watchdog for the limits). HADRON_WATCHDOG=0 turns it off.
mkdir -p "$HADRON_LOGS"
if [ "${HADRON_WATCHDOG:-1}" != 0 ]; then
    memlog="$HADRON_LOGS/$appid-$(date +%Y%m%d-%H%M%S).mem.log"
    echo "watchdog: memory log in $memlog" >&2
    # $$ is this script's PID, which the exec below hands to Wine.
    nohup "$ROOT/scripts/watchdog" "$memlog" $$ >/dev/null 2>&1 &
fi
if [ -n "$HADRON_LOG" ]; then
    log="$HADRON_LOGS/$appid-$(date +%Y%m%d-%H%M%S).log"
    echo "logging to $log" >&2
    debug="${WINEDEBUG:-err+all,+loaddll}"
    exec > "$log" 2>&1
fi

# The Dock and the menu bar name an application after the bundle it was started from, and every
# Wine process is the same loader: "wine". So each game gets a bundle of its own, holding nothing
# but a link to the loader under the game's name (HADRON_APP_NAME: scripts/steam-run passes
# Steam's name for it), and Wine starts the game's processes through that link (WINELOADER).
# The bundle's icon is the game's own, from its executable (launcher/hadron-icon.c): the Dock
# marks the game's minimized windows with it.
name=$(printf '%s' "${HADRON_APP_NAME:-$(basename "$exe" .exe)}" | tr -d '/:<>&\n' | cut -c1-80)
name="${name:-game}"
loader=$(/bin/realpath "$ROOT/dist/bin/wine")
app="$HOME/Library/Application Support/Hadron/apps/$appid/$name.app"
wine="$app/Contents/MacOS/$name"
if [ "$(readlink "$wine" 2>/dev/null)" != "$loader" ] || ! grep -q CFBundleIconFile "$app/Contents/Info.plist" 2>/dev/null; then
    rm -rf "$HOME/Library/Application Support/Hadron/apps/$appid"
    mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" && ln -s "$loader" "$wine" && cat > "$app/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>$name</string>
    <key>CFBundleIconFile</key>
    <string>icon</string>
    <key>CFBundleIdentifier</key>
    <string>com.broyojo.hadron.game.$appid</string>
    <key>CFBundleName</key>
    <string>$name</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>NSPrincipalClass</key>
    <string>WineApplication</string>
    <key>LSUIElement</key>
    <true/>
</dict>
</plist>
EOF
fi
if [ ! -f "$app/Contents/Resources/icon.icns" ] && [ -x "$ROOT/dist/bin/hadron-icon" ]; then
    "$ROOT/dist/bin/hadron-icon" "$exe" "$app/Contents/Resources/icon.icns" 2>/dev/null || true
fi
[ -x "$wine" ] || wine="$ROOT/dist/bin/wine"

# Renderer and translator settings (a game's Steam launch options, or the caller's environment) pass
# through by name; the variables set explicitly below keep their computed values.
set -- "$wine" "$ROOT/dist/lib/wine/aarch64-windows/hadron-steam.exe" "$winexe" "$@"
for var in $(env | grep -oE '^(WINE[A-Z0-9_]*|(DXMT|MTLD3D|MTL|DXVK|VKD3D|FEX|MESA)_[A-Za-z0-9_]*)=' | tr -d = | sort -u); do
    case "$var" in
        WINEPREFIX|WINELOADER|WINEDEBUG|WINEDLLOVERRIDES|WINE_LARGE_ADDRESS_AWARE|WINE_MAC_OPENGL|MESA_LOADER_DRIVER_OVERRIDE|MTLD3D_CONFIG|MTLD3D_NO_CRASH_HANDLER|FEX_DISKCACHE|FEX_BLOCKJITNAMING) continue ;;
        VKD3D_SHADER_CACHE_PATH) [ -n "${vkd3d_cache:-}" ] && continue ;;
    esac
    eval "value=\${$var}"
    set -- "$var=$value" "$@"
done
# Paths may contain spaces (Steam runs this through ~/Library/Application Support), so these go
# through the argument list too rather than as unquoted expansions below.
[ -n "$icd" ] && set -- "VK_DRIVER_FILES=$icd" "MESA_KK_EXPERIMENTAL=${MESA_KK_EXPERIMENTAL:-dgc,xfb,sparse}" "$@"
# OpenGL: Wine's Mac driver uses Zink on KosmicKrisp, Mesa's OpenGL on Vulkan, through EGL. Apple's
# OpenGL stops at 4.1 with no compatibility profile above 2.1, and is not used.
libpath="$HADRON_LIBPATH"
if [ -f "$ROOT/dist/mesa-zink/lib/libEGL.1.dylib" ] && [ -n "$icd" ]; then
    libpath="$ROOT/dist/mesa-zink/lib:$libpath"
    # Mesa looks for its driver settings (Zink's defaults, per-application workarounds) where it
    # was installed at build time, a path that only exists on the Mac that built it.
    set -- "WINE_MAC_OPENGL=egl" "MESA_LOADER_DRIVER_OVERRIDE=zink" \
           "DRIRC_CONFIGDIR=$ROOT/dist/mesa-zink/share/drirc.d" "$@"
else
    echo "OpenGL needs Zink and KosmicKrisp: run scripts/build-vulkan.sh" >&2
    exit 1
fi
# A shader Metal refuses to compile is a driver bug: KosmicKrisp saves its source here.
mkdir -p "$HADRON_LOGS/failed-msl"
set -- "MESA_KK_FAILED_MSL_DIR=$HADRON_LOGS/failed-msl" "$@"
[ -n "$vkd3d_cache" ] && set -- "VKD3D_SHADER_CACHE_PATH=$vkd3d_cache" "$@"

exec env -i HOME="$HOME" USER="$USER" LANG="${LANG:-en_US.UTF-8}" PATH=/usr/bin:/bin:/usr/sbin:/sbin \
    TMPDIR="${TMPDIR:-/tmp}" \
    WINEPREFIX="$PREFIX" \
    WINELOADER="$wine" \
    WINEDEBUG="$debug" \
    WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-$overrides}" \
    DYLD_FALLBACK_LIBRARY_PATH="$libpath" \
    FEX_DISKCACHE="${FEX_DISKCACHE:-1}" \
    WINE_LARGE_ADDRESS_AWARE="${HADRON_LARGE_ADDRESS_AWARE:-1}" \
    MTLD3D_NO_CRASH_HANDLER=1 \
    MTLD3D_CONFIG="$mtld3d_config" \
    ${dxmt_config:+DXMT_CONFIG=$dxmt_config} \
    ${RUST_LOG:+RUST_LOG=$RUST_LOG} \
    SteamAppId="$appid" SteamGameId="$appid" \
    STEAM_COMPAT_CLIENT_INSTALL_PATH="$MAC_STEAM" \
    ${HADRON_DISABLE_LSTEAMCLIENT:+HADRON_DISABLE_LSTEAMCLIENT=$HADRON_DISABLE_LSTEAMCLIENT} \
    ${HADRON_HARDWARE_TSO:+HADRON_HARDWARE_TSO=$HADRON_HARDWARE_TSO} \
    ${HADRON_PRECISE_SCROLLING:+HADRON_PRECISE_SCROLLING=$HADRON_PRECISE_SCROLLING} \
    ${FEX_BLOCKJITNAMING:+FEX_BLOCKJITNAMING=$FEX_BLOCKJITNAMING} \
    STEAM_DYLD_INSERT_LIBRARIES="$STEAM_DYLD_INSERT_LIBRARIES" \
    "$@"

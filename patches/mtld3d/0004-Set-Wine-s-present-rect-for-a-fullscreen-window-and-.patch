--- a/unix/unix/src/metal/macdrv.rs
+++ b/unix/unix/src/metal/macdrv.rs
@@ -3138,13 +3138,14 @@ fn clear_covered_window_layers(view: &NSView, _mtm: MainThreadMarker) {
         );
         return;
     };
-    let covered = rect_covers(
-        view.convertRect_toView(view.visibleRect(), None),
-        frame_view.convertRect_toView(frame_view.bounds(), None),
-    );
-    if !covered {
-        return;
-    }
+    // The visible rectangle alone is not the view: a view that does not clip
+    // to its bounds, the default since macOS 14, can report one larger than
+    // itself, and Wine's letterboxed client view (a fullscreen mode of another
+    // shape than the screen's) then passed for covering the whole window. The
+    // view covers only where both its bounds and its visible part do.
+    let window_frame = frame_view.convertRect_toView(frame_view.bounds(), None);
+    let covered = rect_covers(view.convertRect_toView(view.visibleRect(), None), window_frame)
+        && rect_covers(view.convertRect_toView(view.bounds(), None), window_frame);
     let (Some(content_layer), Some(frame_layer)) = (content.layer(), frame_view.layer()) else {
         mtld3d_shared::log_once_warn!(
             target: LOG_TARGET,
@@ -3153,6 +3154,25 @@ fn clear_covered_window_layers(view: &NSView, _mtm: MainThreadMarker) {
         );
         return;
     };
+    if !covered {
+        // A view that covered its window when a pass cleared the background
+        // can stop covering it: under a fullscreen present rect Wine grows the
+        // window to the whole monitor and keeps the client view, and with it

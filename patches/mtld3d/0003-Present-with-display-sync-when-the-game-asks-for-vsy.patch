@@ -474,6 +474,21 @@
 
 # present.maxFrameLatency = auto
 
+# Whether presents wait for a display refresh (vsync).
+#
+# `game` does what Windows does. A windowed game is composited, so its
+# presents wait for a refresh and never tear whatever it asks for. A
+# fullscreen game follows its presentation interval: any interval but
+# IMMEDIATE waits for a refresh, IMMEDIATE presents at once for the lowest
+# latency and may tear. `on` and `off` override the game in both, for
+# titles that offer no vsync setting of their own.
+# A divided interval (TWO/THREE/FOUR) still sets its frame-rate ceiling.
+#
+# Default: game
+# Supported values: game, on, off
+
+# present.vsync = game
+
 
 ##############
 # Rendering  #

+/// Point the layer's display sync at the vsync request it holds now. **Main thread only.**
+///
+/// Attach configures it; this follows a `Reset` that changed the request
+/// ([`set_display_sync_enabled`] queues the refresh that runs it).
+fn follow_display_sync(att: &Arc<Attachment>, mtm: MainThreadMarker) {
+    let Some(layer) = attachment::retain_layer(att, mtm) else {
+        return;
+    };
+    let wanted = unpack_pacing(att.pacing_bits()).vsync_requested;
+    if layer.displaySyncEnabled() != wanted {
+        layer.setDisplaySyncEnabled(wanted);
+        info!(
+            target: LOG_TARGET,
+            "present: display sync {}",
+            if wanted { "on" } else { "off" },
+        );
+    }
+}

+/// Whose choice decides vsync: the game's presentation interval, or the user's.
+///
+/// `present.vsync` in `mtld3d.conf`. `Game` does what Windows does: a
+/// windowed device's presents are composited by DWM, which shows them at a
+/// display refresh whatever the interval, so they never tear; a fullscreen
+/// device follows its interval. `On` and `Off` override both, for titles
+/// that offer no vsync setting of their own.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum VsyncPolicy {
+    Game,
+    On,
+    Off,
+}
+
 /// The pacing a device hands its layer: the vsync request and the frame-rate ceiling.
 ///
 /// `max_fps` is in Hz and `0` means no ceiling. It is the effective ceiling
@@ -130,10 +144,25 @@ pub const fn effective_max_fps(interval: u32, refresh_hz: u32, configured: u32)
 }
 
 /// The pacing `interval` asks for on a `refresh_hz` mode under a `configured` ceiling.
+///
+/// `vsync` is the user's `present.vsync`: under [`VsyncPolicy::Game`] a
+/// `windowed` device syncs to the display and a fullscreen one follows its
+/// interval, otherwise the policy decides. A divided interval's ceiling
+/// applies either way.
 #[must_use]
-pub const fn layer_pacing_for(interval: u32, refresh_hz: u32, configured: u32) -> LayerPacing {
+pub const fn layer_pacing_for(
+    interval: u32,
+    refresh_hz: u32,
+    configured: u32,
+    vsync: VsyncPolicy,
+    windowed: bool,
+) -> LayerPacing {
     LayerPacing {
-        display_sync: display_sync_for(interval).enabled(),
+        display_sync: match vsync {
+            VsyncPolicy::Game => windowed || display_sync_for(interval).enabled(),
+            VsyncPolicy::On => true,
+            VsyncPolicy::Off => false,
+        },
         max_fps: effective_max_fps(interval, refresh_hz, configured),
     }
 }

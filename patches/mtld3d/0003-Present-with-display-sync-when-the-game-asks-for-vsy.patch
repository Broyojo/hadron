+impl WireValue for VsyncPolicy {
+    fn write_wire(&self, writer: &mut WireWriter<'_>) -> Result<(), WireError> {
+        writer.u8(match self {
+            Self::Game => 0,
+            Self::On => 1,
+            Self::Off => 2,
+        })
+    }
+    fn read_wire(reader: &mut WireReader<'_>) -> Result<Self, WireError> {
+        match reader.u8()? {
+            0 => Ok(Self::Game),
+            1 => Ok(Self::On),
+            2 => Ok(Self::Off),
+            _ => Err(WireError::InvalidValue),
+        }
+    }
+}

 src/d3d10/d3d10_device.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/d3d10/d3d10_device.cpp b/src/d3d10/d3d10_device.cpp
index 155e626..83d1e6d 100644
--- a/src/d3d10/d3d10_device.cpp
+++ b/src/d3d10/d3d10_device.cpp
@@ -498,7 +498,7 @@ MTLD3D10Device::IAGetIndexBuffer(ID3D10Buffer **pIndexBuffer, DXGI_FORMAT *Forma
     if (d3d11_buffer)
       d3d11_buffer->QueryInterface(IID_PPV_ARGS(pIndexBuffer));
     else

From 6052d25fc62e895b73136a36050d233a7d7343bb Mon Sep 17 00:00:00 2001
From: Feifan He <feifan@codeweavers.com>
Date: Mon, 5 Oct 2026 15:59:16 +0800
Subject: [PATCH] fix(d3d11): lock device in `Signal()` and `Wait()`

Signed-off-by: Feifan He <feifan@codeweavers.com>
(cherry picked from commit 0b6399085a2f9a1d2e3e5a8ccded0eab70f04ac4)
---
 src/d3d11/d3d11_context_imm.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/d3d11/d3d11_context_imm.cpp b/src/d3d11/d3d11_context_imm.cpp
index 17c049c..fbb59d8 100644
--- a/src/d3d11/d3d11_context_imm.cpp
+++ b/src/d3d11/d3d11_context_imm.cpp
@@ -593,6 +593,7 @@ public:
   };
 
   HRESULT STDMETHODCALLTYPE Signal(ID3D11Fence *pFence, UINT64 Value) override {
+    std::lock_guard<d3d11_device_mutex> lock(mutex);
     auto fence = static_cast<MTLD3D11Fence *>(pFence);
 
     InvalidateCurrentPass();
@@ -605,6 +606,7 @@ public:
   }
 
   HRESULT STDMETHODCALLTYPE Wait(ID3D11Fence *pFence, UINT64 Value) override {
+    std::lock_guard<d3d11_device_mutex> lock(mutex);
     auto fence = static_cast<MTLD3D11Fence *>(pFence);
 
     Flush();
-- 

From 6615c314edb25033512f620cf6e97ab3b3e224e7 Mon Sep 17 00:00:00 2001
From: Gauthier Piarrette <gauthierpiarrette@gmail.com>
Date: Wed, 30 Sep 2026 18:10:11 +0200
Subject: [PATCH] fix(dxmt): initialize `device_` before the command helpers
 that use it

`ClearUAV`'s constructor creates its compute pipelines through
`ArgumentEncodingContext::getComputePipeline()`, which reads `ctx.device_`.
`device_` was declared after `clear_uav_cmd`, and members are initialized
in declaration order, so it was still uninitialized at that point.
Depending on what that memory held, pipeline creation was sent to a
garbage object and the process died with
`-[NSTaggedPointerString newComputePipelineStateWithDescriptor:options:reflection:error:]: unrecognized selector`.

Signed-off-by: Gauthier Piarrette <gauthierpiarrette@gmail.com>
Signed-off-by: Feifan He <feifan@codeweavers.com>
---
 src/dxmt/dxmt_context.cpp | 2 +-
 src/dxmt/dxmt_context.hpp | 9 ++++++++-
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/dxmt/dxmt_context.cpp b/src/dxmt/dxmt_context.cpp
index bfa03d1..0ba84cd 100644
--- a/src/dxmt/dxmt_context.cpp
+++ b/src/dxmt/dxmt_context.cpp
@@ -30,6 +30,7 @@
 namespace dxmt {
 
 ArgumentEncodingContext::ArgumentEncodingContext(CommandQueue &queue, WMT::Device device, InternalCommandLibrary &lib) :
+    device_(device),
     lib(lib),
     emulated_cmd(device, lib, *this),
     clear_rt_cmd(device, *this),
@@ -38,7 +39,6 @@ ArgumentEncodingContext::ArgumentEncodingContext(CommandQueue &queue, WMT::Devic
     mv_scale_cmd(device, lib, *this),
     tile_barrier_cmd(device, lib, *this),
     timestamp_state_(device),
-    device_(device),
     queue_(queue) {
   dummy_sampler_info_.support_argument_buffers = true;
   dummy_sampler_info_.border_color = WMTSamplerBorderColorTransparentBlack;
diff --git a/src/dxmt/dxmt_context.hpp b/src/dxmt/dxmt_context.hpp
index 1cd99ca..eabe872 100644
--- a/src/dxmt/dxmt_context.hpp
+++ b/src/dxmt/dxmt_context.hpp
@@ -829,6 +829,14 @@ public:
   uint32_t tess_num_output_control_point_element;
   uint32_t tess_threads_per_patch;
 
+private:
+  // Declared ahead of the command helpers below, which build their pipelines through this context
+  // in their constructors (ClearUAV reaches device_ through getComputePipeline): members start in
+  // declaration order, so declared after them it was still uninitialised memory there, and a game
+  // could die at start in newComputePipelineStateWithDescriptor on a garbage device.
+  WMT::Device device_;
+
+public:
   InternalCommandLibrary &lib;
   EmulatedCommandContext emulated_cmd;
   ClearRTV<ArgumentEncodingContext> clear_rt_cmd;
@@ -918,7 +926,6 @@ private:
 
   uint64_t intrapass_barrier_control_bits_ = 0;
 
-  WMT::Device device_;
   CommandQueue& queue_;
 };
 

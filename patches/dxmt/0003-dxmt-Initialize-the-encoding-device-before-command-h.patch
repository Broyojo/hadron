From c6e10afc2d132c401fa598a5528af8c6e932a3fd Mon Sep 17 00:00:00 2001
From: Lennard Zehner <127147155+Moeweneier@users.noreply.github.com>
Date: Fri, 16 Oct 2026 09:09:03 +0200
Subject: [PATCH] dxmt: Initialize the encoding device before command helpers.

ClearUAV compiles pipelines through its parent encoding context, which
reads device_. C++ initializes members in declaration order; put the
device before helpers whose constructors use it.

A launcher GPU-process diagnostic exposed an uninitialized device handle.
The independent clear/readback probe passes on both DLLs, so it does not
reproduce that allocation pattern by itself.

Co-Authored-By: Codex <noreply@openai.com>
---
 src/dxmt/dxmt_context.cpp | 2 +-
 src/dxmt/dxmt_context.hpp | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/dxmt/dxmt_context.cpp b/src/dxmt/dxmt_context.cpp
index bfa03d1..0ba84cd 100644
--- a/src/dxmt/dxmt_context.cpp
+++ b/src/dxmt/dxmt_context.cpp
@@ -30,6 +30,7 @@
 namespace dxmt {
 
 ArgumentEncodingContext::ArgumentEncodingContext(CommandQueue &queue, WMT::Device device, InternalCommandLibrary &lib) :
+    device_(device),
     lib(lib),
     emulated_cmd(device, lib, *this),
     clear_rt_cmd(device, *this),
@@ -38,7 +39,6 @@ ArgumentEncodingContext::ArgumentEncodingContext(CommandQueue &queue, WMT::Devic
     mv_scale_cmd(device, lib, *this),
     tile_barrier_cmd(device, lib, *this),
     timestamp_state_(device),
-    device_(device),
     queue_(queue) {
   dummy_sampler_info_.support_argument_buffers = true;
   dummy_sampler_info_.border_color = WMTSamplerBorderColorTransparentBlack;
diff --git a/src/dxmt/dxmt_context.hpp b/src/dxmt/dxmt_context.hpp
index 1cd99ca..6cc1ede 100644
--- a/src/dxmt/dxmt_context.hpp
+++ b/src/dxmt/dxmt_context.hpp
@@ -334,6 +334,8 @@ struct AllocatedTempBufferSlice {
 class ArgumentEncodingContext {
   friend struct SimpleCommandContext<ArgumentEncodingContext>;
 private:
+  // Command helpers compile pipelines through this context during construction.
+  WMT::Device device_;
   template <PipelineStage stage> void track(GenericAccessTracker &tracker, int flags);
 
 public:
@@ -918,7 +920,6 @@ private:
 
   uint64_t intrapass_barrier_control_bits_ = 0;
 
-  WMT::Device device_;
   CommandQueue& queue_;
 };
 
-- 
2.47.1


From c9b8a7b6fea240d5337a649f1fc455d188c6110e Mon Sep 17 00:00:00 2001
From: Broyojo <dha@xoba.com>
Date: Fri, 2 Oct 2026 12:00:25 -0400
Subject: [PATCH] kk: Leave MSL temporaries uninitialised and skip the
 uninitialised analysis

Generated-by: LLM
---
 src/kosmickrisp/compiler/nir_to_msl.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/kosmickrisp/compiler/nir_to_msl.c b/src/kosmickrisp/compiler/nir_to_msl.c
index ae07d0a896e..3a4ad2c1e76 100644
--- a/src/kosmickrisp/compiler/nir_to_msl.c
+++ b/src/kosmickrisp/compiler/nir_to_msl.c
@@ -2601,10 +2601,7 @@ predeclare_ssa_values(struct nir_to_msl_ctx *ctx, nir_function_impl *impl)
             const char *type = msl_type_for_def(ctx->types, def);
             if (!type)
                continue;
-            if (msl_def_is_sampler(ctx, def)) {
-               P_IND(ctx, "%s t%u;\n", type, def->index);
-            } else
-               P_IND(ctx, "%s t%u = %s(0);\n", type, def->index, type);
+            P_IND(ctx, "%s t%u;\n", type, def->index);
          }
       }
    }
@@ -2649,6 +2646,9 @@ nir_to_msl(nir_shader *shader, struct nir_to_msl_options *options)
    msl_gather_info(&ctx, options);
 
    P(&ctx, "// Generated by Mesa compiler\n");
+   P(&ctx, "#pragma clang diagnostic ignored \"-Wuninitialized\"\n");
+   P(&ctx, "#pragma clang diagnostic ignored \"-Wsometimes-uninitialized\"\n");
+   P(&ctx, "#pragma clang diagnostic ignored \"-Wconditional-uninitialized\"\n");
    if (shader->info.stage == MESA_SHADER_COMPUTE ||
        shader->info.stage == MESA_SHADER_TESS_CTRL)
       P(&ctx, "#include <metal_compute>\n");

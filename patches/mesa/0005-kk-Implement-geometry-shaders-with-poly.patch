+static enum mesa_prim
+kk_gs_in_prim(struct kk_cmd_buffer *cmd)
+{
+   if (cmd->state.shaders[MESA_SHADER_TESS_EVAL])
+      return cmd->state.gfx.tess.prim;
+
+   return vk_topology_to_mesa(

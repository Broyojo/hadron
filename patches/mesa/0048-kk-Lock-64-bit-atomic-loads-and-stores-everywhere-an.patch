+             NULL);
+      *locked_out |= BITFIELD_BIT(KK_ATOMIC64_IMAGE);
+      nir_instr_remove(&intrin->instr);
+      return;
+   }
+
    const nir_atomic_op op = nir_intrinsic_atomic_op(intrin);
 

       return nir_ixor(b, key, nir_ushr_imm(b, key, 15));
    }
    }
@@ -95,7 +98,8 @@ load_value(nir_builder *b, const struct target *t)
          nir_imm_int(b, 0), .image_dim = nir_intrinsic_image_dim(image),

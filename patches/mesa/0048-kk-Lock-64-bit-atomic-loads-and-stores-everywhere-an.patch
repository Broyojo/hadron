+                         .base = nir_intrinsic_base(intrin)};
+      locked(b, &t, nir_atomic_op_xchg, intrin->src[0].ssa, NULL);
+      nir_instr_remove(&intrin->instr);
+      return;
+   }
+
+   if (intrin->intrinsic == nir_intrinsic_bindless_image_store) {

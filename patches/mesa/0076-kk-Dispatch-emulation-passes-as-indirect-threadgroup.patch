           * is taken, since we launch compute, they correctly get translated.
@@ -1529,6 +1559,7 @@ kk_compile_shader(struct kk_device *dev, nir_shader *nir,
          nir->info.stage = MESA_SHADER_COMPUTE;
          memset(&nir->info.cs, 0, sizeof(nir->info.cs));
          nir->xfb_info = NULL;
+         NIR_PASS(_, nir, kk_nir_guard_threads, false);
       }
    } else if (stage == MESA_SHADER_GEOMETRY) {
       nir_shader *count = NULL, *rast = NULL, *pre_gs = NULL;
@@ -1540,6 +1571,7 @@ kk_compile_shader(struct kk_device *dev, nir_shader *nir,
          count->info.stage = MESA_SHADER_COMPUTE;
          memset(&count->info.cs, 0, sizeof(count->info.cs));
          count->xfb_info = NULL;
+         NIR_PASS(_, count, kk_nir_guard_threads, true);
          kk_compile_msl(pdev, count, state, &shader->gs_count,
                         &shader->info.atomic64_locked);
       } else {
@@ -1569,6 +1601,7 @@ kk_compile_shader(struct kk_device *dev, nir_shader *nir,
       nir->info.stage = MESA_SHADER_COMPUTE;
       memset(&nir->info.cs, 0, sizeof(nir->info.cs));
       nir->xfb_info = NULL;
+      NIR_PASS(_, nir, kk_nir_guard_threads, true);
    }
 
    if (stage == MESA_SHADER_FRAGMENT) {
@@ -1886,6 +1919,9 @@ gather_graphics_pipeline_create_info(
 
       info->vs.additional_stages_bits |= BITFIELD_BIT(stage);
 

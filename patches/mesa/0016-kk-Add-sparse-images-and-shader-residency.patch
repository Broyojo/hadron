+static void
+kk_queue_map_texture(struct kk_queue *queue, struct kk_image_plane *plane,
+                     struct kk_device_memory *mem,
+                     struct mtl_sparse_texture_mapping mapping)
+{
+   mapping.map = mem != NULL;
+   if (!mapping.map)
+      mapping.heap_page = 0u;
+

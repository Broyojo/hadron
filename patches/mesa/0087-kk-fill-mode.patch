+static nir_def *
+kk_polygon_point_test(nir_builder *b, nir_def **pos, nir_def *viewport,
+                      nir_def **dz_out)
+{
+   nir_def *vp = kk_load_root_vec4_indexed(
+      b, offsetof(struct kk_root_descriptor_table, draw.polygon_viewport),
+      viewport);
+   nir_def *k = nir_channel(b, vp, 2);
+
+   nir_def *x[3], *y[3], *z[3], *w[3];
+   for (unsigned i = 0; i < 3; i++) {
+      w[i] = nir_channel(b, pos[i], 3);
+      x[i] = nir_fmul(b, nir_fdiv(b, nir_channel(b, pos[i], 0), w[i]),
+                      nir_channel(b, vp, 0));
+      y[i] = nir_fmul(b, nir_fdiv(b, nir_channel(b, pos[i], 1), w[i]),
+                      nir_channel(b, vp, 1));
+      z[i] = nir_ffma(b, nir_fdiv(b, nir_channel(b, pos[i], 2), w[i]), k,
+                      nir_channel(b, vp, 3));
+   }
+   nir_def *e1x = nir_fsub(b, x[1], x[0]), *e1y = nir_fsub(b, y[1], y[0]);
+   nir_def *e1z = nir_fsub(b, z[1], z[0]);
+   nir_def *e2x = nir_fsub(b, x[2], x[0]), *e2y = nir_fsub(b, y[2], y[0]);
+   nir_def *e2z = nir_fsub(b, z[2], z[0]);
+   nir_def *cross =
+      nir_fsub(b, nir_fmul(b, e1x, e2y), nir_fmul(b, e1y, e2x));
+   nir_def *degenerate = nir_feq_imm(b, cross, 0.0f);
+
+   nir_def *cull = kk_load_root_constant(
+      b, 1, 32, offsetof(struct kk_root_descriptor_table, draw.polygon_cull));
+   nir_def *positive = nir_fgt_imm(b, cross, 0.0f);
+   nir_def *ccw = nir_i2b(b, nir_iand_imm(b, cull, KK_POLYGON_FRONT_CCW));
+   nir_def *front = nir_ieq(b, positive, nir_inot(b, ccw));
+   nir_def *cull_front =
+      nir_i2b(b, nir_iand_imm(b, cull, KK_POLYGON_CULL_FRONT));
+   nir_def *cull_back =
+      nir_i2b(b, nir_iand_imm(b, cull, KK_POLYGON_CULL_BACK));
+   nir_def *culled = nir_bcsel(b, degenerate,
+                               nir_ior(b, cull_front, cull_back),
+                               nir_bcsel(b, front, cull_front, cull_back));
+

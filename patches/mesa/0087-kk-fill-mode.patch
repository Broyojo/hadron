+                                                       0x1p-126f))),
+                       -23.0f));
+   nir_def *unorm_r = nir_channel(b, bias, 3);
+   nir_def *r = nir_bcsel(b, nir_feq_imm(b, unorm_r, 0.0f), float_r,

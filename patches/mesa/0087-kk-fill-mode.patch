+static void
+kk_emit_polygon_points(nir_shader *gs)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(gs);
+   nir_cf_list body;
+   nir_cf_extract(&body, nir_before_impl(impl), nir_after_impl(impl));
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+
+   nir_def *viewport = nir_imm_int(&b, 0);
+   if (gs->info.inputs_read & VARYING_BIT_VIEWPORT) {
+      nir_io_semantics vp_sem = {.location = VARYING_SLOT_VIEWPORT,
+                                 .num_slots = 1};
+      viewport = nir_load_per_vertex_input(
+         &b, 1, 32, nir_imm_int(&b, 0), nir_imm_int(&b, 0),
+         .io_semantics = vp_sem, .dest_type = nir_type_int32);
+   }
+
+   nir_io_semantics pos_sem = {.location = VARYING_SLOT_POS, .num_slots = 1};
+   nir_def *pos[3], *w[3];
+   for (unsigned i = 0; i < 3; i++) {
+      pos[i] = nir_load_per_vertex_input(
+         &b, 4, 32, nir_imm_int(&b, i), nir_imm_int(&b, 0),
+         .io_semantics = pos_sem, .dest_type = nir_type_float32);
+      w[i] = nir_channel(&b, pos[i], 3);
+   }
+   nir_def *dz;
+   nir_def *culled = kk_polygon_point_test(&b, pos, viewport, &dz);
+
+   nir_push_if(&b, nir_inot(&b, culled));
+   nir_cf_reinsert(&body, b.cursor);
+   nir_pop_if(&b, NULL);
+
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *store = nir_instr_as_intrinsic(instr);
+         if (store->intrinsic != nir_intrinsic_store_output ||
+             nir_intrinsic_io_semantics(store).location != VARYING_SLOT_POS ||
+             nir_intrinsic_component(store) != 2)
+            continue;
+         nir_instr *src = nir_def_instr(store->src[0].ssa);
+         if (src->type == nir_instr_type_alu)
+            src = nir_def_instr(nir_instr_as_alu(src)->src[0].src.ssa);
+         nir_intrinsic_instr *load = nir_instr_as_intrinsic(src);
+         assert(load->intrinsic == nir_intrinsic_load_per_vertex_input);
+         unsigned vertex = nir_src_as_uint(load->src[0]);
+         b.cursor = nir_before_instr(instr);
+         nir_src_rewrite(&store->src[0],
+                         nir_ffma(&b, dz, w[vertex], store->src[0].ssa));
+      }
+   }
+
+   gs->info.gs.output_primitive = MESA_PRIM_POINTS;
+   nir_progress(true, impl, nir_metadata_none);
+}

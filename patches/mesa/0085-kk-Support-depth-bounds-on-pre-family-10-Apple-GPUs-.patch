+static void
+kk_flush_depth_bounds(struct kk_cmd_buffer *cmd)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_physical_device *pdev = kk_device_physical(dev);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   struct kk_descriptor_state *desc = &gfx->descriptors;
+   const struct vk_dynamic_graphics_state *dyn =
+      &cmd->vk.dynamic_graphics_state;
+   struct kk_image_view *iview = gfx->render.depth_att.iview;
+   struct kk_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+
+   gfx->depth_bounds_active = false;
+   if (kk_has_native_depth_bounds(pdev))
+      return;
+
+   bool has_depth =
+      iview != NULL && (iview->vk.aspects & VK_IMAGE_ASPECT_DEPTH_BIT);
+   bool writes_depth =
+      has_depth && dyn->ds.depth.test_enable && dyn->ds.depth.write_enable;
+
+   if (!dyn->ds.depth.bounds_test.enable || !has_depth || vs == NULL ||
+       !(vs->info.fs_variant_mask &
+         BITFIELD_BIT(KK_FS_VARIANT_DEPTH_BOUNDS))) {
+      if (writes_depth)
+         gfx->render.depth_in_memory = false;
+      return;
+   }
+
+   if (cmd->metal.render != NULL && !gfx->render.depth_in_memory) {
+      kk_apply_attachment_store_ops(cmd, true);
+      cs_end(cmd);
+      kk_cmd_buffer_dirty_all_gfx(cmd);
+      gfx->need_to_start_render_pass = true;
+   }
+   gfx->render.depth_in_memory = !writes_depth;
+
+   desc->root.draw.depth_bounds_texture =
+      writes_depth ? kk_depth_bounds_copy(cmd, iview)
+                   : iview->planes[0].input_gpu_resource_id;
+   desc->root.draw.depth_bounds[0] = dyn->ds.depth.bounds_test.min;
+   desc->root.draw.depth_bounds[1] = dyn->ds.depth.bounds_test.max;
+   desc->root_dirty = true;
+   gfx->depth_bounds_active = true;

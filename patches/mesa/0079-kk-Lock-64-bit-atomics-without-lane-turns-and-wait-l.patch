From 8bc4d4293c60905cb413a7263514ed8985123cdf Mon Sep 17 00:00:00 2001
From: Broyojo <dha@xoba.com>
Date: Sun, 4 Oct 2026 02:04:01 -0400
Subject: [PATCH] kk: Lock 64-bit atomics without lane turns and wait longer
 for the lock

Generated-by: LLM
---
 .../vulkan/kk_nir_lower_atomic64.c            | 74 ++-----------------
 src/kosmickrisp/vulkan/kk_shader.h            |  2 +-
 2 files changed, 6 insertions(+), 70 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_nir_lower_atomic64.c b/src/kosmickrisp/vulkan/kk_nir_lower_atomic64.c
index 6d95373133b..5406499fb67 100644
--- a/src/kosmickrisp/vulkan/kk_nir_lower_atomic64.c
+++ b/src/kosmickrisp/vulkan/kk_nir_lower_atomic64.c
@@ -193,63 +193,8 @@ report_timeout(nir_builder *b)
 }
 
 static nir_def *
-locked_in_turns(nir_builder *b, const struct target *t, nir_atomic_op op,
-                nir_def *data, nir_def *swap)
-{
-   nir_function_impl *impl = b->impl;
-   nir_variable *result =
-      nir_local_variable_create(impl, glsl_uint64_t_type(), "atomic64_old");
-   nir_variable *turn =
-      nir_local_variable_create(impl, glsl_uint_type(), "atomic64_turn");
-
-   nir_def *lock = lock_address(b, t);
-   nir_def *lane = nir_load_subgroup_invocation(b);
-   nir_store_var(b, turn, nir_imm_int(b, 0), 1);
-   nir_store_var(b, result, nir_imm_int64(b, 0), 1);
-
-   nir_push_loop(b);
-   {
-      nir_def *j = nir_load_var(b, turn);
-      nir_break_if(b, nir_uge_imm(b, j, 32));
-      nir_push_if(b, nir_ieq(b, j, lane));
-      {
-         nir_variable *spins =
-            nir_local_variable_create(impl, glsl_uint_type(), "atomic64_spins");
-         nir_variable *held =
-            nir_local_variable_create(impl, glsl_bool_type(), "atomic64_held");
-         nir_store_var(b, spins, nir_imm_int(b, 0), 1);
-         nir_store_var(b, held, nir_imm_false(b), 1);
-         nir_push_loop(b);
-         {
-            nir_def *acquired = try_lock(b, lock);
-            nir_store_var(b, held, acquired, 1);
-            nir_break_if(b, acquired);
-            nir_def *spun = nir_load_var(b, spins);
-            nir_break_if(b, nir_uge_imm(b, spun, KK_ATOMIC64_SPIN_LIMIT));
-            nir_store_var(b, spins, nir_iadd_imm(b, spun, 1), 1);
-         }
-         nir_pop_loop(b, NULL);
-
-         nir_push_if(b, nir_load_var(b, held));
-         {
-            nir_store_var(b, result, critical_section(b, t, op, data, swap), 1);
-            unlock(b, lock);
-         }
-         nir_push_else(b, NULL);
-         report_timeout(b);
-         nir_pop_if(b, NULL);
-      }
-      nir_pop_if(b, NULL);
-      nir_store_var(b, turn, nir_iadd_imm(b, j, 1), 1);
-   }
-   nir_pop_loop(b, NULL);
-
-   return nir_load_var(b, result);
-}
-
-static nir_def *
-locked_by_state(nir_builder *b, const struct target *t, nir_atomic_op op,
-                nir_def *data, nir_def *swap)
+locked(nir_builder *b, const struct target *t, nir_atomic_op op, nir_def *data,
+       nir_def *swap)
 {
    nir_function_impl *impl = b->impl;
    nir_variable *result =
@@ -271,7 +216,9 @@ locked_by_state(nir_builder *b, const struct target *t, nir_atomic_op op,
       nir_push_if(b, nir_ieq_imm(b, s, 1));
       {
          nir_store_var(b, result, critical_section(b, t, op, data, swap), 1);
-         nir_store_var(b, state, nir_iadd_imm(b, unlock(b, lock), 1), 1);
+         nir_store_var(b, state,
+                       nir_iadd_imm(b, nir_ior_imm(b, unlock(b, lock), 1), 1),
+                       1);
       }
       nir_push_else(b, NULL);
       {
@@ -296,17 +243,6 @@ locked_by_state(nir_builder *b, const struct target *t, nir_atomic_op op,
    return nir_load_var(b, result);
 }
 
-static nir_def *
-locked(nir_builder *b, const struct target *t, nir_atomic_op op, nir_def *data,
-       nir_def *swap)
-{
-   const mesa_shader_stage stage = b->shader->info.stage;
-   if (stage == MESA_SHADER_COMPUTE || stage == MESA_SHADER_FRAGMENT)
-      return locked_in_turns(b, t, op, data, swap);
-
-   return locked_by_state(b, t, op, data, swap);
-}
-
 static bool
 is_atomic64(const nir_intrinsic_instr *intrin)
 {
diff --git a/src/kosmickrisp/vulkan/kk_shader.h b/src/kosmickrisp/vulkan/kk_shader.h
index 49f3211a8b3..5e20544075f 100644
--- a/src/kosmickrisp/vulkan/kk_shader.h
+++ b/src/kosmickrisp/vulkan/kk_shader.h
@@ -225,7 +225,7 @@ bool kk_nir_lower_compute_lod_queries(nir_shader *nir);
 #define KK_ATOMIC64_TIMEOUT     2
 #define KK_ATOMIC64_LOCK_COUNT  4096u
 #define KK_ATOMIC64_LOCK_OFFSET 64u
-#define KK_ATOMIC64_SPIN_LIMIT  (1u << 22)
+#define KK_ATOMIC64_SPIN_LIMIT  (1u << 25)
 #define KK_ATOMIC64_ARENA_SIZE  \
    (KK_ATOMIC64_LOCK_OFFSET + 4u * KK_ATOMIC64_LOCK_COUNT)
 

 dylib/core/loader.c          |   2 +
 dylib/feats/shortcut_icons.c | 116 +++++++++++++++++++++++++++++++++++
 dylib/feats/shortcut_icons.h |   9 +++
 4 files changed, 128 insertions(+)
 create mode 100644 dylib/feats/shortcut_icons.c
 create mode 100644 dylib/feats/shortcut_icons.h


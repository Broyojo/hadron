 	dylib/feats/webui.c \
 	dylib/feats/compatsvc.c \
 	dylib/feats/webpatch.c \
+	dylib/feats/shortcut_icons.c \
 	vendor/cJSON.c
 
 OUT_DIR     := out
diff --git a/dylib/core/loader.c b/dylib/core/loader.c
index 1a97a99..a9f9e6f 100644
--- a/dylib/core/loader.c
+++ b/dylib/core/loader.c
@@ -7,6 +7,7 @@

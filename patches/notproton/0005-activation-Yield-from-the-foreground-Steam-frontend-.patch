+#!/usr/bin/env python3
+"""Interactive native activation controls; uses private apps, never Steam or games."""
+from pathlib import Path
+import hashlib
+import json
+import plistlib
+import shutil
+import subprocess
+import tempfile
+import time
+from activation_processes import wait_for_exit, cleanup
+
+root = Path(__file__).resolve().parents[2]
+tests = root / 'dylib/tests'
+out = Path(tempfile.mkdtemp(prefix='activation-', dir=root / 'out'))
+print('Results:', out, flush=True)
+
+def run(args, **options):
+    return subprocess.run([str(a) for a in args], check=True, timeout=30, **options)
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+# Only test application identities differ. The handoff/acknowledgement code is
+# compiled unchanged, with the production memory-management flags (no ARC).
+source = root / 'dylib/feats/activation.m'
+text = source.read_text()
+identities = {'com.valvesoftware.steam': 'com.hadron.activation-test.parent.' + out.name,
+              'com.valvesoftware.steam.helper': 'com.hadron.activation-test.helper.' + out.name}
+for original, replacement in identities.items():
+    if text.count('@"' + original + '"') != 1:
+        raise RuntimeError('Unexpected production frontend identity definition')
+    text = text.replace('@"' + original + '"', '@"' + replacement + '"')
+candidate = out / 'activation.m'
+candidate.write_text(text)
+activation = out / 'activation.o'
+run(['xcrun', 'clang', '-O2', '-Wall', '-Wextra', '-Werror',
+     '-I', root / 'dylib/feats', '-c', candidate, '-o', activation])
+probe = out / 'probe'
+run(['xcrun', 'clang', '-fobjc-arc', '-O2', '-Wall', '-Wextra', '-Werror',
+     '-framework', 'AppKit', tests / 'activation-probe.m', activation,
+     root / 'dylib/util/log.c', root / 'dylib/util/file.c', '-o', probe])
+requester = out / 'activation-request'
+run(['xcrun', 'clang', '-O2', '-Wall', '-Wextra', '-Werror', '-framework', 'AppKit',
+     tests.parent / 'feats/activation-request.c', activation,
+     root / 'dylib/util/log.c', root / 'dylib/util/file.c', '-o', requester])
+detach = out / 'detach'
+run(['xcrun', 'clang', '-O2', '-Wall', '-Wextra', '-Werror',
+     tests / 'activation-detach.c', '-o', detach])
+run(['codesign', '-f', '-s', '-', probe])
+
+bundles = {'Parent': 'com.hadron.activation-test.parent.' + out.name,
+           'Helper': 'com.hadron.activation-test.helper.' + out.name,
+           'Other': 'com.hadron.activation-test.other.' + out.name,
+           'Child': 'com.broyojo.hadron.game.4294967002'}
+cases = [('relay-none', 0, False, False, 0, 0),
+         ('relay-ready', 0, False, True, 0, 0),
+         ('relay-ready', 1.2, False, True, 0, 0),
+         ('relay-slow', 0, False, True, 0, 0),
+         ('relay-absent', 0, False, False, 0, 0),
+         ('relay-ready', 1.2, True, False, 0, 0),
+         ('relay-ready', 0, False, True, .7, 1.0),
+         ('parent-ready', 0, False, True, 0, 0)]
+results = []
+receipt = {'source_sha256': sha(source), 'compiled_source_sha256': sha(candidate),
+           'requester_source_sha256': sha(tests.parent / 'feats/activation-request.c'),
+           'probe_source_sha256': sha(tests / 'activation-probe.m'),
+           'runner_sha256': sha(Path(__file__)),
+           'process_checks_sha256': sha(tests / 'activation_processes.py'),
+           'requester_sha256': sha(requester), 'probe_sha256': sha(probe), 'detach_sha256': sha(detach),
+           'identity_substitutions': identities,
+           'macos': run(['sw_vers'], capture_output=True, text=True).stdout}
+(out / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
+
+for mode, delay, switch, expected, start_delay, exit_delay in cases:
+    listing = run(['ps', '-axo', 'comm='], capture_output=True, text=True).stdout
+    if any(row.strip().lower().endswith('.exe') or Path(row.strip()).name.lower()
+           in ('wine', 'wine64', 'wineserver') for row in listing.splitlines()):
+        raise RuntimeError('Existing Wine session; postpone interactive controls')
+    case = out / f'{mode}-{delay}-{int(switch)}-{start_delay}-{exit_delay}'
+    case.mkdir()
+    for role, bundle in bundles.items():
+        contents = case / (role + '.app') / 'Contents'
+        (contents / 'MacOS').mkdir(parents=True)
+        shutil.copy2(probe, contents / 'MacOS/probe')
+        info = {'CFBundleExecutable': 'probe', 'CFBundleIdentifier': bundle,
+                'CFBundleName': role, 'CFBundlePackageType': 'APPL'}
+        if role == 'Child':
+            info['LSUIElement'] = True
+        (contents / 'Info.plist').write_bytes(plistlib.dumps(info))
+    shutil.copy2(detach, case / 'detach')
+    shutil.copy2(requester, case / 'activation-request')
+    try:
+        run(['open', '-n', '-W', '-a', case / 'Parent.app', '--args', 'parent', case,
+             mode, delay, int(switch), start_delay, exit_delay])
+        parent_exit = time.monotonic()
+        wait_for_exit(case, 10)
+        (case / 'termination.json').write_text(json.dumps({
+            'all_exited': True, 'wait_after_parent_ms': (time.monotonic() - parent_exit) * 1000}))
+    finally:
+        cleanup(case)
+    def rows(role):
+        return [json.loads(line) for line in (case / (role + '.jsonl')).read_text().splitlines()]
+    parent, child = rows('parent'), rows('child')
+    before = next(r for r in parent if r['phase'] == 'before-spawn')
+    after = next(r for r in child if r['phase'] == 'after-request')
+    helper_role = 'relay-absent' if mode == 'relay-absent' else 'relay-slow' if mode == 'relay-slow' else 'relay-helper'
+    helper = rows(helper_role) if mode.startswith('relay-') else []
+    other = rows('helper') if switch else []
+    # A missing launch/final record, mixed process identities, failed asynchronous
+    # launch, or failed requester cannot qualify merely because focus looks right.
+    complete = all(any(r['phase'] == 'launched' for r in records) and
+                   any(r['phase'] == 'final' for r in records) and
+                   len({r['pid'] for r in records}) == 1
+                   for records in (parent, child, *([helper] if helper else []), *([other] if switch else [])))
+    complete = complete and (not mode.startswith('relay-') or any(r['phase'] == 'helper-opened' for r in parent))
+    complete = complete and (not switch or any(r['phase'] == 'other-opened' for r in parent))
+    complete = complete and not any(r['phase'].endswith('-failed') for r in parent)
+    if exit_delay:
+        complete = complete and any(r['phase'] == 'exit-delay-end' for r in helper)
+    allowed = set(bundles.values())
+    qualified = (complete and before['front_bundle'] == bundles['Helper' if mode.startswith('relay-') else 'Parent'] and
+                 child[0]['ppid'] == 1 and
+                 all(r['front_bundle'] in allowed for r in parent + helper + child + other
+                     if r['phase'] == 'did-deactivate'))
+    if switch:
+        qualified = qualified and after['front_bundle'] == bundles['Other']
+    handoff = None
+    if mode != 'relay-none':
+        begin = next(r for r in parent if r['phase'] == 'before-handoff')
+        end = next(r for r in parent if r['phase'] == 'after-handoff')
+        handoff = (end['uptime'] - begin['uptime']) * 1000
+    timing_ok = True
+    if mode == 'relay-slow':
+        slow_begin = next(r for r in helper if r['phase'] == 'slow-callback-begin')
+        slow_end = next(r for r in helper if r['phase'] == 'slow-callback-end')
+        timing_ok = slow_begin['uptime'] <= begin['uptime'] < slow_end['uptime'] <= end['uptime']
+    if mode == 'relay-absent':
+        timing_ok = 1900 <= handoff <= 2600
+    passed = qualified and timing_ok and after['active'] == expected and after['key'] == expected
+    result = {'mode': mode, 'delay': delay, 'switch': switch,
+              'helper_start_delay': start_delay, 'helper_exit_delay': exit_delay,
+              'expected_activation': expected, 'before': before, 'after': after,
+              'handoff_ms': handoff, 'qualified': qualified,
+              'timing_ok': timing_ok, 'result': 'PASS' if passed else 'FAIL'}
+    results.append(result)
+    (out / 'results.json').write_text(json.dumps(results, indent=2) + '\n')
+    print(json.dumps(result), flush=True)
+    if not passed:
+        raise RuntimeError('Activation mismatch or unqualified desktop; inspect logs')
+print('PASS: eight activation controls and explicit process termination; this does not establish game acceptance.')

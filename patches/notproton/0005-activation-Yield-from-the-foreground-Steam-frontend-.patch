+++ b/dylib/tests/activation_processes.py
@@ -0,0 +1,89 @@
+"""Bounded lifecycle checks for the exact executables in a private relay case."""
+import ctypes
+import os
+import json
+import signal
+import time
+
+libproc = ctypes.CDLL('/usr/lib/libproc.dylib', use_errno=True)
+libproc.proc_listallpids.argtypes = [ctypes.c_void_p, ctypes.c_int]
+libproc.proc_listallpids.restype = ctypes.c_int
+libproc.proc_pidpath.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_uint32]
+libproc.proc_pidpath.restype = ctypes.c_int
+
+
+def executable(pid):
+    buf = ctypes.create_string_buffer(4096)
+    if libproc.proc_pidpath(pid, buf, len(buf)) <= 0:
+        return None  # Exited processes have no executable path.
+    return os.fsdecode(buf.value)
+
+
+def processes(case):
+    paths = {str((case / (role + '.app/Contents/MacOS/probe')).resolve())
+             for role in ('Parent', 'Helper', 'Other', 'Child')}
+    paths.update(str((case / name).resolve()) for name in ('detach', 'activation-request'))
+    count = libproc.proc_listallpids(None, 0)
+    if count <= 0:
+        raise RuntimeError('Cannot enumerate processes')
+    # Retry if the process table grew beyond our allocation.
+    while True:
+        pids = (ctypes.c_int * (count + 256))()
+        used = libproc.proc_listallpids(pids, ctypes.sizeof(pids))
+        if used <= 0:
+            raise RuntimeError('Cannot enumerate processes')
+        if used < len(pids):
+            break
+        count = used
+    return {pid: path for pid in pids[:used] if (path := executable(pid)) in paths}
+
+
+def wait_for_exit(case, timeout):
+    deadline = time.monotonic() + timeout
+    while True:
+        alive = processes(case)
+        if not alive:
+            return
+        if time.monotonic() >= deadline:
+            raise TimeoutError(f'Private case processes did not exit: {alive}')
+        time.sleep(.05)
+
+
+def pending_launches(case):
+    log = case / 'parent.jsonl'
+    if not log.exists():
+        return set()
+    phases = []
+    for line in log.read_text().splitlines():
+        try:
+            phases.append(json.loads(line)['phase'])
+        except (ValueError, KeyError):
+            # A concurrent partial write cannot establish launch completion.
+            return {'incomplete-log'}
+    return {role for role in ('helper', 'other') if role + '-opening' in phases
+            and role + '-opened' not in phases and role + '-open-failed' not in phases}
+
+
+def cleanup(case):
+    # LaunchServices can still be starting an application after a failing parent
+    # exits. Account for completion callbacks, not an arbitrary quiet interval.
+    deadline = time.monotonic() + 5
+    while True:
+        alive = processes(case)
+        pending = pending_launches(case)
+        if not alive and not pending:
+            return
+        expired = time.monotonic() >= deadline
+        for pid, path in alive.items():
+            # Give an in-flight launch its bounded chance to report its PID.
+            if pending and '/Parent.app/' in path and not expired:
+                continue
+            if executable(pid) == path:
+                try:
+                    os.kill(pid, signal.SIGKILL)
+                except ProcessLookupError:
+                    pass
+        if expired:
+            # No later case may start after an unaccounted asynchronous launch.
+            raise RuntimeError(f'Incomplete private cleanup: alive={alive}, pending={pending}')
+        time.sleep(.05)

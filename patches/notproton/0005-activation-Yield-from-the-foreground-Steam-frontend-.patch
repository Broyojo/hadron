@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+"""Unattended termination, timeout and failure-cleanup controls; no GUI apps."""
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+from activation_processes import processes, wait_for_exit, cleanup, pending_launches
+
+with tempfile.TemporaryDirectory(prefix='activation-processes-') as temporary:
+    case = Path(temporary).resolve()
+    own = case / 'Helper.app/Contents/MacOS/probe'
+    own.parent.mkdir(parents=True)
+    source = case / 'sleep.c'
+    source.write_text('#include <stdlib.h>\n#include <unistd.h>\nint main(int n, char **v) { if (n != 2) return 2; sleep(atoi(v[1])); return 0; }\n')
+    subprocess.run(['xcrun', 'clang', source, '-o', own], check=True)
+    unrelated_path = case / 'unrelated/probe'
+    unrelated_path.parent.mkdir()
+    shutil.copyfile(own, unrelated_path)
+    unrelated_path.chmod(0o755)
+    unrelated = subprocess.Popen([unrelated_path, '30'])
+    child = None
+    try:
+        child = subprocess.Popen([own, '1'])
+        wait_for_exit(case, 3)
+        child.wait(timeout=1)
+        print('PASS: waits for explicit process exit')
+        child = subprocess.Popen([own, '30'])
+        try:
+            wait_for_exit(case, .1)
+        except TimeoutError:
+            pass
+        else:
+            raise AssertionError('Missing timeout failure')
+        # This is the same finally path used when open, qualification or a timer fails.
+        cleanup(case)
+        child.wait(timeout=1)
+        assert not processes(case)
+        assert unrelated.poll() is None, 'Cleanup touched a different executable with the same name'
+        print('PASS: timeout fails and cleanup stops only the exact private executable')
+        log = case / 'parent.jsonl'
+        log.write_text(json.dumps({'phase': 'helper-opening'}) + '\n')
+        assert pending_launches(case) == {'helper'}
+        try:
+            cleanup(case)
+        except RuntimeError:
+            pass
+        else:
+            raise AssertionError('An unaccounted asynchronous launch must fail cleanup')
+        with log.open('a') as out:
+            out.write(json.dumps({'phase': 'helper-open-failed'}) + '\n')
+        cleanup(case)
+        print('PASS: absent asynchronous completion cannot qualify as cleanup')
+    finally:
+        if child is not None and child.poll() is None:
+            child.kill()
+            child.wait(timeout=2)
+        unrelated.terminate()
+        unrelated.wait(timeout=2)

diff --git a/dylib/feats/activation.m b/dylib/feats/activation.m
new file mode 100644
index 0000000..b176aa2
--- /dev/null
+++ b/dylib/feats/activation.m
@@ -0,0 +1,147 @@
+#import <AppKit/AppKit.h>
+#include "activation.h"
+#include "../util/log.h"
+#include <errno.h>
+#include <math.h>
+#include <libproc.h>
+#include <poll.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+static NSString *const request_name = @"com.broyojo.hadron.activation.request";
+static NSString *const game_prefix = @"com.broyojo.hadron.game.";
+static id observer;
+
+static BOOL steam_application(NSRunningApplication *app)
+{
+    return [app.bundleIdentifier isEqualToString:@"com.valvesoftware.steam"] ||
+           [app.bundleIdentifier isEqualToString:@"com.valvesoftware.steam.helper"];
+}
+
+// steam-run requests the handoff only after selecting its game route. Its
+// short-lived requester is a descendant of the client, not a Steam application.
+// Keep the relay's Steam identity check; a manual launch has no such ancestor.
+static pid_t steam_ancestor(void)
+{
+    pid_t pid = getpid();
+    for (unsigned depth = 0; pid > 1 && depth < 64; depth++)
+    {
+        if (steam_application([NSRunningApplication runningApplicationWithProcessIdentifier:pid]))
+            return pid;
+        struct proc_bsdinfo info;
+        if (proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, &info, sizeof(info)) != sizeof(info) ||
+            info.pbi_ppid == (uint32_t)pid) break;
+        pid = info.pbi_ppid;
+    }
+    return 0;
+}
+
+static BOOL valid_app_id(const char *value)
+{
+    if (!value || !*value || strlen(value) > 10 || strspn(value, "0123456789") != strlen(value))
+        return NO;
+    unsigned long long number = strtoull(value, NULL, 10);
+    return number && number <= UINT32_MAX;
+}
+
+static void reply(NSString *path, char result)
+{
+    struct sockaddr_un address = {.sun_family = AF_UNIX};
+    const char *name = path.fileSystemRepresentation;
+    if (!name || strlen(name) >= sizeof(address.sun_path)) return;
+    memcpy(address.sun_path, name, strlen(name) + 1);
+    int fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+    if (fd == -1) return;
+    sendto(fd, &result, 1, 0, (struct sockaddr *)&address, sizeof(address));
+    close(fd);
+}
+
+void np_activation_start(void)
+{
+    if (observer) return;
+    observer = [[NSDistributedNotificationCenter defaultCenter]
+        addObserverForName:request_name object:nil queue:[NSOperationQueue mainQueue]
+        usingBlock:^(NSNotification *note) {
+            NSDictionary *info = note.userInfo;
+            NSNumber *sender = info[@"sender"], *frontend = info[@"frontend"], *deadline = info[@"deadline"];
+            NSString *bundle = info[@"bundle"], *path = info[@"reply"];
+            if (![sender isKindOfClass:[NSNumber class]] || ![frontend isKindOfClass:[NSNumber class]] ||
+                ![deadline isKindOfClass:[NSNumber class]] || ![bundle isKindOfClass:[NSString class]] ||
+                ![path isKindOfClass:[NSString class]] || frontend.intValue != getpid()) return;
+            if (![bundle hasPrefix:game_prefix] ||
+                !valid_app_id([[bundle substringFromIndex:game_prefix.length] UTF8String])) return;
+            if (!steam_application([NSRunningApplication runningApplicationWithProcessIdentifier:sender.intValue])) return;
+            if (![path hasPrefix:@"/tmp/hadron-activation-"]) return;
+            struct stat status;
+            if (lstat(path.fileSystemRepresentation, &status) || !S_ISSOCK(status.st_mode) || status.st_uid != getuid()) return;
+            char granted = 0;
+            if (isfinite(deadline.doubleValue) && NSProcessInfo.processInfo.systemUptime < deadline.doubleValue && NSApp.active)
+            {
+                [NSApp yieldActivationToApplicationWithBundleIdentifier:bundle];
+                granted = 1;
+            }
+            reply(path, granted);
+        }];
+}
+
+void np_activation_prepare(const char *app_id)
+{
+    @autoreleasepool {
+        if (!valid_app_id(app_id)) return;
+        pid_t sender = steam_ancestor();
+        if (!sender) return;
+        NSRunningApplication *front = NSWorkspace.sharedWorkspace.frontmostApplication;
+        if (!steam_application(front)) return;
+        NSString *bundle = [game_prefix stringByAppendingString:[NSString stringWithUTF8String:app_id]];
+        if (front.processIdentifier == getpid() && [NSThread isMainThread])
+        {
+            if (NSApp.active) [NSApp yieldActivationToApplicationWithBundleIdentifier:bundle];
+            return;
+        }
+
+        // A Steam frontend owns the active window. Finish its handoff before Wine,
+        // since a detached Wine child cannot inherit the client's activation context.
+        char folder[] = "/tmp/hadron-activation-XXXXXX";
+        if (!mkdtemp(folder)) { NP_WARN("[activation] cannot create reply directory"); return; }
+        struct sockaddr_un address = {.sun_family = AF_UNIX};
+        snprintf(address.sun_path, sizeof(address.sun_path), "%s/reply", folder);
+        int fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+        if (fd == -1 || bind(fd, (struct sockaddr *)&address, sizeof(address)))
+        {
+            NP_WARN("[activation] cannot bind reply socket");
+            if (fd != -1) close(fd);
+            rmdir(folder);
+            return;
+        }
+        NSTimeInterval started = NSProcessInfo.processInfo.systemUptime;
+        NSTimeInterval deadline = started + 2;
+        NSDictionary *info = @{@"sender": @(sender), @"frontend": @(front.processIdentifier),
+                               @"bundle": bundle, @"reply": @(address.sun_path), @"deadline": @(deadline)};
+        [[NSDistributedNotificationCenter defaultCenter] postNotificationName:request_name
+            object:nil userInfo:info deliverImmediately:YES];
+        char granted = 0;
+        struct pollfd item = {.fd = fd, .events = POLLIN};
+        int waited;
+        do {
+            int remaining = (int)((deadline - NSProcessInfo.processInfo.systemUptime) * 1000);
+            waited = remaining > 0 ? poll(&item, 1, remaining) : 0;
+        } while (waited < 0 && errno == EINTR);
+        if (waited > 0 && (item.revents & POLLIN)) recv(fd, &granted, 1, 0);
+        close(fd);
+        unlink(address.sun_path);
+        rmdir(folder);
+    }
+}
+
+__attribute__((constructor))
+static void activation_init(void)
+{
+    const char *name = getprogname();
+    if (!name || (strcmp(name, "steam_osx") && strcmp(name, "Steam Helper"))) return;
+    np_log_init();
+    dispatch_async(dispatch_get_main_queue(), ^{ np_activation_start(); });
+}
diff --git a/dylib/tests/activation-detach.c b/dylib/tests/activation-detach.c
new file mode 100644
index 0000000..e9f1912
--- /dev/null
+++ b/dylib/tests/activation-detach.c
@@ -0,0 +1,27 @@
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+int main(int argc, char **argv)
+{
+    if (argc < 2) return 2;
+    pid_t child = fork();
+    if (child == -1) return 2;
+    if (!child)
+    {
+        pid_t grandchild = fork();
+        if (grandchild == -1) _exit(2);
+        if (!grandchild)
+        {
+            execv(argv[1], argv + 1);
+            _exit(2);
+        }
+        _exit(0);
+    }
+    int status;
+    while (waitpid(child, &status, 0) == -1)
+        if (errno != EINTR) return 2;
+    return WIFEXITED(status) ? WEXITSTATUS(status) : 2;
+}
diff --git a/dylib/tests/activation-probe.m b/dylib/tests/activation-probe.m
new file mode 100644
index 0000000..fdd81a7
--- /dev/null
+++ b/dylib/tests/activation-probe.m
@@ -0,0 +1,222 @@
+// Native helper/client/detached-child control; never operates on Steam or games.
+#import <AppKit/AppKit.h>
+#include <spawn.h>
+#include <errno.h>
+#include <sys/wait.h>
+#include <unistd.h>
+void np_activation_start(void);
+extern FILE *np_log_file;
+extern int np_log_level;
+
+@interface ProbeWindow : NSPanel
+@end
+@implementation ProbeWindow
+- (BOOL)canBecomeKeyWindow { return YES; }
+- (BOOL)canBecomeMainWindow { return YES; }
+@end
+
+@interface Probe : NSObject <NSApplicationDelegate, NSWindowDelegate>
+@property NSString *role;
+@property NSString *folder;
+@property NSString *handoff;
+@property double delay;
+@property BOOL switchAway;
+@property double helperStartDelay;
+@property double helperExitDelay;
+@property NSWindow *window;
+@property FILE *log;
+@end
+@implementation Probe
+- (void)record:(NSString *)phase
+{
+    NSRunningApplication *front = NSWorkspace.sharedWorkspace.frontmostApplication;
+    NSDictionary *row = @{@"phase": phase, @"role": self.role, @"pid": @(getpid()), @"ppid": @(getppid()),
+        @"uptime": @(NSProcessInfo.processInfo.systemUptime), @"active": @(NSApp.active),
+        @"key": @(self.window.keyWindow), @"visible": @(self.window.visible),
+        @"level": @(self.window.level), @"front_pid": @(front.processIdentifier),
+        @"front_bundle": front.bundleIdentifier ?: @""};
+    NSData *data = [NSJSONSerialization dataWithJSONObject:row options:NSJSONWritingSortedKeys error:NULL];
+    fwrite(data.bytes, 1, data.length, self.log); fputc('\n', self.log); fflush(self.log);
+}
+- (void)show
+{
+    [NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];
+    self.window = [[ProbeWindow alloc] initWithContentRect:NSMakeRect(100, 100, 480, 240)
+        styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable | NSWindowStyleMaskMiniaturizable
+        backing:NSBackingStoreBuffered defer:NO];
+    self.window.title = [@"Launch activation probe: " stringByAppendingString:self.role];
+    self.window.delegate = self;
+    [self.window orderFront:nil];
+    [self.window makeKeyWindow];
+    [self record:@"request-activation"];
+    [NSApp activate];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 200 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+        [self record:@"after-request"];
+    });
+}
+- (void)applicationDidFinishLaunching:(NSNotification *)note
+{
+    (void)note;
+    [self record:@"launched"];
+    if ([self.role isEqualToString:@"parent"])
+    {
+        [self show];
+        BOOL relay = [self.handoff hasPrefix:@"relay-"];
+        if (!relay) np_activation_start();
+        if (relay)
+        {
+            NSWorkspaceOpenConfiguration *config = [NSWorkspaceOpenConfiguration configuration];
+            NSString *role = [self.handoff containsString:@"absent"] ? @"relay-absent" :
+                [self.handoff containsString:@"slow"] ? @"relay-slow" : @"relay-helper";
+            config.arguments = @[role, self.folder, @(self.helperStartDelay).stringValue, @(self.helperExitDelay).stringValue];
+            config.createsNewApplicationInstance = YES;
+            config.activates = YES;
+            [self record:@"helper-opening"];
+            [NSWorkspace.sharedWorkspace openApplicationAtURL:
+                [NSURL fileURLWithPath:[self.folder stringByAppendingPathComponent:@"Helper.app"]]
+                configuration:config completionHandler:^(NSRunningApplication *app, NSError *error) {
+                    dispatch_async(dispatch_get_main_queue(), ^{
+                        [self record:(app && !error) ? @"helper-opened" : @"helper-open-failed"];
+                    });
+                }];
+        }
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)((.4 + self.helperStartDelay) * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+            [self record:@"before-spawn"];
+            void (^spawnGame)(void) = ^{
+                NSString *child = [self.folder stringByAppendingPathComponent:@"Child.app/Contents/MacOS/probe"];
+                NSString *delay = [NSString stringWithFormat:@"%.3f", self.delay];
+                pid_t pid;
+                int result;
+                NSString *home = [@"HOME=" stringByAppendingString:NSHomeDirectory()];
+                NSString *user = [@"USER=" stringByAppendingString:NSUserName()];
+                char *cleanEnv[] = {"PATH=/usr/bin:/bin:/usr/sbin:/sbin", "LANG=en_US.UTF-8",
+                    (char *)home.UTF8String, (char *)user.UTF8String, NULL};
+                {
+                    NSString *shim = [self.folder stringByAppendingPathComponent:@"detach"];
+                    char *detachedArgs[] = {(char *)shim.fileSystemRepresentation,
+                        (char *)child.fileSystemRepresentation, "child", (char *)self.folder.fileSystemRepresentation,
+                        (char *)delay.UTF8String, NULL};
+                    result = posix_spawn(&pid, shim.fileSystemRepresentation, NULL, NULL, detachedArgs, cleanEnv);
+                }
+                if (result) { [self record:@"spawn-failed"]; [NSApp terminate:nil]; return; }
+                [self record:@"after-spawn"];
+                if (self.switchAway)
+                {
+                    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 300 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                        NSWorkspaceOpenConfiguration *config = [NSWorkspaceOpenConfiguration configuration];
+                        config.arguments = @[@"helper", self.folder];
+                        config.createsNewApplicationInstance = YES;
+                        config.activates = YES;
+                        [self record:@"other-opening"];
+                        [NSWorkspace.sharedWorkspace openApplicationAtURL:
+                            [NSURL fileURLWithPath:[self.folder stringByAppendingPathComponent:relay ? @"Other.app" : @"Helper.app"]]
+                            configuration:config completionHandler:^(NSRunningApplication *app, NSError *error) {
+                                dispatch_async(dispatch_get_main_queue(), ^{
+                                    [self record:(app && !error) ? @"other-opened" : @"other-open-failed"];
+                                });
+                            }];
+                        [self record:@"switch-away"];
+                    });
+                }
+            };
+            if (![self.handoff isEqualToString:@"relay-none"])
+            {
+                [self record:@"before-handoff"];
+                // Use the shipped requester as steam-run does, across a shell
+                // ancestor; the requester never becomes a GUI application.
+                NSString *requester = [self.folder stringByAppendingPathComponent:@"activation-request"];
+                char *args[] = {"/bin/sh", "-c", "\"$1\" 4294967002; result=$?; exit \"$result\"", "sh",
+                                (char *)requester.fileSystemRepresentation, NULL};
+                pid_t request = 0;
+                extern char **environ;
+                int rc = posix_spawn(&request, "/bin/sh", NULL, NULL, args, environ);
+                // Steam's spawning call has returned by the time steam-run
+                // asks. Keep this parent's main queue available to receive it.
+                dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+                    int status = 0;
+                    pid_t waited = -1;
+                    if (!rc) do { waited = waitpid(request, &status, 0); } while (waited < 0 && errno == EINTR);
+                    BOOL failed = rc || waited != request || !WIFEXITED(status) || WEXITSTATUS(status);
+                    dispatch_async(dispatch_get_main_queue(), ^{
+                        if (failed) [self record:@"requester-failed"];
+                        [self record:@"after-handoff"];
+                        spawnGame();
+                    });
+                });
+            }
+            else spawnGame();
+        });
+    }
+    else if ([self.role isEqualToString:@"child"])
+    {
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(self.delay * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+            [self show];
+        });
+    }
+    else
+    {
+        if ([self.role isEqualToString:@"relay-helper"] || [self.role isEqualToString:@"relay-slow"])
+            np_activation_start();
+        [self show];
+        if ([self.role isEqualToString:@"relay-slow"])
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 200 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                [self record:@"slow-callback-begin"];
+                usleep(700000);
+                [self record:@"slow-callback-end"];
+            });
+    }
+    double lifetime = [self.role isEqualToString:@"child"] ? self.delay + 2 : self.delay + 7;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(lifetime * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        [self record:@"final"]; [NSApp terminate:nil];
+    });
+}
+- (NSApplicationTerminateReply)applicationShouldTerminate:(NSApplication *)sender
+{
+    (void)sender;
+    if ([self.role hasPrefix:@"relay-"] && self.helperExitDelay > 0)
+    {
+        [self record:@"exit-delay-begin"];
+        usleep((useconds_t)(self.helperExitDelay * 1000000));
+        [self record:@"exit-delay-end"];
+    }
+    return NSTerminateNow;
+}
+- (void)applicationDidBecomeActive:(NSNotification *)note { (void)note; [self record:@"did-activate"]; }
+- (void)applicationDidResignActive:(NSNotification *)note { (void)note; [self record:@"did-deactivate"]; }
+- (void)windowDidBecomeKey:(NSNotification *)note { (void)note; [self record:@"did-become-key"]; }
+- (void)windowDidResignKey:(NSNotification *)note { (void)note; [self record:@"did-resign-key"]; }
+@end
+
+int main(int argc, const char **argv)
+{
+    @autoreleasepool
+    {
+        if (argc < 3) return 2;
+        Probe *probe = [Probe new];
+        probe.role = @(argv[1]); probe.folder = @(argv[2]);
+        if ([probe.role isEqualToString:@"parent"])
+        {
+            if (argc < 6) return 2;
+            probe.handoff = @(argv[3]); probe.delay = atof(argv[4]); probe.switchAway = atoi(argv[5]);
+            probe.helperStartDelay = argc > 6 ? atof(argv[6]) : 0;
+            probe.helperExitDelay = argc > 7 ? atof(argv[7]) : 0;
+        }
+        else if ([probe.role isEqualToString:@"child"]) probe.delay = argc > 3 ? atof(argv[3]) : 0;
+        NSString *path = [probe.folder stringByAppendingPathComponent:[probe.role stringByAppendingString:@".jsonl"]];
+        probe.log = fopen(path.fileSystemRepresentation, "a");
+        if (!probe.log) return 2;
+        NSString *activationLog = [probe.folder stringByAppendingPathComponent:[probe.role stringByAppendingString:@".activation.log"]];
+        np_log_level = 3;
+        np_log_file = fopen(activationLog.fileSystemRepresentation, "a");
+        if ([probe.role hasPrefix:@"relay-"])
+        {
+            if (argc > 3) usleep((useconds_t)(atof(argv[3]) * 1000000));
+            probe.helperExitDelay = argc > 4 ? atof(argv[4]) : 0;
+        }
+        [NSApplication sharedApplication];
+        NSApp.delegate = probe;
+        [NSApp run];
+        fclose(probe.log);
+    }
+    return 0;
+}

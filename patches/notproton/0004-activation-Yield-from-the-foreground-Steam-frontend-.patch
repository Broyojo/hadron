diff --git a/dylib/tests/activation-detach.c b/dylib/tests/activation-detach.c
new file mode 100644
index 0000000..e9f1912
--- /dev/null
+++ b/dylib/tests/activation-detach.c
@@ -0,0 +1,27 @@
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+int main(int argc, char **argv)
+{
+    if (argc < 2) return 2;
+    pid_t child = fork();
+    if (child == -1) return 2;
+    if (!child)
+    {
+        pid_t grandchild = fork();
+        if (grandchild == -1) _exit(2);
+        if (!grandchild)
+        {
+            execv(argv[1], argv + 1);
+            _exit(2);
+        }
+        _exit(0);
+    }
+    int status;
+    while (waitpid(child, &status, 0) == -1)
+        if (errno != EINTR) return 2;
+    return WIFEXITED(status) ? WEXITSTATUS(status) : 2;
+}
diff --git a/dylib/tests/activation-probe.m b/dylib/tests/activation-probe.m
new file mode 100644
index 0000000..d9f3144
--- /dev/null
+++ b/dylib/tests/activation-probe.m
@@ -0,0 +1,170 @@
+// Native helper/client/detached-child control; never operates on Steam or games.
+#import <AppKit/AppKit.h>
+#include <spawn.h>
+#include <unistd.h>
+void np_activation_start(void);
+void np_activation_prepare(const char *app_id);
+extern FILE *np_log_file;
+extern int np_log_level;
+
+@interface ProbeWindow : NSPanel
+@end
+@implementation ProbeWindow
+- (BOOL)canBecomeKeyWindow { return YES; }
+- (BOOL)canBecomeMainWindow { return YES; }
+@end
+
+@interface Probe : NSObject <NSApplicationDelegate, NSWindowDelegate>
+@property NSString *role;
+@property NSString *folder;
+@property NSString *handoff;
+@property double delay;
+@property BOOL switchAway;
+@property NSWindow *window;
+@property FILE *log;
+@end
+@implementation Probe
+- (void)record:(NSString *)phase
+{
+    NSRunningApplication *front = NSWorkspace.sharedWorkspace.frontmostApplication;
+    NSDictionary *row = @{@"phase": phase, @"role": self.role, @"pid": @(getpid()), @"ppid": @(getppid()),
+        @"uptime": @(NSProcessInfo.processInfo.systemUptime), @"active": @(NSApp.active),
+        @"key": @(self.window.keyWindow), @"visible": @(self.window.visible),
+        @"level": @(self.window.level), @"front_pid": @(front.processIdentifier),
+        @"front_bundle": front.bundleIdentifier ?: @""};
+    NSData *data = [NSJSONSerialization dataWithJSONObject:row options:NSJSONWritingSortedKeys error:NULL];
+    fwrite(data.bytes, 1, data.length, self.log); fputc('\n', self.log); fflush(self.log);
+}
+- (void)show
+{
+    [NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];
+    self.window = [[ProbeWindow alloc] initWithContentRect:NSMakeRect(100, 100, 480, 240)
+        styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable | NSWindowStyleMaskMiniaturizable
+        backing:NSBackingStoreBuffered defer:NO];
+    self.window.title = [@"Launch activation probe: " stringByAppendingString:self.role];
+    self.window.delegate = self;
+    [self.window orderFront:nil];
+    [self.window makeKeyWindow];
+    [self record:@"request-activation"];
+    [NSApp activate];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 200 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+        [self record:@"after-request"];
+    });
+}
+- (void)applicationDidFinishLaunching:(NSNotification *)note
+{
+    (void)note;
+    [self record:@"launched"];
+    if ([self.role isEqualToString:@"parent"])
+    {
+        [self show];
+        BOOL relay = [self.handoff hasPrefix:@"relay-"];
+        if (relay)
+        {
+            NSWorkspaceOpenConfiguration *config = [NSWorkspaceOpenConfiguration configuration];
+            NSString *role = [self.handoff containsString:@"absent"] ? @"relay-absent" :
+                [self.handoff containsString:@"slow"] ? @"relay-slow" : @"relay-helper";
+            config.arguments = @[role, self.folder];
+            config.activates = YES;
+            [NSWorkspace.sharedWorkspace openApplicationAtURL:
+                [NSURL fileURLWithPath:[self.folder stringByAppendingPathComponent:@"Helper.app"]]
+                configuration:config completionHandler:^(NSRunningApplication *app, NSError *error) {
+                    (void)app; (void)error;
+                }];
+        }
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 400 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+            [self record:@"before-spawn"];
+            if (relay && ![self.handoff isEqualToString:@"relay-none"])
+            {
+                [self record:@"before-handoff"];
+                np_activation_prepare("4294967002");
+                [self record:@"after-handoff"];
+            }
+            NSString *child = [self.folder stringByAppendingPathComponent:@"Child.app/Contents/MacOS/probe"];
+            NSString *delay = [NSString stringWithFormat:@"%.3f", self.delay];
+            pid_t pid;
+            int result;
+            NSString *home = [@"HOME=" stringByAppendingString:NSHomeDirectory()];
+            NSString *user = [@"USER=" stringByAppendingString:NSUserName()];
+            char *cleanEnv[] = {"PATH=/usr/bin:/bin:/usr/sbin:/sbin", "LANG=en_US.UTF-8",
+                (char *)home.UTF8String, (char *)user.UTF8String, NULL};
+            {
+                NSString *shim = [self.folder stringByAppendingPathComponent:@"detach"];
+                char *detachedArgs[] = {(char *)shim.fileSystemRepresentation,
+                    (char *)child.fileSystemRepresentation, "child", (char *)self.folder.fileSystemRepresentation,
+                    (char *)delay.UTF8String, NULL};
+                result = posix_spawn(&pid, shim.fileSystemRepresentation, NULL, NULL, detachedArgs, cleanEnv);
+            }
+            if (result) { [self record:@"spawn-failed"]; [NSApp terminate:nil]; return; }
+            [self record:@"after-spawn"];
+            if (self.switchAway)
+            {
+                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 300 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                    NSWorkspaceOpenConfiguration *config = [NSWorkspaceOpenConfiguration configuration];
+                    config.arguments = @[@"helper", self.folder];
+                    config.activates = YES;
+                    [NSWorkspace.sharedWorkspace openApplicationAtURL:
+                        [NSURL fileURLWithPath:[self.folder stringByAppendingPathComponent:relay ? @"Other.app" : @"Helper.app"]]
+                        configuration:config completionHandler:^(NSRunningApplication *app, NSError *error) {
+                            (void)app; (void)error;
+                        }];
+                    [self record:@"switch-away"];
+                });
+            }
+        });
+    }
+    else if ([self.role isEqualToString:@"child"])
+    {
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(self.delay * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+            [self show];
+        });
+    }
+    else
+    {
+        if ([self.role isEqualToString:@"relay-helper"] || [self.role isEqualToString:@"relay-slow"])
+            np_activation_start();
+        [self show];
+        if ([self.role isEqualToString:@"relay-slow"])
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 200 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                [self record:@"slow-callback-begin"];
+                usleep(700000);
+                [self record:@"slow-callback-end"];
+            });
+    }
+    double lifetime = [self.role isEqualToString:@"child"] ? self.delay + 2 : self.delay + 7;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(lifetime * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        [self record:@"final"]; [NSApp terminate:nil];
+    });
+}
+- (void)applicationDidBecomeActive:(NSNotification *)note { (void)note; [self record:@"did-activate"]; }
+- (void)applicationDidResignActive:(NSNotification *)note { (void)note; [self record:@"did-deactivate"]; }
+- (void)windowDidBecomeKey:(NSNotification *)note { (void)note; [self record:@"did-become-key"]; }
+- (void)windowDidResignKey:(NSNotification *)note { (void)note; [self record:@"did-resign-key"]; }
+@end
+
+int main(int argc, const char **argv)
+{
+    @autoreleasepool
+    {
+        if (argc < 3) return 2;
+        Probe *probe = [Probe new];
+        probe.role = @(argv[1]); probe.folder = @(argv[2]);
+        if ([probe.role isEqualToString:@"parent"])
+        {
+            if (argc < 6) return 2;
+            probe.handoff = @(argv[3]); probe.delay = atof(argv[4]); probe.switchAway = atoi(argv[5]);
+        }
+        else if ([probe.role isEqualToString:@"child"]) probe.delay = argc > 3 ? atof(argv[3]) : 0;
+        NSString *path = [probe.folder stringByAppendingPathComponent:[probe.role stringByAppendingString:@".jsonl"]];
+        probe.log = fopen(path.fileSystemRepresentation, "a");
+        if (!probe.log) return 2;
+        NSString *activationLog = [probe.folder stringByAppendingPathComponent:[probe.role stringByAppendingString:@".activation.log"]];
+        np_log_level = 3;
+        np_log_file = fopen(activationLog.fileSystemRepresentation, "a");
+        [NSApplication sharedApplication];
+        NSApp.delegate = probe;
+        [NSApp run];
+        fclose(probe.log);
+    }
+    return 0;
+}
diff --git a/dylib/tests/activation-relay.py b/dylib/tests/activation-relay.py
new file mode 100644
index 0000000..bf51771
--- /dev/null
+++ b/dylib/tests/activation-relay.py
@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""Interactive native activation controls; uses private apps, never Steam or games."""
+from pathlib import Path
+import hashlib
+import json
+import plistlib
+import shutil
+import subprocess
+import tempfile
+import time
+
+root = Path(__file__).resolve().parents[2]
+tests = root / 'dylib/tests'
+out = Path(tempfile.mkdtemp(prefix='activation-', dir=root / 'out'))
+print('Results:', out, flush=True)
+
+def run(args, **options):
+    return subprocess.run([str(a) for a in args], check=True, timeout=30, **options)
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+# Only test application identities differ. The handoff/acknowledgement code is
+# compiled unchanged, with the production memory-management flags (no ARC).
+source = root / 'dylib/feats/activation.m'
+text = source.read_text()
+identities = {'com.valvesoftware.steam': 'com.hadron.activation-test.parent',
+              'com.valvesoftware.steam.helper': 'com.hadron.activation-test.helper'}
+for original, replacement in identities.items():
+    if text.count('@"' + original + '"') != 1:
+        raise RuntimeError('Unexpected production frontend identity definition')
+    text = text.replace('@"' + original + '"', '@"' + replacement + '"')
+candidate = out / 'activation.m'
+candidate.write_text(text)
+activation = out / 'activation.o'
+run(['xcrun', 'clang', '-O2', '-Wall', '-Wextra', '-Werror',
+     '-I', root / 'dylib/feats', '-c', candidate, '-o', activation])
+probe = out / 'probe'
+run(['xcrun', 'clang', '-fobjc-arc', '-O2', '-Wall', '-Wextra', '-Werror',
+     '-framework', 'AppKit', tests / 'activation-probe.m', activation,
+     root / 'dylib/util/log.c', root / 'dylib/util/file.c', '-o', probe])
+detach = out / 'detach'
+run(['xcrun', 'clang', '-O2', '-Wall', '-Wextra', '-Werror',
+     tests / 'activation-detach.c', '-o', detach])
+run(['codesign', '-f', '-s', '-', probe])
+
+bundles = {'Parent': 'com.hadron.activation-test.parent',
+           'Helper': 'com.hadron.activation-test.helper',
+           'Other': 'com.hadron.activation-test.other',
+           'Child': 'com.broyojo.hadron.game.4294967002'}
+cases = [('relay-none', 0, False, False),
+         ('relay-ready', 0, False, True),
+         ('relay-ready', 1.2, False, True),
+         ('relay-slow', 0, False, True),
+         ('relay-absent', 0, False, False),
+         ('relay-ready', 1.2, True, False)]
+results = []
+receipt = {'source_sha256': sha(source), 'compiled_source_sha256': sha(candidate),
+           'probe_sha256': sha(probe), 'detach_sha256': sha(detach),
+           'identity_substitutions': identities,
+           'macos': run(['sw_vers'], capture_output=True, text=True).stdout}
+(out / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
+
+for mode, delay, switch, expected in cases:
+    listing = run(['ps', '-axo', 'comm='], capture_output=True, text=True).stdout
+    if any(row.strip().lower().endswith('.exe') or Path(row.strip()).name.lower()
+           in ('wine', 'wine64', 'wineserver') for row in listing.splitlines()):
+        raise RuntimeError('Existing Wine session; postpone interactive controls')
+    case = out / f'{mode}-{delay}-{int(switch)}'
+    case.mkdir()
+    for role, bundle in bundles.items():
+        contents = case / (role + '.app') / 'Contents'
+        (contents / 'MacOS').mkdir(parents=True)
+        shutil.copy2(probe, contents / 'MacOS/probe')
+        info = {'CFBundleExecutable': 'probe', 'CFBundleIdentifier': bundle,
+                'CFBundleName': role, 'CFBundlePackageType': 'APPL'}
+        if role == 'Child':
+            info['LSUIElement'] = True
+        (contents / 'Info.plist').write_bytes(plistlib.dumps(info))
+    shutil.copy2(detach, case / 'detach')
+    run(['open', '-n', '-W', '-a', case / 'Parent.app', '--args', 'parent', case,
+         mode, delay, int(switch)])
+    time.sleep(.3)
+    def rows(role):
+        return [json.loads(line) for line in (case / (role + '.jsonl')).read_text().splitlines()]
+    parent, child = rows('parent'), rows('child')
+    before = next(r for r in parent if r['phase'] == 'before-spawn')
+    after = next(r for r in child if r['phase'] == 'after-request')
+    helper_role = 'relay-absent' if mode == 'relay-absent' else 'relay-slow' if mode == 'relay-slow' else 'relay-helper'
+    helper = rows(helper_role)
+    allowed = set(bundles.values())
+    qualified = (before['front_bundle'] == bundles['Helper'] and
+                 child[0]['ppid'] == 1 and
+                 all(r['front_bundle'] in allowed for r in parent + helper
+                     if r['phase'] == 'did-deactivate'))
+    if switch:
+        qualified = qualified and after['front_bundle'] == bundles['Other']
+    handoff = None
+    if mode != 'relay-none':
+        begin = next(r for r in parent if r['phase'] == 'before-handoff')
+        end = next(r for r in parent if r['phase'] == 'after-handoff')
+        handoff = (end['uptime'] - begin['uptime']) * 1000
+    timing_ok = True
+    if mode == 'relay-slow':
+        slow_begin = next(r for r in helper if r['phase'] == 'slow-callback-begin')
+        slow_end = next(r for r in helper if r['phase'] == 'slow-callback-end')
+        timing_ok = slow_begin['uptime'] <= begin['uptime'] < slow_end['uptime'] <= end['uptime']
+    if mode == 'relay-absent':
+        timing_ok = 1900 <= handoff <= 2600
+    passed = qualified and timing_ok and after['active'] == expected and after['key'] == expected
+    result = {'mode': mode, 'delay': delay, 'switch': switch,
+              'expected_activation': expected, 'before': before, 'after': after,
+              'handoff_ms': handoff, 'qualified': qualified,
+              'timing_ok': timing_ok, 'result': 'PASS' if passed else 'FAIL'}
+    results.append(result)
+    (out / 'results.json').write_text(json.dumps(results, indent=2) + '\n')
+    print(json.dumps(result), flush=True)
+    if not passed:
+        raise RuntimeError('Activation mismatch or unqualified desktop; inspect logs')
+print('PASS: six activation controls; this does not establish game acceptance.')

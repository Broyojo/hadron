From: NotProtonNot <332734261+NotProtonNot@users.noreply.github.com>
Date: Sun, 11 Oct 2026 18:51:13 -0400
Subject: [PATCH] Implement SteamNetworkingSocketsSerialized005, fixing a crash
 with the game Deadlock

(cherry picked from commit 79d5dd4fd2b10bffca64a20101220859dceb7edb)
---
 lsteamclient/fetch.sh                         |   7 +
 lsteamclient/serialized005.patch              | 754 ++++++++++++++++++
 .../isteamnetworkingsocketsserialized.h       |  27 +
 3 files changed, 788 insertions(+)
 create mode 100644 lsteamclient/serialized005.patch
 create mode 100644 lsteamclient/steamworks_sdk_165x/isteamnetworkingsocketsserialized.h

diff --git a/lsteamclient/fetch.sh b/lsteamclient/fetch.sh
index b69cf72..d13407e 100755
--- a/lsteamclient/fetch.sh
+++ b/lsteamclient/fetch.sh
@@ -92,4 +92,11 @@ echo "$authored" | while IFS= read -r f; do
 	cp -f "$here/$f" "$TREE/$f"
 done
 
+mkdir "$TREE/steamworks_sdk_165x"
+for f in steamtypes.h steamclientpublic.h steamnetworkingtypes.h steamuniverse.h; do
+	cp "$TREE/steamworks_sdk_165/$f" "$TREE/steamworks_sdk_165x/"
+done
+cp "$here/steamworks_sdk_165x/isteamnetworkingsocketsserialized.h" "$TREE/steamworks_sdk_165x/"
+patch -p1 -d "$TREE" --forward -s < "$here/serialized005.patch"
+
 echo "==> assembled $TREE with $(echo "$authored" | LC_ALL=C grep -c .) authored files over it"

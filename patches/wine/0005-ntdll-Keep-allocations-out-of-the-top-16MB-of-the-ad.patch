From f8e80e66cde6616da1718e9cc99f4263c6e19e73 Mon Sep 17 00:00:00 2001
From: Broyojo <dha@xoba.com>
Date: Tue, 29 Sep 2026 15:09:02 -0400
Subject: [PATCH] ntdll: Keep allocations out of the top 16MB of the address
 space on macOS.

XNU's copyinstr() validates the full maximum string length, so execve()
fails with EFAULT when argument or environment strings are close to the
top of the address space. exec_wineloader() passes environment strings
from the stack, and a thread stack can be placed there: a top-down
allocation that does not fit Wine's top-down range goes to the highest
free address below the host's limit, and creating child processes then
fails. Report the host's limit 16MB below the top.
---
 dlls/ntdll/unix/virtual.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 1599a1754f7..1d4e01c3d2a 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -2519,8 +2519,10 @@ static NTSTATUS map_pe_header( void *ptr, size_t size, size_t map_size, int fd,
 static void *get_host_addr_space_limit(void)
 {
 #ifdef __APPLE__
-    /* See MACH_VM_MAX_ADDRESS_RAW in xnu osfmk/mach/arm/vm_param.h */
-    return (void *)0x7ffffe000000;
+    /* See MACH_VM_MAX_ADDRESS_RAW in xnu osfmk/mach/arm/vm_param.h. Stay 16MB below it:
+     * copyinstr() validates the full maximum length, so exec fails with EFAULT when
+     * argument or environment strings (e.g. on a thread stack) are near the top. */
+    return (void *)(0x7ffffe000000 - 0x1000000);
 #elif defined _WIN64
     UINT_PTR addr = (UINT_PTR)1 << 63;
 

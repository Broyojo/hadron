From ebffbba06c7167fe56d409de025de51732a06082 Mon Sep 17 00:00:00 2001
From: Broyojo <dha@xoba.com>
Date: Fri, 16 Oct 2026 16:45:40 -0400
Subject: [PATCH] ntdll: Clear writable partial host pages in place.

A host page that is already writable needs no alias: zero the decommitted
guest pages directly. Call mprotect afterwards only when the host page's
protection changes, which also leaves a MAP_JIT page's backing in place
under a neighbour that may be running. Invalidate the instruction cache
only for executable host pages.

A partial host page with no other committed guest page is replaced whole
instead, like a whole-view decommit, also when the whole view is
decommitted with an explicit size and at the end of a view shorter than
its host page: writing zeros would fault in backing that decommit should
release.
---
 dlls/ntdll/unix/virtual.c | 68 +++++++++++++++++++++++++++++++--------
 1 file changed, 55 insertions(+), 13 deletions(-)

diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index e7b091da3d..ee940fd067 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -2686,25 +2686,35 @@ static SIZE_T get_committed_size( struct file_view *view, void *base, size_t max
 
 
 #ifdef __APPLE__
-/* Clear partial host pages without changing permissions on committed neighbours. */
-static NTSTATUS zero_partial_host_pages( struct file_view *view, char *base, size_t size )
+/* Whether a guest page of the host page at host_base, outside [start, end), is committed. */
+static BOOL host_page_committed_outside( const char *host_base, const char *start, const char *end )
+{
+    const char *page;
+
+    for (page = host_base; page < host_base + host_page_size; page += page_size)
+        if ((page < start || page >= end) && (get_page_vprot( page ) & VPROT_COMMITTED)) return TRUE;
+    return FALSE;
+}
+
+/* Clear the guest pages of [base, end) outside [host_start, host_end) without changing
+ * permissions on committed neighbours. */
+static NTSTATUS zero_partial_host_pages( struct file_view *view, char *base, char *end,
+                                         char *host_start, char *host_end )
 {
     struct
     {
         char *base;
         size_t size;
         mach_vm_address_t alias;
+        int prot;
         BOOL jit;
     } partial[2] = {{0}};
-    char *end = base + size;
-    char *host_start = (char *)ROUND_SIZE( 0, base, host_page_mask );
-    char *host_end = ROUND_ADDR( end, host_page_mask );
     vm_prot_t cur_prot, max_prot;
     kern_return_t ret = KERN_SUCCESS;
     unsigned int i;
 
     partial[0].base = base;
-    partial[0].size = min( host_start, end ) - base;
+    if (base < host_start) partial[0].size = min( host_start, end ) - base;
     partial[1].base = host_end;
     if (host_end >= host_start && host_end < end) partial[1].size = end - host_end;
 
@@ -2717,6 +2727,9 @@ static NTSTATUS zero_partial_host_pages( struct file_view *view, char *base, siz
         partial[i].jit = is_jit_view( view ) && (get_host_page_vprot( host_base ) & VPROT_EXECMODE);
         if (partial[i].jit) continue;
 #endif
+        /* A host page that is already writable is cleared in place, with no alias. */
+        partial[i].prot = get_unix_prot( get_host_page_vprot( host_base ) );
+        if (partial[i].prot & PROT_WRITE) continue;
         ret = mach_vm_remap( mach_task_self(), &partial[i].alias, host_page_size, 0, VM_FLAGS_ANYWHERE,
                              mach_task_self(), (mach_vm_address_t)host_base, FALSE,
                              &cur_prot, &max_prot, VM_INHERIT_NONE );
@@ -2740,9 +2753,14 @@ static NTSTATUS zero_partial_host_pages( struct file_view *view, char *base, siz
             continue;
         }
 #endif
+        if (!partial[i].alias)
+        {
+            memset( partial[i].base, 0, partial[i].size );
+            continue;
+        }
         memset( (char *)partial[i].alias + (partial[i].base - host_base), 0, partial[i].size );
         /* The original VA may retain executable instructions after an alias write. */
-        sys_icache_invalidate( partial[i].base, partial[i].size );
+        if (partial[i].prot & PROT_EXEC) sys_icache_invalidate( partial[i].base, partial[i].size );
     }
     for (i = 0; i < 2; i++)
         if (partial[i].alias) mach_vm_deallocate( mach_task_self(), partial[i].alias, host_page_size );
@@ -2761,10 +2779,11 @@ static NTSTATUS decommit_pages( struct file_view *view, char *base, size_t size
     char *host_end, *end;
 #ifdef __APPLE__
     char *partial_end;
+    int head_prot, tail_prot;
 #endif
     char *host_start = (char *)ROUND_SIZE( 0, base, host_page_mask );
 
-    if (!size)
+    if (!size || (base == (char *)view->base && size == view->size))
     {
         size = view->size;
         /* A whole view has no committed neighbour in its final host page. */
@@ -2772,11 +2791,25 @@ static NTSTATUS decommit_pages( struct file_view *view, char *base, size_t size
     }
     else
     {
+        host_end = ROUND_ADDR( base + size, host_page_mask );
 #ifdef __APPLE__
-        NTSTATUS status = zero_partial_host_pages( view, base, size );
-        if (status) return status;
+        {
+            char *head = ROUND_ADDR( base, host_page_mask );
+            NTSTATUS status;
+
+            /* A partial host page with no other committed guest page is replaced whole: that
+             * zeroes it and releases its backing, which writing zeros would instead fault in.
+             * As for a whole view, the part of the host page past a short view is free. */
+            if (head < host_start && head >= (char *)view->base &&
+                !host_page_committed_outside( head, base, base + size ))
+                host_start = head;
+            if (host_end < base + size && host_end >= (char *)view->base &&
+                !host_page_committed_outside( host_end, base, base + size ))
+                host_end += host_page_size;
+            if ((status = zero_partial_host_pages( view, base, base + size, host_start, host_end )))
+                return status;
+        }
 #endif
-        host_end = ROUND_ADDR( base + size, host_page_mask );
     }
     end = base + size;
 #ifdef __APPLE__
@@ -2790,13 +2823,22 @@ static NTSTATUS decommit_pages( struct file_view *view, char *base, size_t size
         /* the replaced host pages are no longer MAP_JIT-backed */
         if (host_start < host_end) set_page_vprot_bits( host_start, host_end - host_start, 0, VPROT_EXECMODE );
     }
+#endif
+#ifdef __APPLE__
+    head_prot = get_unix_prot( get_host_page_vprot( base ) );
+    tail_prot = get_unix_prot( get_host_page_vprot( host_end ) );
 #endif
     set_page_vprot_bits( base, size, 0, VPROT_COMMITTED );
 
 #ifdef __APPLE__
-    if (base < partial_end && mprotect_range( base, partial_end - base, 0, 0 ))
+    /* Committed neighbours usually keep a partial host page's protection unchanged; leaving it
+     * alone also keeps a MAP_JIT page's backing in place under a neighbour that may be running. */
+    if (base < partial_end && get_unix_prot( get_host_page_vprot( base ) ) != head_prot &&
+        mprotect_range( base, partial_end - base, 0, 0 ))
         return STATUS_ACCESS_DENIED;
-    if (host_end >= host_start && host_end < end && mprotect_range( host_end, end - host_end, 0, 0 ))
+    if (host_end >= host_start && host_end < end &&
+        get_unix_prot( get_host_page_vprot( host_end ) ) != tail_prot &&
+        mprotect_range( host_end, end - host_end, 0, 0 ))
         return STATUS_ACCESS_DENIED;
 
 #endif
-- 

From 4c3f262628f29645a6a689d046ba9e815cdbd891 Mon Sep 17 00:00:00 2001
From: Broyojo <dha@xoba.com>
Date: Thu, 15 Oct 2026 13:53:11 -0400
Subject: [PATCH 30/33] winemac.drv: Change the display mode of any display,
 not only the main one.

macdrv_ChangeDisplaySettings skipped every display but the main one with
a FIXME and still returned DISP_CHANGE_SUCCESSFUL. A game that set a
mode on a second monitor was told the mode was in effect, sized its
window to it, and the monitor stayed in its old mode, so only a part of
the game was on screen.

Find the display a \\.\DISPLAY<n> name stands for in the order the
sources were added, and set the mode on it. The Cocoa side already keeps
the original and pending modes per display.
---
 dlls/winemac.drv/display.c | 64 ++++++++++++++++++++++++++++----------
 1 file changed, 47 insertions(+), 17 deletions(-)

diff --git a/dlls/winemac.drv/display.c b/dlls/winemac.drv/display.c
index 68408ee848..c0016a13bb 100644
--- a/dlls/winemac.drv/display.c
+++ b/dlls/winemac.drv/display.c
@@ -738,6 +738,33 @@ static CGDisplayModeRef find_best_display_mode(DEVMODEW *devmode, CFArrayRef dis
  *              ChangeDisplaySettings  (MACDRV.@)
  *
  */
+/* The display a \\.\DISPLAY<n> name stands for: win32u numbers the sources in the order
+ * macdrv_UpdateDisplayDevices adds them, the adapters of each GPU in turn. */
+static CGDirectDisplayID display_id_from_device_name(const WCHAR *name)
+{
+    static const WCHAR prefixW[] = {'\\','\\','.','\\','D','I','S','P','L','A','Y'};
+    CGDirectDisplayID display_id = kCGNullDirectDisplay;
+    struct macdrv_adapter *adapters;
+    struct macdrv_gpu *gpus;
+    int gpu_count, adapter_count, i, j, index = 0;
+    WCHAR *end;
+
+    if (wcsnicmp(name, prefixW, ARRAY_SIZE(prefixW))) return kCGNullDirectDisplay;
+    index = wcstol(name + ARRAY_SIZE(prefixW), &end, 10) - 1;
+    if (*end || index < 0) return kCGNullDirectDisplay;
+
+    if (macdrv_get_gpus(&gpus, &gpu_count)) return kCGNullDirectDisplay;
+    for (i = 0; i < gpu_count && !display_id; i++)
+    {
+        if (macdrv_get_adapters(gpus[i].id, &adapters, &adapter_count)) break;
+        for (j = 0; j < adapter_count && !display_id; j++)
+            if (index-- == 0) display_id = adapters[j].id;
+        macdrv_free_adapters(adapters);
+    }
+    macdrv_free_gpus(gpus);
+    return display_id;
+}
+
 LONG macdrv_ChangeDisplaySettings(LPDEVMODEW displays, LPCWSTR primary_name, HWND hwnd, DWORD flags, LPVOID lpvoid)
 {
     LONG ret = DISP_CHANGE_SUCCESSFUL;
@@ -746,57 +773,60 @@ LONG macdrv_ChangeDisplaySettings(LPDEVMODEW displays, LPCWSTR primary_name, HWN
     CFArrayRef display_modes;
     struct display_mode_descriptor *desc;
     CGDisplayModeRef best_display_mode;
+    CGDirectDisplayID display_id;
 
     TRACE("%p %s %p 0x%08x %p\n", displays, debugstr_w(primary_name), hwnd, flags, lpvoid);
 
     init_original_display_mode();
 
-    /* TODO: support displays other than the main one */
-    display_modes = copy_display_modes(CGMainDisplayID(), FALSE);
-    if (!display_modes)
-        return DISP_CHANGE_FAILED;
-
     bpp = get_default_bpp();
 
-    desc = create_original_display_mode_descriptor(CGMainDisplayID());
-
     for (mode = displays; mode->dmSize && !ret; mode = NEXT_DEVMODEW(mode))
     {
-        if (wcsicmp(primary_name, mode->dmDeviceName))
-        {
-            FIXME("Changing non-primary adapter settings is currently unsupported.\n");
-            continue;
-        }
         if (is_detached_mode(mode))
         {
             FIXME("Detaching adapters is currently unsupported.\n");
             continue;
         }
+        if (!(display_id = display_id_from_device_name(mode->dmDeviceName)))
+        {
+            ERR("No display for %s\n", debugstr_w(mode->dmDeviceName));
+            ret = DISP_CHANGE_FAILED;
+            break;
+        }
 
         if (mode->dmBitsPerPel != bpp)
             TRACE("using default %d bpp instead of caller's request %d bpp\n", bpp, mode->dmBitsPerPel);
 
-        TRACE("looking for %dx%dx%dbpp @%d Hz", mode->dmPelsWidth, mode->dmPelsHeight,
-              bpp, mode->dmDisplayFrequency);
+        TRACE("%s (display %#x): looking for %dx%dx%dbpp @%d Hz", debugstr_w(mode->dmDeviceName), display_id,
+              mode->dmPelsWidth, mode->dmPelsHeight, bpp, mode->dmDisplayFrequency);
         TRACE(" %sstretched", mode->dmDisplayFixedOutput == DMDFO_STRETCH ? "" : "un");
         TRACE(" %sinterlaced", mode->dmDisplayFlags & DM_INTERLACED ? "" : "non-");
         TRACE("\n");
 
+        if (!(display_modes = copy_display_modes(display_id, FALSE)))
+        {
+            ret = DISP_CHANGE_FAILED;
+            break;
+        }
+        desc = create_original_display_mode_descriptor(display_id);
+
         if (!(best_display_mode = find_best_display_mode(mode, display_modes, bpp, desc)))
         {
             ERR("No matching mode found %ux%ux%d @%u!\n", mode->dmPelsWidth, mode->dmPelsHeight,
                 bpp, mode->dmDisplayFrequency);
             ret = DISP_CHANGE_BADMODE;
         }
-        else if (!macdrv_set_display_mode(CGMainDisplayID(), best_display_mode))
+        else if (!macdrv_set_display_mode(display_id, best_display_mode))
         {
             WARN("Failed to set display mode\n");
             ret = DISP_CHANGE_FAILED;
         }
+
+        free_display_mode_descriptor(desc);
+        CFRelease(display_modes);
     }
 
-    free_display_mode_descriptor(desc);
-    CFRelease(display_modes);
     macdrv_reset_device_metrics();
 
     return ret;

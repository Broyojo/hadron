From 8038f000457fd7c16880ac772c457adaabb499dc Mon Sep 17 00:00:00 2001
From: Broyojo <dha@xoba.com>
Date: Mon, 16 Nov 2026 19:42:00 -0500
Subject: [PATCH] win32u: Map a present rect's edges as the window's for its
 client surfaces.

With a present rect, the driver gets the window mapped to the monitor
edge by edge, and win32u placed its client surfaces by scaling the rect's
size and adding the mapped origin. Under an emulated display mode of
another shape than the screen's, the two round differently: for 1024x768
on a 3024x1964 panel the window is 2618 pixels wide and the surface 2619,
and on the same panel at 1512x982 points the surface came out a point
narrower than the window, so the window's own surface showed in a strip
beside the picture of a letterboxed game.

Map the present rect's edges the way the window's are.
---
 dlls/win32u/window.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index 8ddc40fb17..b0dc8096bc 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -342,8 +342,16 @@ static RECT get_client_surface_rects( HWND toplevel, HWND hwnd, RECT *monitor_re
     get_window_rects( toplevel, COORDS_PARENT, &rects, dpi );
     monitor_rects = map_window_rects_virt_to_raw( rects, dpi );
 
-    if (get_present_rect( hwnd, &rect, dpi )) OffsetRect( &rect, -rects.client.left, -rects.client.top );
-    else if (get_client_rect( hwnd, &rect, dpi )) map_window_points( hwnd, toplevel, (POINT *)&rect, 2, dpi );
+    if (get_present_rect( hwnd, &rect, dpi ))
+    {
+        /* map the present rect's edges as the window's, which the driver gets: scaling its size
+         * instead can round it a pixel off the window's mapped edges, past them or short of them */
+        *monitor_rect = map_rect_virt_to_raw( rect, dpi );
+        OffsetRect( monitor_rect, -monitor_rects.visible.left, -monitor_rects.visible.top );
+        OffsetRect( &rect, -rects.visible.left, -rects.visible.top );
+        return rect;
+    }
+    if (get_client_rect( hwnd, &rect, dpi )) map_window_points( hwnd, toplevel, (POINT *)&rect, 2, dpi );
 
     get_win_monitor_dpi( hwnd, &raw_dpi );
     *monitor_rect = map_dpi_rect( rect, dpi, raw_dpi );

From 99183ef839d69bc3652fe89d0823e947d9e37088 Mon Sep 17 00:00:00 2001
From: Ondrej Simon <ondrej@dorhawk.software>
Date: Sun, 15 Nov 2026 09:45:51 +0100
Subject: [PATCH 51/51] winemac.drv: A region that covers the whole window
 isn't a shape.

Ribbon libraries give a window that isn't maximized a window region:
one rectangle a pixel larger than the window, set again on every size
change. It leaves the window's outline as it is, but the driver counted
any region as a shape and doesn't let macOS resize a shaped window, so
window tools that resize through the Accessibility API, such as
Rectangle, couldn't resize the window (Enterprise Architect, restored).

Let a window that draws its own frame stay resizable when its region
covers the whole window.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/winemac.drv/window.c | 25 ++++++++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
index ff03d5cb4b..fabe7037bc 100644
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -78,6 +78,27 @@ static struct macdrv_window_features get_window_features_for_style(DWORD style,
     return wf;
 }
 
+/***********************************************************************
+ *              region_covers_window
+ *
+ * Whether the window's region is one rectangle that covers the whole window. Ribbon libraries set
+ * such a region: it doesn't change the window's outline, so it isn't a shape.
+ */
+static BOOL region_covers_window(HWND hwnd, const RECT *window)
+{
+    HRGN region = NtGdiCreateRectRgn(0, 0, 0, 0);
+    RECT box;
+    BOOL ret = FALSE;
+
+    if (!region) return FALSE;
+    if (NtUserGetWindowRgnEx(hwnd, region, 0) != ERROR && NtGdiGetRgnBox(region, &box) == SIMPLEREGION)
+        ret = box.left <= 0 && box.top <= 0 && box.right >= window->right - window->left &&
+              box.bottom >= window->bottom - window->top;
+    NtGdiDeleteObjectApp(region);
+    return ret;
+}
+
+
 /***********************************************************************
  *              get_cocoa_window_features
  */
@@ -90,7 +111,9 @@ static struct macdrv_window_features get_cocoa_window_features(struct macdrv_win
     {
         /* The app draws its own frame, but a sizing border still lets the user resize the
          * window: let macOS and its window tools resize it too. */
-        if ((style & WS_THICKFRAME) && !data->shaped) wf.resizable = TRUE;
+        if ((style & WS_THICKFRAME) &&
+            (!data->shaped || region_covers_window(data->hwnd, &data->rects.window)))
+            wf.resizable = TRUE;
         return wf;
     }
 

From 30f30373350b75e2c814c4bdfa5fe1261c9c0644 Mon Sep 17 00:00:00 2001
From: Broyojo <dha@xoba.com>
Date: Fri, 2 Oct 2026 14:07:06 -0400
Subject: [PATCH] winemac.drv: Add an OpenGL driver on EGL.

The system's OpenGL stops at 4.1, has no compatibility profile above 2.1
and is deprecated. With WINE_MAC_OPENGL=egl the Mac driver uses win32u's
EGL contexts instead and creates window surfaces on the CAMetalLayer of
the window's Metal view, the one Vulkan surfaces use. That is what an EGL
on top of a Vulkan driver for Metal presents to, such as Mesa's Zink.
---
 dlls/winemac.drv/Makefile.in |   1 +
 dlls/winemac.drv/egl.c       | 130 +++++++++++++++++++++++++++++++++++
 dlls/winemac.drv/macdrv.h    |   2 +
 dlls/winemac.drv/opengl.c    |   1 +
 4 files changed, 134 insertions(+)
 create mode 100644 dlls/winemac.drv/egl.c

diff --git a/dlls/winemac.drv/Makefile.in b/dlls/winemac.drv/Makefile.in
index 943a9b5f7b..065de38c1d 100644
--- a/dlls/winemac.drv/Makefile.in
+++ b/dlls/winemac.drv/Makefile.in
@@ -28,6 +28,7 @@ SOURCES = \
 	cocoa_window.m \
 	display.c \
 	dllmain.c \
+	egl.c \
 	event.c \
 	gdi.c \
 	image.c \
diff --git a/dlls/winemac.drv/egl.c b/dlls/winemac.drv/egl.c
new file mode 100644
index 0000000000..d9d63121a2
--- /dev/null
+++ b/dlls/winemac.drv/egl.c
@@ -0,0 +1,130 @@
+/*
+ * Mac driver OpenGL support through EGL
+ *
+ * Copyright 2026 David Andrews
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *

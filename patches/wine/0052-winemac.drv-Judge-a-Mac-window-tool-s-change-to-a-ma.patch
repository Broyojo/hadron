From 6a63800d6cd0978125ce9ca0c66e75401d0de76d Mon Sep 17 00:00:00 2001
From: Ondrej Simon <ondrej@dorhawk.software>
Date: Sun, 15 Nov 2026 09:45:51 +0100
Subject: [PATCH] winemac.drv: Judge a Mac window tool's change to a maximized
 window.

Window tools such as Rectangle change a window's frame through the
Accessibility API, in steps: the size, the position, then the size
again. For a maximized window the driver applied each frame and left
the window maximized, so a window tiled to half the screen still showed
the restore button and restored to its old rect, and a window moved to
another display stayed maximized but restored to the display it left.
macOS may also hold the size the tool asks for to the display the window
is leaving, so the window didn't fill the new display.

The Cocoa window now tells the back end when its frame has stopped
changing (WINDOW_FRAME_SETTLED, 0.3 s after the last change), and the
driver judges the frame as a whole, against where the change began, if
the window filled a display then:

- On the same display, not filling it: the window isn't maximized any
  more, as on Windows when the user resizes a maximized window. It
  restores to its new frame.
- On another display: it stays maximized, fills that display, and the
  rect it restores to moves along to that display, as with Windows'
  Win+Shift+arrow.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/winemac.drv/cocoa_window.m |  12 +++
 dlls/winemac.drv/event.c        |   5 ++
 dlls/winemac.drv/macdrv.h       |   3 +
 dlls/winemac.drv/macdrv_cocoa.h |   1 +
 dlls/winemac.drv/window.c       | 133 +++++++++++++++++++++++++++++++-
 5 files changed, 151 insertions(+), 3 deletions(-)

diff --git a/dlls/winemac.drv/cocoa_window.m b/dlls/winemac.drv/cocoa_window.m
index 62425f1a49..873cf5f0e5 100644
--- a/dlls/winemac.drv/cocoa_window.m
+++ b/dlls/winemac.drv/cocoa_window.m
@@ -2112,6 +2112,13 @@ - (void) postBroughtForwardEvent
         macdrv_release_event(event);
     }
 
+    - (void) postWindowFrameSettled
+    {
+        macdrv_event* event = macdrv_create_event(WINDOW_FRAME_SETTLED, self);
+        [queue postEvent:event];
+        macdrv_release_event(event);
+    }
+
     - (void) postWindowFrameChanged:(NSRect)frame fullscreen:(BOOL)isFullscreen resizing:(BOOL)resizing skipSizeMove:(BOOL)skipSizeMove
     {
         macdrv_event* event;
@@ -2881,6 +2888,11 @@ - (void)windowDidResize:(NSNotification *)notification skipSizeMove:(BOOL)skipSi
                             resizing:[self inLiveResize]
                         skipSizeMove:skipSizeMove];
 
+        /* A window tool changes a frame in steps (size, position, size again): tell the back end
+           when the frame has stopped changing, so it can judge the result as a whole. */
+        [NSObject cancelPreviousPerformRequestsWithTarget:self selector:@selector(postWindowFrameSettled) object:nil];
+        [self performSelector:@selector(postWindowFrameSettled) withObject:nil afterDelay:0.3];
+
         [[[self contentView] inputContext] invalidateCharacterCoordinates];
         [self updateFullscreen];
     }
diff --git a/dlls/winemac.drv/event.c b/dlls/winemac.drv/event.c
index a31693764f..d821f1ed54 100644
--- a/dlls/winemac.drv/event.c
+++ b/dlls/winemac.drv/event.c
@@ -66,6 +66,7 @@ static const char *dbgstr_event(int type)
         "WINDOW_DRAG_BEGIN",
         "WINDOW_DRAG_END",
         "WINDOW_FRAME_CHANGED",
+        "WINDOW_FRAME_SETTLED",
         "WINDOW_GOT_FOCUS",
         "WINDOW_LOST_FOCUS",
         "WINDOW_MAXIMIZE_REQUESTED",
@@ -123,6 +124,7 @@ static macdrv_event_mask get_event_mask(DWORD mask)
         event_mask |= event_mask_for_type(STATUS_ITEM_MOUSE_MOVE);
         event_mask |= event_mask_for_type(WINDOW_DID_UNMINIMIZE);
         event_mask |= event_mask_for_type(WINDOW_FRAME_CHANGED);
+        event_mask |= event_mask_for_type(WINDOW_FRAME_SETTLED);
         event_mask |= event_mask_for_type(WINDOW_GOT_FOCUS);
         event_mask |= event_mask_for_type(WINDOW_LOST_FOCUS);
     }
@@ -481,6 +483,9 @@ void macdrv_handle_event(const macdrv_event *event)
     case WINDOW_FRAME_CHANGED:
         macdrv_window_frame_changed(hwnd, event);
         break;
+    case WINDOW_FRAME_SETTLED:
+        macdrv_window_frame_settled(hwnd);
+        break;
     case WINDOW_GOT_FOCUS:
         macdrv_window_got_focus(hwnd, event);
         break;
diff --git a/dlls/winemac.drv/macdrv.h b/dlls/winemac.drv/macdrv.h
index 67aa1af66c..a7115e90e8 100644
--- a/dlls/winemac.drv/macdrv.h
+++ b/dlls/winemac.drv/macdrv.h
@@ -238,6 +238,8 @@ extern BOOL macdrv_SystemParametersInfo(UINT action, UINT int_param, void *ptr_p
     unsigned int        per_pixel_alpha : 1;    /* is window using per-pixel alpha? */
     unsigned int        minimized : 1;          /* is window minimized? */
     unsigned int        fullscreen : 1;         /* is the window visible rect fullscreen? (unrelated to native AppKit/Cocoa fullscreen) */
+    unsigned int        frame_gesture : 1;      /* is something on the Mac side changing the maximized window's frame? */
+    RECT                gesture_start;          /* the window's visible rect when that began, raw pixels */
 };
 
 struct macdrv_client_surface
@@ -261,6 +263,7 @@ extern BOOL macdrv_SystemParametersInfo(UINT action, UINT int_param, void *ptr_p
 
 extern void macdrv_window_close_requested(HWND hwnd);
 extern void macdrv_window_frame_changed(HWND hwnd, const macdrv_event *event);
+extern void macdrv_window_frame_settled(HWND hwnd);
 extern void macdrv_window_got_focus(HWND hwnd, const macdrv_event *event);
 extern void macdrv_window_lost_focus(HWND hwnd, const macdrv_event *event);
 extern void macdrv_app_activated(void);
diff --git a/dlls/winemac.drv/macdrv_cocoa.h b/dlls/winemac.drv/macdrv_cocoa.h
index 0c5523654d..61f50b23a4 100644
--- a/dlls/winemac.drv/macdrv_cocoa.h
+++ b/dlls/winemac.drv/macdrv_cocoa.h
@@ -303,6 +303,7 @@ static inline CGPoint cgpoint_win_from_mac(CGPoint point)
     WINDOW_DRAG_BEGIN,
     WINDOW_DRAG_END,
     WINDOW_FRAME_CHANGED,
+    WINDOW_FRAME_SETTLED,
     WINDOW_GOT_FOCUS,
     WINDOW_LOST_FOCUS,
     WINDOW_MAXIMIZE_REQUESTED,
diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
index 872e317ad7..b1d4db9d80 100644
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -1649,6 +1649,10 @@ void macdrv_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UINT
 
     old_rects = data->rects;
     data->rects = *new_rects;
+    if (!(new_style & WS_MAXIMIZE))
+    {
+        data->frame_gesture = FALSE;
+    }
 
     TRACE("win %p/%p new_rects %s style %08x flags %08x surface %p\n", hwnd, data->cocoa_window,
           debugstr_window_rects(new_rects), new_style, swp_flags, surface);
@@ -1729,6 +1733,28 @@ void macdrv_window_close_requested(HWND hwnd)
 }
 
 
+/***********************************************************************
+ *              fills_work_area
+ *
+ * Whether a visible rect (raw pixels) covers the work area of the display it is mostly on, as a
+ * maximized window does: within a 32nd of the work area, so a window that hangs its sizing border
+ * past the edges, or that macOS keeps below the menu bar, counts, and a window tool's halves and
+ * thirds don't. Call it with the thread's DPI awareness set to per-monitor.
+ */
+static BOOL fills_work_area(const RECT *visible, MONITORINFO *info)
+{
+    HMONITOR monitor = NtUserMonitorFromRect(visible, MONITOR_DEFAULTTONEAREST);
+    int slack_x, slack_y;
+
+    info->cbSize = sizeof(*info);
+    if (!monitor || !NtUserGetMonitorInfo(monitor, info)) return FALSE;
+    slack_x = (info->rcWork.right - info->rcWork.left) / 32;
+    slack_y = (info->rcWork.bottom - info->rcWork.top) / 32;
+    return visible->left <= info->rcWork.left + slack_x && visible->top <= info->rcWork.top + slack_y &&
+           visible->right >= info->rcWork.right - slack_x && visible->bottom >= info->rcWork.bottom - slack_y;
+}
+
+
 /***********************************************************************
  *              macdrv_window_frame_changed
  *
@@ -1737,7 +1763,7 @@ void macdrv_window_close_requested(HWND hwnd)
 void macdrv_window_frame_changed(HWND hwnd, const macdrv_event *event)
 {
     struct macdrv_win_data *data;
-    RECT rect;
+    RECT rect, visible, old_visible;
     UINT flags = SWP_NOACTIVATE | SWP_NOZORDER;
     int width, height;
     BOOL being_dragged;
@@ -1756,8 +1782,9 @@ void macdrv_window_frame_changed(HWND hwnd, const macdrv_event *event)
           wine_dbgstr_cgrect(event->window_frame_changed.frame),
           event->window_frame_changed.fullscreen, event->window_frame_changed.in_resize);
 
-    rect = rect_from_cgrect(event->window_frame_changed.frame);
-    rect = window_rect_from_visible(&data->rects, rect);
+    visible = rect_from_cgrect(event->window_frame_changed.frame);
+    old_visible = data->rects.visible;
+    rect = window_rect_from_visible(&data->rects, visible);
     width = rect.right - rect.left;
     height = rect.bottom - rect.top;
 
@@ -1776,6 +1803,16 @@ void macdrv_window_frame_changed(HWND hwnd, const macdrv_event *event)
               data->rects.window.bottom - data->rects.window.top, width, height);
 
     being_dragged = data->drag_event != NULL;
+
+    /* Something on the Mac side, a window tool such as Rectangle, is changing a maximized
+     * window's frame: macdrv_window_frame_settled judges the result once the frame stops changing. */
+    if ((!(flags & SWP_NOSIZE) || !(flags & SWP_NOMOVE)) && !event->window_frame_changed.fullscreen &&
+        !event->window_frame_changed.in_resize && !being_dragged && !data->frame_gesture &&
+        (NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_MAXIMIZE))
+    {
+        data->frame_gesture = TRUE;
+        data->gesture_start = old_visible;
+    }
     release_win_data(data);
 
     if (event->window_frame_changed.fullscreen)
@@ -1792,6 +1829,96 @@ void macdrv_window_frame_changed(HWND hwnd, const macdrv_event *event)
 }
 
 
+/***********************************************************************
+ *              macdrv_window_frame_settled
+ *
+ * Handler for WINDOW_FRAME_SETTLED events: the window's frame has stopped changing. If something
+ * on the Mac side (a window tool such as Rectangle, or the user's shortcut for one) changed the
+ * frame of a maximized window that filled a display, judge where it ended up:
+ *
+ * - On the same display, not filling it (a half, a third): the window isn't maximized any more, as
+ *   on Windows when the user resizes a maximized window. It restores to its new frame. (Dragging
+ *   its edge with the mouse is handled in windowWillStartLiveResize.)
+ * - On another display: it stays maximized and fills that display, whatever size it came with
+ *   (macOS may hold a size to the display the window left), and the rect it restores to moves
+ *   along to that display, as with Windows' Win+Shift+arrow.
+ */
+void macdrv_window_frame_settled(HWND hwnd)
+{
+    struct macdrv_win_data *data;
+    MONITORINFO start_info, end_info;
+    RECT start, visible, window;
+    BOOL end_fills;
+    UINT context;
+
+    if (!(data = get_win_data(hwnd))) return;
+    if (!data->frame_gesture)
+    {
+        release_win_data(data);
+        return;
+    }
+    data->frame_gesture = FALSE;
+    start = data->gesture_start;
+    visible = data->rects.visible;
+    window = data->rects.window;
+    release_win_data(data);
+
+    if (!(NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_MAXIMIZE)) return;
+
+    context = NtUserSetThreadDpiAwarenessContext(NTUSER_DPI_PER_MONITOR_AWARE_V2);
+    end_fills = fills_work_area(&visible, &end_info);
+    if (!fills_work_area(&start, &start_info))
+        TRACE("%p didn't fill a display: leaving it as it is\n", hwnd);
+    else if (EqualRect(&start_info.rcMonitor, &end_info.rcMonitor))
+    {
+        if (!end_fills)
+        {
+            TRACE("%p no longer fills its display: it restores to %s\n", hwnd, wine_dbgstr_rect(&window));
+            NtUserSetRawWindowPos(hwnd, window, 0, TRUE);
+            NtUserSetThreadDpiAwarenessContext(context);
+            perform_window_command(hwnd, WS_MAXIMIZE, 0, SC_RESTORE, HTMAXBUTTON);
+            return;
+        }
+    }
+    else
+    {
+        WINDOWPLACEMENT placement = {.length = sizeof(placement)};
+
+        if (!end_fills)
+        {
+            /* the window's frame around its visible rect stays as it was */
+            RECT frame = end_info.rcWork;
+
+            frame.left += window.left - visible.left;
+            frame.top += window.top - visible.top;
+            frame.right += window.right - visible.right;
+            frame.bottom += window.bottom - visible.bottom;
+            TRACE("%p moved to another display: filling it with %s\n", hwnd, wine_dbgstr_rect(&frame));
+            NtUserSetRawWindowPos(hwnd, frame, SWP_NOACTIVATE | SWP_NOZORDER, FALSE);
+        }
+        if (NtUserGetWindowPlacement(hwnd, &placement))
+        {
+            RECT normal = placement.rcNormalPosition;
+            int width = min(normal.right - normal.left, end_info.rcWork.right - end_info.rcWork.left);
+            int height = min(normal.bottom - normal.top, end_info.rcWork.bottom - end_info.rcWork.top);
+
+            /* GetWindowPlacement gives the rect relative to the work area of its display (the
+             * one the window filled before), except for tool windows. */
+            if (NtUserGetWindowLongW(hwnd, GWL_EXSTYLE) & WS_EX_TOOLWINDOW)
+                OffsetRect(&normal, -start_info.rcWork.left, -start_info.rcWork.top);
+            OffsetRect(&normal, end_info.rcWork.left, end_info.rcWork.top);
+            normal.left = max(end_info.rcWork.left, min(normal.left, end_info.rcWork.right - width));
+            normal.top = max(end_info.rcWork.top, min(normal.top, end_info.rcWork.bottom - height));
+            normal.right = normal.left + width;
+            normal.bottom = normal.top + height;
+            TRACE("%p fills another display: it restores to %s\n", hwnd, wine_dbgstr_rect(&normal));
+            NtUserSetRawWindowPos(hwnd, normal, 0, TRUE);
+        }
+    }
+    NtUserSetThreadDpiAwarenessContext(context);
+}
+
+
 /***********************************************************************
  *              macdrv_window_got_focus
  *

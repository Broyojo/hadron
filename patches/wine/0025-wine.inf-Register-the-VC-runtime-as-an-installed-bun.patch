From 7b4cfedf6ba9025e70506b282493c5a9e2feef1d Mon Sep 17 00:00:00 2001
From: Broyojo <dha@xoba.com>
Date: Mon, 5 Oct 2026 22:13:21 -0400
Subject: [PATCH] wine.inf: Register the VC runtime as an installed bundle.

The VC redistributable's installer is a WiX bundle. It registers itself
under Uninstall in the 32-bit registry view, and an older bundle of the
same family that finds a newer one there ends with ERROR_PRODUCT_VERSION
instead of installing. Without that registration every older
redistributable installs over Wine's runtime and lowers the version in
VC\Runtimes: Steam's install script for a game runs the 2015 or 2019
one, and a launcher that then asks for a newer runtime starts the
game's own prerequisite installer.

Register the x64 and x86 bundles with the version wine.inf already
gives the runtime. The engine wants the registered bundle's file to
exist, so point it at dism.exe, a stub.
---
 loader/wine.inf.in | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/loader/wine.inf.in b/loader/wine.inf.in
index e795a8deae..95d382bd29 100644
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -83,6 +83,7 @@ Needs=BaseInstall
 WineFakeDlls=FakeDllsWin32
 AddReg=\
     VCRuntime.ntx86,\
+    VCRuntimeBundle.ntx86,\
     VersionInfo
 
 [DefaultInstall.ntarm]
@@ -126,7 +127,9 @@ Needs=BaseWow64Install
 AddReg=\
     CurrentVersionWow64.ntx86,\
     VCRuntime.ntamd64,\
-    VCRuntime.ntx86
+    VCRuntime.ntx86,\
+    VCRuntimeBundle.ntamd64,\
+    VCRuntimeBundle.ntx86
 
 [Wow64Install.ntarm]
 Needs=BaseWow64Install
@@ -686,6 +689,25 @@ HKLM,SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x86,"Minor",0x10003,0x0000
 HKLM,SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x86,"Rbld",0x10003,0x00000000
 HKLM,SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x86,"Version",2,"14.51.36247.0"
 
+;; The redistributable's installer is a bundle that registers itself here, in the 32-bit view,
+;; and an older bundle that finds a newer one registered ends with ERROR_PRODUCT_VERSION instead
+;; of installing over it. It wants the registered bundle's file to exist; dism.exe is a stub.
+[VCRuntimeBundle.ntamd64]
+HKLM,%CurrentVersion%\Uninstall\{0e3bb569-69d6-4c34-bff9-c2f81db5e5f0},"BundleCachePath",2,"%11%\dism.exe"
+HKLM,%CurrentVersion%\Uninstall\{0e3bb569-69d6-4c34-bff9-c2f81db5e5f0},"BundleProviderKey",2,"VC,redist.x64,amd64,14.51,bundle"
+HKLM,%CurrentVersion%\Uninstall\{0e3bb569-69d6-4c34-bff9-c2f81db5e5f0},"BundleUpgradeCode",0x10002,"{C146EF48-4D31-3C3D-A2C5-1E91AF8A0A9B}"
+HKLM,%CurrentVersion%\Uninstall\{0e3bb569-69d6-4c34-bff9-c2f81db5e5f0},"BundleVersion",2,"14.51.36247.0"
+HKLM,%CurrentVersion%\Uninstall\{0e3bb569-69d6-4c34-bff9-c2f81db5e5f0},"Installed",0x10003,0x00000001
+HKLM,%CurrentVersion%\Uninstall\{0e3bb569-69d6-4c34-bff9-c2f81db5e5f0},"SystemComponent",0x10003,0x00000001
+
+[VCRuntimeBundle.ntx86]
+HKLM,%CurrentVersion%\Uninstall\{9a6ce18d-11c0-4452-aa35-9f2b8437c686},"BundleCachePath",2,"%11%\dism.exe"
+HKLM,%CurrentVersion%\Uninstall\{9a6ce18d-11c0-4452-aa35-9f2b8437c686},"BundleProviderKey",2,"VC,redist.x86,x86,14.51,bundle"
+HKLM,%CurrentVersion%\Uninstall\{9a6ce18d-11c0-4452-aa35-9f2b8437c686},"BundleUpgradeCode",0x10002,"{F899BAD3-98ED-308E-A905-56B5338963FF}"
+HKLM,%CurrentVersion%\Uninstall\{9a6ce18d-11c0-4452-aa35-9f2b8437c686},"BundleVersion",2,"14.51.36247.0"
+HKLM,%CurrentVersion%\Uninstall\{9a6ce18d-11c0-4452-aa35-9f2b8437c686},"Installed",0x10003,0x00000001
+HKLM,%CurrentVersion%\Uninstall\{9a6ce18d-11c0-4452-aa35-9f2b8437c686},"SystemComponent",0x10003,0x00000001
+
 [RegisterDllsSection]
 ;;some dlls have to be registered first
 11,,shell32.dll,1
-- 
2.54.0 (Apple Git-157)


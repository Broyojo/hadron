From e9ac2705ac468b3815850295eed1a1105a1469e2 Mon Sep 17 00:00:00 2001
From: Broyojo <dha@xoba.com>
Date: Wed, 30 Sep 2026 15:58:08 -0400
Subject: [PATCH] winemac.drv: Scroll like a native Mac application.

Trackpad and Magic Mouse momentum kept producing wheel input after the
fingers left the surface, which Windows applications, games in particular,
take as more wheel turns; drop momentum-phase events unless the new
ScrollMomentum option is set. Scale precise scrolling so that WHEEL_DELTA
covers 3 of the system's lines, the Windows definition, instead of a fixed
6 units per pixel, which scrolled about 1.5x farther than a native
application. Send exactly one notch per detent of a clicky wheel instead of
macOS's accelerated line count, as a Windows wheel does, unless the new
AccelerateScrollWheel option is set. Default UsePreciseScrolling to off, so
trackpad movement is accumulated into whole notches: many games ignore or
mishandle fractions of WHEEL_DELTA.
---
 dlls/winemac.drv/cocoa_app.m    | 45 +++++++++++++++++++++++----------
 dlls/winemac.drv/macdrv_cocoa.h |  2 ++
 dlls/winemac.drv/macdrv_main.c  | 12 ++++++++-
 3 files changed, 44 insertions(+), 15 deletions(-)

diff --git a/dlls/winemac.drv/cocoa_app.m b/dlls/winemac.drv/cocoa_app.m
index 34d550d943..4dafa80651 100644
--- a/dlls/winemac.drv/cocoa_app.m
+++ b/dlls/winemac.drv/cocoa_app.m
@@ -1678,10 +1678,18 @@ - (void) handleScrollWheel:(NSEvent*)theEvent
                 process = NSMouseInRect(nspoint, contentRect, NO);
             }
 
+            /* Momentum scrolling continues after the fingers leave a trackpad or Magic Mouse.
+               Windows wheels have no such thing, and applications, games especially, take the
+               extra events as more wheel turns. */
+            if (!scroll_momentum && [theEvent momentumPhase] != NSEventPhaseNone)
+                process = FALSE;
+
             if (process)
             {
                 macdrv_event* event;
                 double x, y;
+                double pixelsPerLine = 10;
+                CGEventSourceRef source;
                 BOOL continuous = FALSE;
 
                 pt = cgpoint_win_from_mac(pt);
@@ -1691,6 +1699,12 @@ - (void) handleScrollWheel:(NSEvent*)theEvent
                 event->mouse_scroll.y = floor(pt.y);
                 event->mouse_scroll.time_ms = [self ticksForEventTime:[theEvent timestamp]];
 
+                if ((source = CGEventCreateSourceFromEvent(cgevent)))
+                {
+                    pixelsPerLine = CGEventSourceGetPixelsPerLine(source);
+                    CFRelease(source);
+                }
+
                 if (CGEventGetIntegerValueField(cgevent, kCGScrollWheelEventIsContinuous))
                 {
                     continuous = TRUE;
@@ -1704,16 +1718,7 @@ - (void) handleScrollWheel:(NSEvent*)theEvent
                 }
                 else
                 {
-                    double pixelsPerLine = 10;
-                    CGEventSourceRef source;
-
                     /* The non-continuous values are in units of "lines", not pixels. */
-                    if ((source = CGEventCreateSourceFromEvent(cgevent)))
-                    {
-                        pixelsPerLine = CGEventSourceGetPixelsPerLine(source);
-                        CFRelease(source);
-                    }
-
                     x = pixelsPerLine * [theEvent deltaX];
                     y = pixelsPerLine * [theEvent deltaY];
                 }
@@ -1723,11 +1728,23 @@ - (void) handleScrollWheel:(NSEvent*)theEvent
                    So, negate the X scroll value to translate. */
                 x = -x;
 
-                /* The x,y values so far are in pixels.  Win32 expects to receive some
-                   fraction of WHEEL_DELTA == 120.  By my estimation, that's roughly
-                   6 times the pixel value. */
-                x *= 6;
-                y *= 6;
+                /* The x,y values so far are in pixels, already scaled by the user's macOS
+                   scrolling speed.  Win32 expects fractions of WHEEL_DELTA == 120, one wheel
+                   notch, which scrolls 3 lines (SPI_GETWHEELSCROLLLINES' default): scale so
+                   that a Windows application scrolls as far as a Mac one would. */
+                if (continuous || accelerate_scroll_wheel)
+                {
+                    x *= 120 / (3 * pixelsPerLine);
+                    y *= 120 / (3 * pixelsPerLine);
+                }
+                else
+                {
+                    /* A clicky wheel sends an event per detent, which macOS accelerates to
+                       several lines when the wheel turns fast.  Windows doesn't accelerate
+                       wheels: one detent is one notch, which is what games count. */
+                    x = x > 0 ? 120 : x < 0 ? -120 : 0;
+                    y = y > 0 ? 120 : y < 0 ? -120 : 0;
+                }
 
                 if (use_precise_scrolling)
                 {
diff --git a/dlls/winemac.drv/macdrv_cocoa.h b/dlls/winemac.drv/macdrv_cocoa.h
index 3038ac9325..8f2e9664eb 100644
--- a/dlls/winemac.drv/macdrv_cocoa.h
+++ b/dlls/winemac.drv/macdrv_cocoa.h
@@ -131,6 +131,8 @@
 extern bool use_confinement_cursor_clipping;
 extern bool cursor_clipping_locks_windows;
 extern bool use_precise_scrolling;
+extern bool scroll_momentum;
+extern bool accelerate_scroll_wheel;
 extern int gl_surface_mode;
 extern CFDictionaryRef localized_strings;
 extern bool retina_enabled;  /* Whether Retina mode is enabled via registry setting. */
diff --git a/dlls/winemac.drv/macdrv_main.c b/dlls/winemac.drv/macdrv_main.c
index b50068bc50..d98a13f7bd 100644
--- a/dlls/winemac.drv/macdrv_main.c
+++ b/dlls/winemac.drv/macdrv_main.c
@@ -49,7 +49,11 @@ bool allow_software_rendering = false;
 bool allow_immovable_windows = true;
 bool use_confinement_cursor_clipping = true;
 bool cursor_clipping_locks_windows = true;
-bool use_precise_scrolling = true;
+/* Fractions of WHEEL_DELTA are valid Win32 but many games only handle whole notches;
+   UsePreciseScrolling=Y brings back fractional deltas for applications that scroll smoothly. */
+bool use_precise_scrolling = false;
+bool scroll_momentum = false;
+bool accelerate_scroll_wheel = false;
 int gl_surface_mode = GL_SURFACE_IN_FRONT_OPAQUE;
 bool retina_enabled = false;
 bool enable_app_nap = false;
@@ -346,6 +350,12 @@ static void setup_options(void)
     if (!get_config_key(hkey, appkey, "UsePreciseScrolling", buffer, sizeof(buffer)))
         use_precise_scrolling = IS_OPTION_TRUE(buffer[0]);
 
+    if (!get_config_key(hkey, appkey, "ScrollMomentum", buffer, sizeof(buffer)))
+        scroll_momentum = IS_OPTION_TRUE(buffer[0]);
+
+    if (!get_config_key(hkey, appkey, "AccelerateScrollWheel", buffer, sizeof(buffer)))
+        accelerate_scroll_wheel = IS_OPTION_TRUE(buffer[0]);
+
     if (!get_config_key(hkey, appkey, "OpenGLSurfaceMode", buffer, sizeof(buffer)))
     {
         static const WCHAR transparentW[] = {'t','r','a','n','s','p','a','r','e','n','t',0};
-- 

From e8823a130eb130571344cf7bce9ae7253fcbc805 Mon Sep 17 00:00:00 2001
From: Broyojo <dha@xoba.com>
Date: Mon, 23 Nov 2026 11:15:49 -0500
Subject: [PATCH] server: Answer pipe mode requests on Unix pipes as on
 anonymous pipes.

A Unix pipe or socket that becomes a handle, as a process's standard
handles do when its output goes to a pipe, is a file object, and
GetFileType reports it as a pipe. But FilePipeInformation failed on it
with STATUS_NOT_IMPLEMENTED, and setting it with STATUS_OBJECT_TYPE_MISMATCH,
so SetNamedPipeHandleState failed with ERROR_INVALID_HANDLE where it
succeeds on an anonymous pipe on Windows. Node and Electron open such a
standard handle as a pipe stream with SetNamedPipeHandleState(
PIPE_READMODE_BYTE | PIPE_WAIT) and stop with "open EBADF" when it fails.

Such a handle now answers as a pipe from CreatePipe does: its mode is
byte mode, blocking; setting that mode succeeds, and message mode fails
with STATUS_INVALID_PARAMETER. Non-blocking mode is refused with
STATUS_NOT_SUPPORTED, as its reads and writes are made on the blocking
Unix descriptor.
---
 dlls/ntdll/unix/file.c |  3 +++
 server/file.c          | 53 +++++++++++++++++++++++++++++++++++++++++-
 server/file.h          |  1 +
 server/named_pipe.c    |  8 ++++++-
 4 files changed, 63 insertions(+), 2 deletions(-)

diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 1bfec7a430..86520dbd4b 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5043,6 +5043,9 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         return server_get_file_info( handle, io, ptr, len, class );
     if (len < info_sizes[class])
         return io->Status = STATUS_INFO_LENGTH_MISMATCH;
+    /* The server answers for named pipes, and for the Unix pipes and sockets that are anonymous pipes. */
+    if (class == FilePipeInformation)
+        return server_get_file_info( handle, io, ptr, len, class );
 
     if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, &options )))
     {
diff --git a/server/file.c b/server/file.c
index 20680ef5b3..2a1df11625 100644
--- a/server/file.c
+++ b/server/file.c
@@ -84,6 +84,7 @@ static struct list *file_get_kernel_obj_list( struct object *obj );
 static void file_destroy( struct object *obj );
 
 static enum server_fd_type file_get_fd_type( struct fd *fd );
+static void file_get_file_info( struct fd *fd, obj_handle_t handle, unsigned int info_class );
 
 static const struct object_ops file_ops =
 {
@@ -104,7 +105,7 @@ static const struct object_ops file_ops =
 static const struct fd_ops file_fd_ops =
 {
     .get_fd_type   = file_get_fd_type,
-    .get_file_info = default_fd_get_file_info,
+    .get_file_info = file_get_file_info,
     .ioctl         = default_fd_ioctl,
     .queue_async   = default_fd_queue_async,
 };
@@ -282,6 +283,56 @@ static enum server_fd_type file_get_fd_type( struct fd *fd )
     return FD_TYPE_CHAR;
 }
 
+/* A Unix pipe or socket is an anonymous pipe to Windows programs (GetFileType says so): a byte
+ * stream whose operations block, the mode CreatePipe gives. */
+static int is_unix_pipe( struct file *file )
+{
+    return S_ISFIFO( file->mode ) || S_ISSOCK( file->mode );
+}
+
+static void file_get_file_info( struct fd *fd, obj_handle_t handle, unsigned int info_class )
+{
+    struct file *file = get_fd_user( fd );
+    FILE_PIPE_INFORMATION info;
+
+    if (info_class != FilePipeInformation || !is_unix_pipe( file ))
+    {
+        default_fd_get_file_info( fd, handle, info_class );
+        return;
+    }
+    if (!(get_handle_access( current->process, handle ) & FILE_READ_ATTRIBUTES))
+    {
+        set_error( STATUS_ACCESS_DENIED );
+        return;
+    }
+    if (get_reply_max_size() < sizeof(info))
+    {
+        set_error( STATUS_INFO_LENGTH_MISMATCH );
+        return;
+    }
+    info.ReadMode       = FILE_PIPE_BYTE_STREAM_MODE;
+    info.CompletionMode = FILE_PIPE_QUEUE_OPERATION;
+    set_reply_data( &info, sizeof(info) );
+}
+
+/* set_named_pipe_info for a Unix pipe or socket: it takes the mode it has, byte mode and blocking */
+void set_unix_pipe_info( obj_handle_t handle, unsigned int flags )
+{
+    struct file *file = get_file_obj( current->process, handle, 0 );
+
+    if (!file) return;
+    if (!is_unix_pipe( file )) set_error( STATUS_OBJECT_TYPE_MISMATCH );
+    else if (!(get_handle_access( current->process, handle ) & FILE_WRITE_ATTRIBUTES))
+        set_error( STATUS_ACCESS_DENIED );
+    /* a byte stream has no messages to read */
+    else if (flags & ~NAMED_PIPE_NONBLOCKING_MODE) set_error( STATUS_INVALID_PARAMETER );
+    /* Its reads and writes are made on the Unix descriptor, which blocks; they cannot be made to
+     * return at once yet. */
+    else if (flags & NAMED_PIPE_NONBLOCKING_MODE)
+        set_error( STATUS_NOT_SUPPORTED );
+    release_object( file );
+}
+
 static struct fd *file_get_fd( struct object *obj )
 {
     struct file *file = (struct file *)obj;
diff --git a/server/file.h b/server/file.h
index 61f570f729..0f0b7e6921 100644
--- a/server/file.h
+++ b/server/file.h
@@ -157,6 +157,7 @@ extern const char *get_timeout_str( timeout_t timeout );
 extern struct file *get_file_obj( struct process *process, obj_handle_t handle,
                                   unsigned int access );
 extern int get_file_unix_fd( struct file *file );
+extern void set_unix_pipe_info( obj_handle_t handle, unsigned int flags );
 extern struct file *create_file_for_fd( int fd, unsigned int access, unsigned int sharing );
 extern struct file *create_file_for_fd_obj( struct fd *fd, unsigned int access, unsigned int sharing );
 extern void file_set_error(void);
diff --git a/server/named_pipe.c b/server/named_pipe.c
index 1e51158a1c..601ac9d130 100644
--- a/server/named_pipe.c
+++ b/server/named_pipe.c
@@ -1617,7 +1617,13 @@ DECL_HANDLER(set_named_pipe_info)
         clear_error();
         pipe_end = (struct pipe_end *)get_handle_obj( current->process, req->handle,
                                                       0, &pipe_client_ops );
-        if (!pipe_end) return;
+        if (!pipe_end)
+        {
+            if (get_error() != STATUS_OBJECT_TYPE_MISMATCH) return;
+            clear_error();
+            set_unix_pipe_info( req->handle, req->flags );
+            return;
+        }
     }
 
     if (!pipe_end->pipe)
-- 

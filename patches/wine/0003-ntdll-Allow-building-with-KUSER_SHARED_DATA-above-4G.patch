From 28a8e2408134378967d951006ab959cb2664f4eb Mon Sep 17 00:00:00 2001
From: proton-apple <dev@proton-apple>
Date: Tue, 29 Sep 2026 14:32:14 -0400
Subject: [PATCH] ntdll: Allow building with KUSER_SHARED_DATA above 4GB.

Hosts that can't map memory below 4GB (arm64 macOS without the
cross-architecture entitlement) can define WINE_HIGH_USER_SHARED_DATA to
move the shared user data page and the start of the address space above
4GB. The x64 syscall thunks then skip the SystemCall check, which uses a
32-bit absolute address. Only 64-bit programs that don't hardcode the
address work in this mode.
---
 dlls/kernel32/process.c     | 2 +-
 dlls/kernel32/sync.c        | 2 +-
 dlls/kernelbase/memory.c    | 2 +-
 dlls/kernelbase/sync.c      | 2 +-
 dlls/ntdll/signal_arm64ec.c | 5 +++++
 dlls/ntdll/thread.c         | 2 +-
 dlls/ntdll/unix/virtual.c   | 8 +++++++-
 include/ddk/wdm.h           | 9 +++++++++
 include/wine/asm.h          | 7 ++++++-
 9 files changed, 32 insertions(+), 7 deletions(-)

diff --git a/dlls/kernel32/process.c b/dlls/kernel32/process.c
index 9bbb18d89d..5e7a8f65b6 100644
--- a/dlls/kernel32/process.c
+++ b/dlls/kernel32/process.c
@@ -39,7 +39,7 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(process);
 
-static const struct _KUSER_SHARED_DATA *user_shared_data = (struct _KUSER_SHARED_DATA *)0x7ffe0000;
+static const struct _KUSER_SHARED_DATA *user_shared_data = (struct _KUSER_SHARED_DATA *)MM_SHARED_USER_DATA_VA;
 
 typedef struct
 {
diff --git a/dlls/kernel32/sync.c b/dlls/kernel32/sync.c
index 5b2a8489a0..99e8080c03 100644
--- a/dlls/kernel32/sync.c
+++ b/dlls/kernel32/sync.c
@@ -42,7 +42,7 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(sync);
 
-static const struct _KUSER_SHARED_DATA *user_shared_data = (struct _KUSER_SHARED_DATA *)0x7ffe0000;
+static const struct _KUSER_SHARED_DATA *user_shared_data = (struct _KUSER_SHARED_DATA *)MM_SHARED_USER_DATA_VA;
 
 
 static void get_create_object_attributes( OBJECT_ATTRIBUTES *attr, UNICODE_STRING *nameW,
diff --git a/dlls/kernelbase/memory.c b/dlls/kernelbase/memory.c
index 2ce2dcad30..bf48cae1b6 100644
--- a/dlls/kernelbase/memory.c
+++ b/dlls/kernelbase/memory.c
@@ -40,7 +40,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(heap);
 WINE_DECLARE_DEBUG_CHANNEL(virtual);
 WINE_DECLARE_DEBUG_CHANNEL(globalmem);
 
-static const struct _KUSER_SHARED_DATA *user_shared_data = (struct _KUSER_SHARED_DATA *)0x7ffe0000;
+static const struct _KUSER_SHARED_DATA *user_shared_data = (struct _KUSER_SHARED_DATA *)MM_SHARED_USER_DATA_VA;
 
 static CRITICAL_SECTION memstatus_section;
 static CRITICAL_SECTION_DEBUG critsect_debug =
diff --git a/dlls/kernelbase/sync.c b/dlls/kernelbase/sync.c
index 94036acfad..40d24c9169 100644
--- a/dlls/kernelbase/sync.c
+++ b/dlls/kernelbase/sync.c
@@ -39,7 +39,7 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(sync);
 
-static const struct _KUSER_SHARED_DATA *user_shared_data = (struct _KUSER_SHARED_DATA *)0x7ffe0000;
+static const struct _KUSER_SHARED_DATA *user_shared_data = (struct _KUSER_SHARED_DATA *)MM_SHARED_USER_DATA_VA;
 
 /* check if current version is NT or Win95 */
 static inline BOOL is_version_nt(void)
diff --git a/dlls/ntdll/signal_arm64ec.c b/dlls/ntdll/signal_arm64ec.c
index 1a8174e7d7..beea4ecabb 100644
--- a/dlls/ntdll/signal_arm64ec.c
+++ b/dlls/ntdll/signal_arm64ec.c
@@ -1973,8 +1973,13 @@ static void __attribute__((naked)) arm64x_check_call(void)
          ".Lsyscall_seq:\n\t"
          ".byte 0x4c, 0x8b, 0xd1\n\t"       /* mov  %rcx,%r10 */
          ".byte 0xb8, 0, 0, 0, 0\n\t"       /* mov  $xxx,%eax */
+#ifdef WINE_HIGH_USER_SHARED_DATA
+         ".byte 0x39, 0xc0, 0x66, 0x0f\n\t" /* cmpl %eax,%eax; nopw 0(%rax,%rax) */
+         ".byte 0x1f, 0x44, 0x00, 0x00\n\t"
+#else
          ".byte 0xf6, 0x04, 0x25, 0x08\n\t" /* testb $0x1,0x7ffe0308 */
          ".byte 0x03, 0xfe, 0x7f, 0x01\n\t"
+#endif
          ".byte 0x75, 0x03\n\t"             /* jne 1f */
          ".byte 0x0f, 0x05\n\t"             /* syscall */
          ".byte 0xc3\n\t"                   /* ret */
diff --git a/dlls/ntdll/thread.c b/dlls/ntdll/thread.c
index 1c25c8ff1d..97630b3cae 100644
--- a/dlls/ntdll/thread.c
+++ b/dlls/ntdll/thread.c
@@ -35,7 +35,7 @@ WINE_DECLARE_DEBUG_CHANNEL(relay);
 WINE_DECLARE_DEBUG_CHANNEL(pid);
 WINE_DECLARE_DEBUG_CHANNEL(timestamp);
 
-struct _KUSER_SHARED_DATA *user_shared_data = (void *)0x7ffe0000;
+struct _KUSER_SHARED_DATA *user_shared_data = (void *)MM_SHARED_USER_DATA_VA;
 
 struct debug_info
 {
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 07ebf670c0..3e5a91d6cb 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -183,7 +183,11 @@ static const UINT_PTR host_page_mask = 0xfff;
 #endif
 
 /* Note: these are Windows limits, you cannot change them. */
+#ifdef WINE_HIGH_USER_SHARED_DATA
+static void *address_space_start = (void *)0x100000000;
+#else
 static void *address_space_start = (void *)0x10000;
+#endif
 #ifdef _WIN64
 static void *address_space_limit = (void *)0x7fffffff0000;  /* top of the total available address space */
 static void *user_space_limit    = (void *)0x7fffffff0000;  /* top of the user address space */
@@ -199,7 +203,7 @@ static void *host_addr_space_limit;  /* top of the host virtual address space */
 static struct file_view *arm64ec_view;
 
 ULONG_PTR user_space_wow_limit = 0;
-struct _KUSER_SHARED_DATA *user_shared_data = (void *)0x7ffe0000;
+struct _KUSER_SHARED_DATA *user_shared_data = (void *)MM_SHARED_USER_DATA_VA;
 
 /* TEB allocation blocks */
 static void *teb_block;
@@ -758,9 +762,11 @@ static void mmap_init( const struct preload_info *preload_info )
 #else
     reserve_area( (void *)0x7ffff0000000, (void *)0x7ffffe000000 ); /* top-down area */
     if (preload_info) return;
+#ifndef WINE_HIGH_USER_SHARED_DATA
     reserve_area( (void *)0x000000010000, (void *)0x000068000000 );
     reserve_area( (void *)0x00007f000000, (void *)0x00007fff0000 );
 #endif
+#endif
 }
 
 
diff --git a/include/ddk/wdm.h b/include/ddk/wdm.h
index bce13425a2..52802587ed 100644
--- a/include/ddk/wdm.h
+++ b/include/ddk/wdm.h
@@ -1479,6 +1479,15 @@ typedef struct _KUSER_SHARED_DATA {
 
 C_ASSERT( sizeof(KUSER_SHARED_DATA) == 0x738 );
 
+/* Hosts that cannot map below 4GB (arm64 macOS without the cross-architecture
+ * entitlement) can build with WINE_HIGH_USER_SHARED_DATA to move it; only 64-bit
+ * programs that don't hardcode the address will work. */
+#ifdef WINE_HIGH_USER_SHARED_DATA
+#define MM_SHARED_USER_DATA_VA 0x107ffe0000
+#else
+#define MM_SHARED_USER_DATA_VA 0x7ffe0000
+#endif
+
 #define SHARED_GLOBAL_FLAGS_QPC_BYPASS_ENABLED 0x01
 #define SHARED_GLOBAL_FLAGS_QPC_BYPASS_USE_HV_PAGE 0x02
 #define SHARED_GLOBAL_FLAGS_QPC_BYPASS_DISABLE_32BIT 0x04
diff --git a/include/wine/asm.h b/include/wine/asm.h
index 3cb21255fc..4125ff0a73 100644
--- a/include/wine/asm.h
+++ b/include/wine/asm.h
@@ -269,13 +269,18 @@
          "ret\n\t" \
          ".seh_endproc" :: "i" (id) )
 #elif defined __arm64ec_x64__
+# ifdef WINE_HIGH_USER_SHARED_DATA
+#  define __ASM_SYSCALL_TEST_USD ".byte 0x39,0xc0,0x66,0x0f,0x1f,0x44,0x00,0x00\n\t" /* 08: cmpl %eax,%eax; nopw */
+# else
+#  define __ASM_SYSCALL_TEST_USD ".byte 0xf6,0x04,0x25,0x08,0x03,0xfe,0x7f,0x01\n\t" /* 08: testb $1,0x7ffe0308 */
+# endif
 # define __ASM_SYSCALL_FUNC(id,name) \
     __ASM_DEFINE_FUNC( "\"EXP+#" #name "\"", \
                        ".seh_endprologue\n\t" \
                        ".byte 0x4c,0x8b,0xd1\n\t" /* 00: movq %rcx,%r10 */ \
                        ".byte 0xb8\n\t"           /* 03: movl $i,%eax */ \
                        ".long (" #id ")\n\t"                            \
-                       ".byte 0xf6,0x04,0x25,0x08,0x03,0xfe,0x7f,0x01\n\t" /* 08: testb $1,0x7ffe0308 */ \
+                       __ASM_SYSCALL_TEST_USD \
                        ".byte 0x75,0x03\n\t"      /* 10: jne 15 */ \
                        ".byte 0x0f,0x05\n\t"      /* 12: syscall */ \
                        ".byte 0xc3\n\t"           /* 14: ret */ \
-- 

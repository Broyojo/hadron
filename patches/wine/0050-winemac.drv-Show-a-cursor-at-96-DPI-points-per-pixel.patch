From dc33367c844842ab43d303a39c26b1d733171427 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ond=C5=99ej=20=C5=A0imon?= <ondrej@dorhawk.software>
Date: Tue, 17 Nov 2026 09:28:37 +0100
Subject: [PATCH] winemac.drv: Show a cursor at 96 / DPI points per pixel in
 Retina mode.

Since 0039 a cursor covers a point per pixel, as the Mac's own cursors
do. But Windows loads a cursor in the size for the DPI: 64 pixels at
192 DPI, so a DPI-aware program's hourglass was 64 points, twice the
Mac pointer.

Windows shows every cursor at its size in pixels. In Retina mode, show
each one at 96 / DPI points per pixel, the DPI of the window it is set
for: a point per pixel at 96 DPI, as before, and a display pixel per
pixel at 192, as on Windows. A cursor set over none of the program's
windows (win32u passes no window or the desktop's) takes the DPI of
the program's awareness, 96 for a program that isn't DPI aware.

The cursor cache keeps the frames as they are, and the scale goes on
each time the cursor is set, so a cursor shared by windows of different
DPIs is right over each. Cocoa applies Retina mode as it makes the
NSCursor, and makes the cursor in use again when the mode changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dlls/winemac.drv/cocoa_app.m | 29 +++++++++---
 dlls/winemac.drv/mouse.c     | 88 ++++++++++++++++++++++++++++++++++++
 2 files changed, 110 insertions(+), 7 deletions(-)

diff --git a/dlls/winemac.drv/cocoa_app.m b/dlls/winemac.drv/cocoa_app.m
index f3a23ce5d2..422495c7cf 100644
--- a/dlls/winemac.drv/cocoa_app.m
+++ b/dlls/winemac.drv/cocoa_app.m
@@ -1080,22 +1080,33 @@ - (void) setCursor:(NSCursor*)newCursor
         }
     }
 
-    - (void) setCursor
+    - (NSCursor*) cursorForFrame:(NSDictionary*)frame
     {
-        NSDictionary* frame = cursorFrames[cursorFrame];
         CGImageRef cgimage = (CGImageRef)frame[@"image"];
-        /* A cursor covers a point for each of its pixels, in Retina mode too, as the Mac's own
-           cursors do: halved to the display's pixels, a game's cursor is half the size of the
-           Mac's pointer and of what the game shows on a display without Retina mode. */
-        CGSize size = CGSizeMake(CGImageGetWidth(cgimage), CGImageGetHeight(cgimage));
+        /* In Retina mode a cursor covers as many points per pixel as the frame says
+           (macdrv_SetCursor): at 96 DPI a point for each pixel, as the Mac's own cursors do.
+           Without it, a pixel is a point. */
+        double pointsPerPixel = retina_on && frame[@"pointsPerPixel"] ?
+                                [frame[@"pointsPerPixel"] doubleValue] : 1;
+        CGSize size = CGSizeMake(CGImageGetWidth(cgimage) * pointsPerPixel,
+                                 CGImageGetHeight(cgimage) * pointsPerPixel);
         NSImage* image = [[NSImage alloc] initWithCGImage:cgimage size:NSSizeFromCGSize(size)];
         CFDictionaryRef hotSpotDict = (CFDictionaryRef)frame[@"hotSpot"];
         CGPoint hotSpot;
+        NSCursor* newCursor;
 
         if (!CGPointMakeWithDictionaryRepresentation(hotSpotDict, &hotSpot))
             hotSpot = CGPointZero;
-        self.cursor = [[[NSCursor alloc] initWithImage:image hotSpot:NSPointFromCGPoint(hotSpot)] autorelease];
+        hotSpot.x *= pointsPerPixel;
+        hotSpot.y *= pointsPerPixel;
+        newCursor = [[NSCursor alloc] initWithImage:image hotSpot:NSPointFromCGPoint(hotSpot)];
         [image release];
+        return [newCursor autorelease];
+    }
+
+    - (void) setCursor
+    {
+        self.cursor = [self cursorForFrame:cursorFrames[cursorFrame]];
         [self unhideCursor];
     }
 
@@ -2290,6 +2301,10 @@ - (void) setRetinaMode:(BOOL)mode
 
         [clipCursorHandler setRetinaMode:mode];
 
+        /* the cursor's size in points depends on the mode (cursorForFrame:) */
+        if ([cursorFrames count])
+            self.cursor = [self cursorForFrame:cursorFrames[cursorFrame]];
+
         for (WineWindow* window in [NSApp windows])
         {
             if ([window isKindOfClass:[WineWindow class]])
diff --git a/dlls/winemac.drv/mouse.c b/dlls/winemac.drv/mouse.c
index 0c9ba0393b..aa58f083bc 100644
--- a/dlls/winemac.drv/mouse.c
+++ b/dlls/winemac.drv/mouse.c
@@ -780,6 +780,83 @@ static BOOL get_icon_info(HICON handle, ICONINFOEXW *ret)
 }
 
 
+/***********************************************************************
+ *              process_dpi
+ *
+ * The DPI of the program's awareness, as GetDpiForWindow gives a window's: 96 for a program that
+ * isn't DPI aware, the system's for a system or per-monitor aware one. It is the process's:
+ * win32u hands the driver a cursor while it handles a hardware message (WM_WINE_SETCURSOR), with
+ * the thread made per-monitor aware for that.
+ */
+static UINT process_dpi(void)
+{
+    UINT dpi = NTUSER_DPI_CONTEXT_GET_DPI(NtUserGetProcessDpiAwarenessContext(NULL));
+
+    return dpi ? dpi : NtUserGetSystemDpiForProcess(NULL);
+}
+
+
+/***********************************************************************
+ *              cursor_points_per_pixel
+ *
+ * How many points a cursor covers per pixel in Retina mode. Windows shows every cursor at its
+ * size in pixels, and loads one from a resource in the size for the DPI: 32 pixels at 96 DPI, 64
+ * at 192. In Retina mode a cursor covers 96 / DPI points per pixel, the DPI of the window it's set
+ * for, or of the program over none of its windows: at 96 DPI a point per pixel, as the Mac's own
+ * cursors do; at 192 a display pixel per pixel, as on Windows. Without Retina mode a pixel is a
+ * point; Cocoa applies the mode (cursorForFrame:), so a cursor follows it when it changes.
+ */
+static double cursor_points_per_pixel(HWND hwnd)
+{
+    UINT dpi;
+
+    /* over none of the program's windows, win32u passes the desktop window */
+    if (!hwnd || hwnd == NtUserGetDesktopWindow() || !(dpi = NtUserGetDpiForWindow(hwnd)))
+        dpi = process_dpi();
+    return dpi ? 96.0 / dpi : 1;
+}
+
+
+/***********************************************************************
+ *              copy_with_points_per_pixel
+ *
+ * A copy of the cursor's frames, each with "pointsPerPixel", or NULL when they need none. The
+ * cache keeps the frames unscaled: the same cursor can be set for windows of different DPIs.
+ */
+static CFArrayRef copy_with_points_per_pixel(CFArrayRef frames, double points_per_pixel)
+{
+    CFMutableArrayRef scaled;
+    CFNumberRef number;
+    CFIndex i, count = CFArrayGetCount(frames);
+
+    if (points_per_pixel == 1) return NULL;
+    if (!(scaled = CFArrayCreateMutable(NULL, count, &kCFTypeArrayCallBacks))) return NULL;
+    if (!(number = CFNumberCreate(NULL, kCFNumberDoubleType, &points_per_pixel)))
+    {
+        CFRelease(scaled);
+        return NULL;
+    }
+    for (i = 0; i < count; i++)
+    {
+        CFDictionaryRef unscaled = CFArrayGetValueAtIndex(frames, i);
+        CFMutableDictionaryRef frame = CFDictionaryCreateMutableCopy(NULL, 0, unscaled);
+        if (!frame) break;
+        CFDictionarySetValue(frame, CFSTR("pointsPerPixel"), number);
+        CFArrayAppendValue(scaled, frame);
+        CFRelease(frame);
+    }
+    CFRelease(number);
+    if (i < count)
+    {
+        CFRelease(scaled);
+        return NULL;
+    }
+    /* Cocoa applies it in Retina mode only (cursorForFrame:) */
+    TRACE("cursor shown at %g points per pixel\n", retina_on ? points_per_pixel : 1);
+    return scaled;
+}
+
+
 /***********************************************************************
  *              SetCursor (MACDRV.@)
  */
@@ -866,6 +943,17 @@ void macdrv_SetCursor(HWND hwnd, HCURSOR cursor)
     }
 
 done:
+    if (cursor_frames)
+    {
+        double points_per_pixel = cursor_points_per_pixel(hwnd);
+        CFArrayRef scaled = copy_with_points_per_pixel(cursor_frames, points_per_pixel);
+
+        if (scaled)
+        {
+            CFRelease(cursor_frames);
+            cursor_frames = scaled;
+        }
+    }
     TRACE("setting cursor with cursor_name %s cursor_frames %p\n", debugstr_cf(cursor_name), cursor_frames);
     macdrv_set_cursor(cursor_name, cursor_frames);
     if (cursor_name) CFRelease(cursor_name);
-- 

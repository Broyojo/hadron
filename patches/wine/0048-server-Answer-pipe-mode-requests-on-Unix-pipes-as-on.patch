From 39d6581f0d2bae08ebeb91744f64ddc4b129af7e Mon Sep 17 00:00:00 2001
From: Broyojo <dha@xoba.com>
Date: Mon, 23 Nov 2026 11:15:49 -0500
Subject: [PATCH] server: Answer pipe mode requests on Unix pipes as on
 anonymous pipes.

A Unix pipe or socket that becomes a handle, as a process's standard
handles do when its output goes to a pipe, is a file object, and
GetFileType reports it as a pipe. But FilePipeInformation failed on it
with STATUS_NOT_IMPLEMENTED, queried and set, so SetNamedPipeHandleState
failed where it succeeds on an anonymous pipe on Windows. Node and
Electron open such a standard handle as a pipe stream with
SetNamedPipeHandleState(PIPE_READMODE_BYTE | PIPE_WAIT) and stop ("open
EBADF") when it fails.

Such a handle now answers as a pipe from CreatePipe does, in the file's
get_file_info and set_file_info: its mode is byte mode, blocking; setting
that mode succeeds, and message mode fails with STATUS_INVALID_PARAMETER.
Non-blocking mode is refused with STATUS_NOT_SUPPORTED, as its reads and
writes are made on the blocking Unix descriptor.
---
 dlls/ntdll/unix/file.c |  3 +++
 server/file.c          | 59 ++++++++++++++++++++++++++++++++++++++++--
 2 files changed, 60 insertions(+), 2 deletions(-)

diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index d99a9a1033d..9eb3e74c933 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -4718,6 +4718,9 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         return server_get_file_info( handle, io, ptr, len, class );
     if (len < info_sizes[class])
         return io->Status = STATUS_INFO_LENGTH_MISMATCH;
+    /* The server answers for named pipes, and for the Unix pipes and sockets that are anonymous pipes. */
+    if (class == FilePipeInformation)
+        return server_get_file_info( handle, io, ptr, len, class );
 
     if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, &options )))
     {
diff --git a/server/file.c b/server/file.c
index 6748ddf8940..a4dbf2022e6 100644
--- a/server/file.c
+++ b/server/file.c
@@ -84,6 +84,8 @@ static struct list *file_get_kernel_obj_list( struct object *obj );
 static void file_destroy( struct object *obj );
 
 static enum server_fd_type file_get_fd_type( struct fd *fd );
+static void file_get_file_info( struct fd *fd, obj_handle_t handle, unsigned int info_class );
+static void file_set_file_info( struct fd *fd, struct async *async, unsigned int info_class );
 
 static const struct object_ops file_ops =
 {
@@ -104,8 +106,8 @@ static const struct object_ops file_ops =
 static const struct fd_ops file_fd_ops =
 {
     .get_fd_type   = file_get_fd_type,
-    .get_file_info = default_fd_get_file_info,
-    .set_file_info = default_fd_set_file_info,
+    .get_file_info = file_get_file_info,
+    .set_file_info = file_set_file_info,
     .ioctl         = default_fd_ioctl,
     .queue_async   = default_fd_queue_async,
 };
@@ -268,6 +270,59 @@ static enum server_fd_type file_get_fd_type( struct fd *fd )
     return FD_TYPE_CHAR;
 }
 
+/* A Unix pipe or socket is an anonymous pipe to Windows programs (GetFileType says so): a byte
+ * stream whose operations block, the mode CreatePipe gives. */
+static int is_unix_pipe( struct file *file )
+{
+    return S_ISFIFO( file->mode ) || S_ISSOCK( file->mode );
+}
+
+static void file_get_file_info( struct fd *fd, obj_handle_t handle, unsigned int info_class )
+{
+    struct file *file = get_fd_user( fd );
+    FILE_PIPE_INFORMATION info;
+
+    if (info_class != FilePipeInformation || !is_unix_pipe( file ))
+    {
+        default_fd_get_file_info( fd, handle, info_class );
+        return;
+    }
+    if (!(get_handle_access( current->process, handle ) & FILE_READ_ATTRIBUTES))
+    {
+        set_error( STATUS_ACCESS_DENIED );
+        return;
+    }
+    if (get_reply_max_size() < sizeof(info))
+    {
+        set_error( STATUS_INFO_LENGTH_MISMATCH );
+        return;
+    }
+    info.ReadMode       = FILE_PIPE_BYTE_STREAM_MODE;
+    info.CompletionMode = FILE_PIPE_QUEUE_OPERATION;
+    set_reply_data( &info, sizeof(info) );
+}
+
+/* A Unix pipe or socket takes the mode it has, byte mode and blocking; set_file_info has checked
+ * the access FilePipeInformation needs. */
+static void file_set_file_info( struct fd *fd, struct async *async, unsigned int info_class )
+{
+    struct file *file = get_fd_user( fd );
+    const FILE_PIPE_INFORMATION *info = get_req_data();
+
+    if (info_class != FilePipeInformation || !is_unix_pipe( file ))
+    {
+        default_fd_set_file_info( fd, async, info_class );
+        return;
+    }
+    if (get_req_data_size() < sizeof(*info)) set_error( STATUS_INFO_LENGTH_MISMATCH );
+    /* a byte stream has no messages to read */
+    else if (((info->CompletionMode | info->ReadMode) & ~1) || info->ReadMode)
+        set_error( STATUS_INVALID_PARAMETER );
+    /* Its reads and writes are made on the Unix descriptor, which blocks; they cannot be made to
+     * return at once yet. */
+    else if (info->CompletionMode) set_error( STATUS_NOT_SUPPORTED );
+}
+
 static struct fd *file_get_fd( struct object *obj )
 {
     struct file *file = (struct file *)obj;
-- 

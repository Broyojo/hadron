From 269d3ce00a0a44ab8dabd6edc7346e96935d7daf Mon Sep 17 00:00:00 2001
From: Broyojo <dha@xoba.com>
Date: Thu, 26 Nov 2026 20:58:22 -0500
Subject: [PATCH] ntdll: Keep signaling until the full-context return has been
 done on arm64.

When a syscall returns to a context whose x16 and x17 aren't its pc and
sp, as NtContinue does, the dispatcher calls
syscall_dispatcher_return_slowpath(), which raises SIGUSR2; the handler
switches to the frame's context, so the call isn't expected to return.
If it does, the dispatcher's fast return runs instead and leaves x16 =
pc and x17 = sp. Code that keeps a live value in x16 or x17 across an
exception then resumes with the wrong one; FEX's ARM64EC JIT keeps its
call-ret stack pointer in x17, and Geometry Dash with Geode crashed.

On macOS it returned. There sigprocmask() sets the mask of every thread
in the process, and steamclient.dylib's OpenSSL calls it when it is
loaded, to block signals while it probes the CPU. A thread that saved
its own mask meanwhile, as server_select() does, sets the probe's back
afterwards and keeps SIGUSR2 blocked, so raise() leaves the signal
pending; one signaled during the probe gets the signal only when it is
signaled again. With a debugger attached the kernel also lets two
threads stop for a signal at once and gives both the one the debugger
answered first, and lldb drops a thread's signal when it steps another
thread over a breakpoint.

Mark the thread as waiting for the handler, and call pthread_kill() and
sched_yield() until the handler has run, unblocking SIGUSR2 before each
try, since another sigprocmask() can block it again meanwhile. The
handler only acts on a thread that is waiting, so a SIGUSR2 that
arrives late or at another thread no longer applies the frame of
whatever syscall that thread is in. Use pthread_kill() instead of
raise(), which falls back to signaling the whole process.
---
 dlls/ntdll/unix/signal_arm64.c | 28 +++++++++++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/dlls/ntdll/unix/signal_arm64.c b/dlls/ntdll/unix/signal_arm64.c
index 2ebba14110..28c37dac68 100644
--- a/dlls/ntdll/unix/signal_arm64.c
+++ b/dlls/ntdll/unix/signal_arm64.c
@@ -72,6 +72,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(seh);
 struct arm64_thread_data
 {
     BOOL suspend_pending;
+    volatile BOOL set_context_pending;  /* syscall_dispatcher_return_slowpath() waits for usr2_handler */
 };
 
 C_ASSERT( sizeof(struct arm64_thread_data) <= sizeof(((struct teb_data *)0)->cpu_data) );
@@ -1514,8 +1515,11 @@ static void usr2_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
     struct syscall_frame *frame = get_syscall_frame( data );
     DWORD i;
 
+    /* only the thread's own syscall_dispatcher_return_slowpath() asks for this, ignore one meant for another thread */
+    if (!arm64_thread_data( data )->set_context_pending) return;
     if (!is_inside_syscall( data, SP_sig(sigcontext) )) return;
     if (!frame) return;
+    arm64_thread_data( data )->set_context_pending = FALSE;
 
     if (is_emulated_code( frame->pc ))
     {
@@ -1626,7 +1630,29 @@ void signal_init_process( TEB *teb )
  */
 void syscall_dispatcher_return_slowpath(void)
 {
-    raise( SIGUSR2 );
+    struct arm64_thread_data *thread_data = arm64_thread_data( get_thread_data() );
+    sigset_t mask;
+    unsigned int i;
+
+    /* usr2_handler() switches to the frame's context, so this doesn't return. Returning would make the
+     * dispatcher restore the frame without x16 and x17, which would then hold the pc and the sp.
+     * On macOS the signal can be held back: another library's sigprocmask() sets the mask of every
+     * thread, and with a debugger attached the kernel can give this thread another thread's signal.
+     * So enter the kernel again until the handler has run, unblocking SIGUSR2 each time, since
+     * another sigprocmask() can block it again in between; a return to user code doesn't keep it
+     * blocked. pthread_kill(), not raise(): raise() falls back to a signal for the process. */
+    thread_data->set_context_pending = TRUE;
+    sigemptyset( &mask );
+    sigaddset( &mask, SIGUSR2 );
+    for (i = 0;; i++)
+    {
+        int ret;
+
+        pthread_sigmask( SIG_UNBLOCK, &mask, NULL );
+        ret = pthread_kill( pthread_self(), SIGUSR2 );
+        if (i == 1000) ERR( "SIGUSR2 not delivered after %u tries, pthread_kill returned %d\n", i, ret );
+        sched_yield();
+    }
 }
 
 /***********************************************************************

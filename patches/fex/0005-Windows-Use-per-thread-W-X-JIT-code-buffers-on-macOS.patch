+  };
+
+  Call(FEXUnixLibFunctions::JITWriteProtect, &Args);
+}
+
 void VirtualTHPControl(const void* Ptr, size_t Size, FEXCore::Allocator::THPControl Control) {
   if (!Available()) {
     return;

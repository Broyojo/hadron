 #include "Interface/Core/CPUBackend.h"
 #include "Interface/Context/Context.h"
+#include <FEXCore/Utils/AllocatorHooks.h>
 #include <FEXCore/Utils/SpinWaitLock.h>
 
 #include <FEXCore/Debug/InternalThreadState.h>
@@ -2103,6 +2104,8 @@ std::optional<int32_t> HandleUnalignedAccess(FEXCore::Core::InternalThreadState*
   // Lock code mutex during any SIGBUS handling that potentially changes code.
   // Due to code buffer sharing between threads, code must be carefully backpatched from last to first.
   // Multiple threads can be attempting to handle the SIGBUS or even be executing the code being backpatched.
+  // The spin lock lives in the block tail, in the CodeBuffer with the code; declared first so it's released last.
+  FEXCore::Allocator::ScopedJITWrite JITWrite;
   FEXCore::Utils::SpinWaitLock::UniqueSpinMutex lk(&InlineTail->SpinLockFutex);
 
   if ((Instr & LDAXR_MASK) == LDAR_INST ||  // LDAR*
diff --git a/FEXCore/include/FEXCore/Utils/AllocatorHooks.h b/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
index c4cadf40a..7bb11bca2 100644
--- a/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
+++ b/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
@@ -46,6 +46,15 @@ FEX_DEFAULT_VISIBILITY void SetupHooks(size_t PageSize, HookPtrs Ptrs);
 FEX_DEFAULT_VISIBILITY void ClearHooks();
 
 #ifdef _WIN32
+// Set when the host backs JIT code buffers with per-thread W^X memory (MAP_JIT on macOS):
+// JITAlloc allocates such memory, JITWriteProtect switches the calling thread's access to it
+// between writable (false) and executable (true).
+using JITWriteProtectPtr = void (*)(bool Protect);
+using JITAllocPtr = void* (*)(size_t Size);
+FEX_DEFAULT_VISIBILITY extern JITWriteProtectPtr JITWriteProtect;
+FEX_DEFAULT_VISIBILITY extern JITAllocPtr JITAlloc;
+FEX_DEFAULT_VISIBILITY void SetJITHooks(JITWriteProtectPtr WriteProtect, JITAllocPtr Alloc);
+
 inline void* VirtualAlloc(void* Base, size_t Size, bool Execute = false, bool Commit = true) {
   // Allocate top-down to avoid polluting the lower VA space, as even on 64-bit some programs (i.e. LuaJIT) require allocations below 4GB.
   DWORD Flags = (Commit ? MEM_COMMIT : 0) | MEM_RESERVE | MEM_TOP_DOWN;
@@ -66,6 +75,37 @@ inline void* VirtualAlloc(size_t Size, bool Execute = false, bool Commit = true)
   return VirtualAlloc(nullptr, Size, Execute, Commit);
 }
 
+// Allocates committed RWX memory for JIT code. When JITWriteProtect is set, the host maps it with
+// per-thread write/execute access: every write to it must happen inside a ScopedJITWrite.
+inline void* VirtualAllocJIT(size_t Size) {
+  if (JITAlloc) {
+    if (auto Ptr = JITAlloc(Size)) {
+      return Ptr;
+    }
+    LogMan::Msg::EFmt("Failed to allocate per-thread W^X JIT memory, falling back to RWX");
+  }
+  return VirtualAlloc(nullptr, Size, true, true);
+}
+
+// Makes JIT code memory writable for the calling thread while in scope. The thread can't execute
+// JIT code meanwhile. Scopes must not nest: the inner one would make the memory executable again
+// on exit (there's no per-thread nesting count as TLS isn't usable in FEX's Windows modules).
+class ScopedJITWrite final {
+public:
+  ScopedJITWrite() {
+    if (JITWriteProtect) {
+      JITWriteProtect(false);
+    }
+  }
+  ~ScopedJITWrite() {
+    if (JITWriteProtect) {
+      JITWriteProtect(true);
+    }
+  }
+  ScopedJITWrite(const ScopedJITWrite&) = delete;
+  ScopedJITWrite& operator=(const ScopedJITWrite&) = delete;
+};
+
 inline void VirtualFree(void* Ptr, size_t Size) {
   ::VirtualFree(Ptr, 0, MEM_RELEASE);
 }
@@ -121,6 +161,18 @@ inline void* VirtualAlloc(void* Base, size_t Size, bool Execute = false, bool Co
   return FEXCore::Allocator::mmap(Base, Size, PROT_READ | PROT_WRITE | (Execute ? PROT_EXEC : 0), MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
 }
 
+inline void* VirtualAllocJIT(size_t Size) {
+  return VirtualAlloc(Size, true);
+}
+
+// JIT code memory is always writable on Linux.
+class ScopedJITWrite final {
+public:
+  ScopedJITWrite() = default;
+  ScopedJITWrite(const ScopedJITWrite&) = delete;
+  ScopedJITWrite& operator=(const ScopedJITWrite&) = delete;
+};
+
 inline void VirtualFree(void* Ptr, size_t Size) {
   FEXCore::Allocator::munmap(Ptr, Size);
 }
diff --git a/Source/Windows/Common/Allocator.cpp b/Source/Windows/Common/Allocator.cpp
index d535bdef7..391a0de77 100644
--- a/Source/Windows/Common/Allocator.cpp
+++ b/Source/Windows/Common/Allocator.cpp
@@ -26,4 +26,23 @@ void SetupHooks(HMODULE ntdll) {
   GetSystemInfo(&system_info);
   FEXCore::Allocator::SetupHooks(system_info.dwPageSize, Ptrs);
 }
+
+// Wine extension to MemExtendedParameterAttributeFlags (see Wine's winternl.h): on hosts that refuse
+// RWX mappings, back the allocation with per-thread W^X JIT memory (MAP_JIT on macOS) instead of
+// flipping page protections on faults. Every write must be inside a FEXCore::Allocator::ScopedJITWrite.
+constexpr ULONG MEM_EXTENDED_PARAMETER_WINE_UNIX_JIT = 0x80000000;
+
+static void* AllocateJIT(size_t Size) {
+  MEM_EXTENDED_PARAMETER Parameter {};
+  Parameter.Type = MemExtendedParameterAttributeFlags;
+  Parameter.ULong64 = MEM_EXTENDED_PARAMETER_WINE_UNIX_JIT;
+#ifdef ARCHITECTURE_arm64ec
+  Parameter.ULong64 |= MEM_EXTENDED_PARAMETER_EC_CODE;
+#endif
+  return ::VirtualAlloc2(nullptr, nullptr, Size, MEM_COMMIT | MEM_RESERVE | MEM_TOP_DOWN, PAGE_EXECUTE_READWRITE, &Parameter, 1);
+}
+
+void EnableJITWriteProtect() {
+  FEXCore::Allocator::SetJITHooks(UnixLib::JITWriteProtect, AllocateJIT);
+}
 } // namespace FEX::Windows::Allocator
